<Application x:Class="AssetsManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AssetsManager">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- App Themes & Control Styles -->
                <ResourceDictionary Source="/Themes/Font.xaml"/>
                <ResourceDictionary Source="/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/Themes/Animations.xaml"/>
                <ResourceDictionary Source="/Themes/Converters.xaml"/>
                <ResourceDictionary Source="/Themes/TextStyles.xaml"/>
                <ResourceDictionary Source="/Themes/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Themes/BorderStyles.xaml"/>
                <ResourceDictionary Source="/Themes/TextBoxStyles.xaml"/>
                <ResourceDictionary Source="/Themes/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Themes/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Themes/SliderStyles.xaml"/>
                <ResourceDictionary Source="/Themes/ProgressBarStyles.xaml"/>
                <ResourceDictionary Source="/Themes/MenuStyles.xaml"/>
                <ResourceDictionary Source="/Themes/RichTextBoxStyles.xaml"/>
                <ResourceDictionary Source="/Themes/ScrollbarStyles.xaml"/>
                <ResourceDictionary Source="/Themes/TreeViewStyles.xaml"/>
                <ResourceDictionary Source="/Themes/ListBoxStyles.xaml"/>
                <ResourceDictionary Source="/Themes/ListViewStyles.xaml"/>
                <ResourceDictionary Source="/Themes/FileGridStyles.xaml"/>
                <ResourceDictionary Source="/Themes/AvalonEditStyles.xaml"/>
                <ResourceDictionary Source="/Themes/HudWindowStyles.xaml"/>

                <!-- Component & Feature DataTemplates -->
                <ResourceDictionary Source="/Themes/Templates/FileGridTemplate.xaml"/>
                <ResourceDictionary Source="/Themes/Templates/ChromaFamilyTemplate.xaml"/>
                <ResourceDictionary Source="/Themes/Templates/ChromaCardTemplate.xaml"/>
                <ResourceDictionary Source="/Themes/Templates/ApiTemplate.xaml"/>
                <ResourceDictionary Source="/Themes/Templates/HashGuessingTemplate.xaml"/>
                <ResourceDictionary Source="/Themes/Templates/ResultCardTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
