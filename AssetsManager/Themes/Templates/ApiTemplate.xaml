<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <!-- 1. PREMIUM STORE ITEM TEMPLATE (SALES) -->
    <DataTemplate x:Key="StoreItemTemplate">
        <Border Background="{StaticResource CardBackground}" 
                CornerRadius="12" 
                Margin="8" 
                Padding="0" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Grid>
                <StackPanel>
                    <!-- Image Viewport (Framed with Rounded HUD Corners) -->
                    <Border Margin="12,12,12,0" 
                            Height="120" 
                            CornerRadius="10" 
                            Background="{StaticResource SidebarBackground}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1">
                        <Grid>
                            <!-- Watermark / Placeholder -->
                            <materialIcons:MaterialIcon Kind="TagOutline" Width="36" Height="36" Foreground="{StaticResource AccentGreen}" Opacity="0.08" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <!-- Hero Artwork / Skin / Chroma Image with Rounded Corners -->
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ImagePath}" 
                                                Stretch="{Binding ImagePath, Converter={StaticResource AdaptiveImageStretchConverter}}"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content Area -->
                    <Border Padding="12,10,12,12">
                        <StackPanel>
                            <!-- Item Title -->
                            <TextBlock Text="{Binding Name}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       TextAlignment="Center" 
                                       MaxHeight="36" 
                                       TextWrapping="Wrap" 
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>
                            
                            <!-- Price Container (Aligned with App Palette) -->
                            <StackPanel Margin="0,8,0,0">
                                <!-- Original Strikethrough Price -->
                                <TextBlock Text="{Binding FormattedOriginalPrice}" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextMuted}" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,0,0,3" 
                                           TextDecorations="Strikethrough"/>
                                
                                <!-- Sale Details (Uniform Font Size, Non-repeating) -->
                                <TextBlock Text="{Binding Sale.FormattedSaleDetails, Mode=OneWay}" 
                                           Foreground="{StaticResource AccentGreen}" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Expiration Date (Footer) -->
                            <TextBlock Text="{Binding Sale.FormattedEndDate, Mode=OneWay}" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextMuted}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,6,0,0" 
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 2. MYTHIC ITEM TEMPLATE (MYTHIC SHOP) -->
    <DataTemplate x:Key="MythicItemTemplate">
        <Border Background="{StaticResource CardBackground}" 
                CornerRadius="12" 
                Margin="8" 
                Padding="0" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Grid>
                <StackPanel>
                    <!-- Image Viewport (Framed with Rounded HUD Corners) -->
                    <Border Margin="12,12,12,0" 
                            Height="120" 
                            CornerRadius="10" 
                            Background="{StaticResource SidebarBackground}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1">
                        <Grid>
                            <!-- Watermark / Placeholder -->
                            <materialIcons:MaterialIcon Kind="DiamondStone" Width="36" Height="36" Foreground="{StaticResource AccentPurple}" Opacity="0.1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                            <!-- Hero Artwork / Chroma Image with Rounded Corners -->
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ImagePath}" 
                                                Stretch="{Binding ImagePath, Converter={StaticResource AdaptiveImageStretchConverter}}"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content Area -->
                    <Border Padding="12,10,12,12">
                        <StackPanel>
                            <!-- Item Title -->
                            <TextBlock Text="{Binding Name}" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       TextAlignment="Center" 
                                       MaxHeight="36" 
                                       TextWrapping="Wrap" 
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>
                            
                            <!-- Mythic Essence Price -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <materialIcons:MaterialIcon Kind="DiamondStone" Width="15" Height="15" Foreground="{StaticResource AccentPurple}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Price}" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text=" ME" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                            </StackPanel>

                            <!-- Expiration Date (Footer) -->
                            <TextBlock Text="{Binding EndTime}" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextMuted}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,6,0,0" 
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 3. PASS REWARD ITEM TEMPLATE -->
    <DataTemplate x:Key="PassRewardTemplate">
        <Border Background="{StaticResource CardBackground}" 
                CornerRadius="12" 
                Margin="8" 
                Padding="0" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Grid>
                <StackPanel>
                    <!-- Header with Level - Centered -->
                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="11,11,0,0" Padding="8,4" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Image Viewport (Framed with Rounded HUD Corners) -->
                    <Border Margin="12,12,12,0" 
                            Height="100" 
                            CornerRadius="10" 
                            Background="{StaticResource SidebarBackground}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" 
                            ClipToBounds="True">
                        <Grid>
                            <!-- Watermark Placeholder Icon -->
                            <materialIcons:MaterialIcon Kind="TicketPercentOutline" Width="32" Height="32" Foreground="{StaticResource AccentTeal}" Opacity="0.1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding IconUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                            
                            <!-- Actual Reward Icon -->
                            <Image Source="{Binding IconUrl}" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Tier Badge INSIDE Image Area (Top-Right) -->
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4" IsHitTestVisible="False">
                                <!-- FREE Badge -->
                                <Border Background="{StaticResource AccentGreen}" CornerRadius="6" Padding="5,2" Visibility="{Binding IsFree, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="FREE" FontSize="9" FontWeight="Black" Foreground="White"/>
                                </Border>
                                <!-- PREMIUM Badge -->
                                <Border Background="{StaticResource AccentBlue}" CornerRadius="6" Padding="5,2" Visibility="{Binding IsFree, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="PASS" FontSize="9" FontWeight="Black" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Change / Revert Overlay (Hover Only) -->
                            <Border x:Name="HoverOverlay"
                                    Background="#B80E1117"
                                    CornerRadius="9">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Change Button (Left) -->
                                    <Button Tag="ChangeImage"
                                            ToolTip="Change image (.png, .jpg)"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,6" MinWidth="48">
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="CameraPlusOutline" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                                    <TextBlock Text="Change" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Revert Button (Right) -->
                                    <Button Tag="RevertImage"
                                            ToolTip="Revert to original image and title"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,6" MinWidth="48">
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="Restore" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                                    <TextBlock Text="Revert" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content Area -->
                    <Border Padding="12,8,12,10">
                        <StackPanel>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="Bold" FontSize="12"
                                     Foreground="{StaticResource TextPrimary}"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"
                                     MaxHeight="48"
                                     AcceptsReturn="False"
                                     Style="{StaticResource InlineEditableTitleTextBox}"/>

                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="Qty: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
