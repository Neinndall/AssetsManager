<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="HashGuessingTemplate">
        <Grid ToolTip="{Binding Description}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource SidebarBackground}" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="22" Height="22" Foreground="{Binding BadgeBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <Style x:Key="HashGuessingItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="BackgroundLayer" Background="{StaticResource CardBackground}" CornerRadius="10"/>
                        <ContentPresenter Margin="12,10" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Outline" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource HoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource HoverColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HashGuessingStrategyCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="CheckBackground" Background="{StaticResource DarkBackground}" CornerRadius="4"/>
                            <Path x:Name="CheckMark" Data="M3.5,8 L6.5,11 L12.5,4.5" Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="3" Visibility="Collapsed"/>
                            <Border x:Name="CheckOutline" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"/>
                        </Grid>
                        <ContentPresenter Grid.Column="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBackground" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckOutline" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckOutline" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="HashGuessingSubItemTemplate">
        <Grid Margin="0,0,0,6">
            <Border x:Name="StrategyBackground" Background="{StaticResource SidebarBackground}" CornerRadius="8"/>
            <CheckBox x:Name="StrategyCheckBox" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Style="{StaticResource HashGuessingStrategyCheckBox}" Margin="12,10" HorizontalContentAlignment="Stretch"
                      ToolTip="{Binding Description}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>
            <Border x:Name="StrategyOutline" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="StrategyCheckBox" Property="IsMouseOver" Value="True">
                <Setter TargetName="StrategyBackground" Property="Background" Value="{StaticResource HoverColor}"/>
                <Setter TargetName="StrategyOutline" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger SourceName="StrategyCheckBox" Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="StrategyOutline" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
