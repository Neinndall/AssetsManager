<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <!-- ================================================================= -->
    <!-- FILE EXPLORER GRID ITEM TEMPLATE (CLEAN MODERN GALLERY)           -->
    <!-- ================================================================= -->
    <DataTemplate x:Key="FileGridItemTemplate">
        <Border x:Name="CardBorder" 
                Margin="4" 
                Width="116" 
                Height="128" 
                CornerRadius="8"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Padding="4">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>   <!-- Fixed Icon / Thumbnail Viewport -->
                    <RowDefinition Height="32"/>   <!-- Fixed Title Area (1 or 2 lines) -->
                    <RowDefinition Height="16"/>   <!-- Fixed Metadata / Counts Area -->
                </Grid.RowDefinitions>

                <!-- 1. Thumbnail / Icon Presentation (Fixed height ensures 100% horizontal alignment across rows) -->
                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- A. Placeholder / File / Folder Icon -->
                    <materialIcons:MaterialIcon Kind="{Binding Node, Converter={StaticResource PathToIconConverter}}" 
                                                Width="52" Height="52" 
                                                Foreground="{StaticResource TextSecondary}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5"
                                                Visibility="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <materialIcons:MaterialIcon.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </materialIcons:MaterialIcon.RenderTransform>
                        <materialIcons:MaterialIcon.Style>
                            <Style TargetType="materialIcons:MaterialIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Node.Name}" Value="Loading...">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource SpinningIconAnimation}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialIcons:MaterialIcon.Style>
                    </materialIcons:MaterialIcon>
                    
                    <!-- B. Real Image Preview -->
                    <Border CornerRadius="8" 
                            ClipToBounds="True" 
                            Width="72" Height="72"
                            Background="#080C14"
                            Visibility="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}}">
                        <Image Source="{Binding ImagePreview}" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 2. File / Folder Name (Fixed height & Top-aligned: sits directly below the icon, no sagging) -->
                <TextBlock Grid.Row="1" 
                           Text="{Binding DisplayNameShort}" 
                           ToolTip="{Binding Node.DisplayName}"
                           FontSize="10.5" 
                           FontWeight="Medium" 
                           Foreground="{StaticResource TextPrimary}" 
                           TextTrimming="CharacterEllipsis" 
                           TextWrapping="Wrap" 
                           MaxHeight="28" 
                           LineHeight="14"
                           Margin="0,2,0,0"
                           TextAlignment="Center" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"/>

                <!-- 3. Folder Sub-item Indicator -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding FolderCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,6,0">
                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="10" Height="10" Foreground="{StaticResource AccentOrange}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FolderCount}" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding AssetCount, Converter={StaticResource CountToVisibilityConverter}}">
                        <materialIcons:MaterialIcon Kind="CubeOutline" Width="10" Height="10" Foreground="{StaticResource AccentGreen}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AssetCount}" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 4. Selection Check Badge (Top-Right) -->
                <materialIcons:MaterialIcon Grid.RowSpan="3" 
                                            Kind="CheckCircle" 
                                            Foreground="{StaticResource AccentBrush}" 
                                            Width="16" Height="16" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top" 
                                            Margin="0,2,2,0" 
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsMultiSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
        
        <DataTemplate.Triggers>
            <!-- Hover Effect: Smooth HoverColor highlight -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource HoverColor}"/>
            </DataTrigger>
            
            <!-- Selection Effect: Identical HoverColor without border -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource HoverColor}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
