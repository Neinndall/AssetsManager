<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Animations.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Modern Rounded ProgressBar Style (Adaptive & Solid) -->
    <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource DarkBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                        <!-- 1. El carril de fondo (Track) -->
                        <Border x:Name="Track"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"/>

                        <!-- 2. Contenedor del indicador -->
                        <Border CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track" Background="Transparent">
                                <!-- El indicador determinado -->
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"/>

                                <!-- El indicador indeterminado animado -->
                                <Border x:Name="IndeterminateIndicator"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform X="-1.0"/>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="#0000C8FF" Offset="0.0"/>
                                            <GradientStop Color="#6000C8FF" Offset="0.25"/>
                                            <GradientStop Color="#FF00C8FF" Offset="0.5"/>
                                            <GradientStop Color="#6000C8FF" Offset="0.75"/>
                                            <GradientStop Color="#0000C8FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="true">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="StartIndeterminateAnim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-1.0" To="1.0" Duration="0:0:1.4">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="StartIndeterminateAnim"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>