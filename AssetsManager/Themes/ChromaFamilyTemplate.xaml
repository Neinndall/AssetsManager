<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="ChromaFamilyTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="44"
                    Height="44"
                    CornerRadius="9"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1">
                <Grid>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding PreviewImage}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Width="12"
                            Height="12"
                            Margin="0,0,-3,-3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            CornerRadius="6"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1.5">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding SwatchColor}"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding ModelName}"
                           Margin="0,2,0,0"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ModelName}"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="7,4"
                    VerticalAlignment="Center"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBlock Text="{Binding ChromaCount}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}"/>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
