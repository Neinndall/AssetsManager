<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
    <DataTemplate x:Key="ChromaCardTemplate">
        <ToggleButton x:Name="CardRoot"
                      Width="148"
                      Height="180"
                      Margin="7"
                      Cursor="Hand"
                      Style="{StaticResource ChromaCardToggleButtonStyle}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="CardBackground"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12"/>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="9"
                            Background="{StaticResource SidebarBackground}">
                        <Grid>
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding PreviewImage}"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border Width="24"
                                    Height="24"
                                    Margin="0,0,-4,-4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding SwatchColor}"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Opacity="0.45"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1"
                                Margin="0,9,0,1"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding PreviewTextureName}"
                                   MaxWidth="120"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PreviewTextureName}"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="CardBorder"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        IsHitTestVisible="False"/>

                <Border x:Name="SelectedBadge"
                        Width="24"
                        Height="24"
                        Margin="0,7,7,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <materialIcons:MaterialIcon Kind="CheckCircle"
                                                Width="19"
                                                Height="19"
                                                Foreground="{StaticResource AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ToggleButton>
        <DataTemplate.Triggers>
            <Trigger SourceName="CardRoot"
                     Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="CardBackground"
                        Property="Background"
                        Value="{StaticResource HoverColor}"/>
                <Setter TargetName="CardBorder"
                        Property="BorderBrush"
                        Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}"
                         Value="True">
                <Setter TargetName="CardBackground"
                        Property="Background"
                        Value="{StaticResource HoverColor}"/>
                <Setter TargetName="CardBorder"
                        Property="BorderBrush"
                        Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="CardBorder"
                        Property="BorderThickness"
                        Value="1.5"/>
                <Setter TargetName="SelectedBadge"
                        Property="Visibility"
                        Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
