<UserControl x:Class="AssetsManager.Views.NewsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:newsModels="clr-namespace:AssetsManager.Views.Models.News"
             xmlns:shared="clr-namespace:AssetsManager.Views.Controls.Shared"
             xmlns:newsControls="clr-namespace:AssetsManager.Views.Controls.News"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFontFamily}"
             d:DesignHeight="820" d:DesignWidth="1060">

    <UserControl.Resources>
        <!-- ================================================================ -->
        <!-- NEWS CARD TEMPLATE (List Items)                                  -->
        <!-- ================================================================ -->
        <DataTemplate x:Key="NewsCardTemplate" DataType="{x:Type newsModels:NewsItemModel}">
            <Grid Margin="14" Tag="{Binding}" MouseLeftButtonUp="Card_MouseLeftButtonUp" Cursor="Hand">
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 0. THUMBNAIL -->
                    <Border Grid.Column="0" Height="99" CornerRadius="10" Background="{StaticResource SidebarBackground}" VerticalAlignment="Top">
                        <Grid>
                            <materialIcons:MaterialIcon Kind="ImageOutline" Width="40" Height="40" Foreground="{StaticResource TextMuted}" Opacity="0.12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- Video Overlay Badge -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6" Padding="6,3" CornerRadius="6" Background="#CC0F111A" Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="Play" Width="10" Height="10" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="VIDEO" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 1. CONTENT -->
                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0: Meta Badges -->
                            <RowDefinition Height="Auto"/> <!-- 1: Title -->
                            <RowDefinition Height="Auto"/> <!-- 2: Description -->
                            <RowDefinition Height="Auto"/> <!-- 3: Footer -->
                        </Grid.RowDefinitions>

                        <!-- 0. META BADGES -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Category Chip -->
                            <Border Padding="8,3" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding CategoryBrush.Color, FallbackValue=#335C85FF}" Opacity="0.15"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding CategoryBrush.Color, FallbackValue=#335C85FF}"/>
                                </Border.BorderBrush>
                                <TextBlock Text="{Binding CategoryTitle}" FontSize="9" FontWeight="Bold" Foreground="{Binding CategoryBrush}"/>
                            </Border>
                            <!-- Published Date -->
                            <TextBlock Text="{Binding PublishedAt, Converter={StaticResource TimeAgoConverter}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- 1. TITLE -->
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="Wrap" MaxHeight="34" ClipToBounds="True" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>

                        <!-- 2. DESCRIPTION -->
                        <TextBlock Grid.Row="2" Text="{Binding DescriptionDisplay}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" MaxHeight="30" ClipToBounds="True" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,4,0,0" Opacity="0.85"/>

                        <!-- 3. FOOTER -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tags -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxHeight="18"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource HoverColor}" CornerRadius="5" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallTextButtonStyle}" Tag="{Binding}" Click="ReadMore_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="READ MORE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================================ -->
        <!-- MASTER FEED VIEW                                                 -->
        <!-- ================================================================ -->
        <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Identity Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Toolbar -->
                <RowDefinition Height="*"/>    <!-- 2: Content Area -->
            </Grid.RowDefinitions>

            <!-- 0. DYNAMIC IDENTITY HEADER -->
            <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="32,24,32,0" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Hero Icon -->
                        <ColumnDefinition Width="Auto"/> <!-- Technical Separator -->
                        <ColumnDefinition Width="*"/>    <!-- Dynamic Titles -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource HoverColor}" CornerRadius="10" Width="48" Height="48">
                        <materialIcons:MaterialIcon Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon.Effect>
                                <DropShadowEffect Color="#FF5C85FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </materialIcons:MaterialIcon.Effect>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Kind" Value="NewspaperVariantOutline"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Dev">
                                            <Setter Property="Kind" Value="CodeBraces"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Esports">
                                            <Setter Property="Kind" Value="TrophyOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="GameUpdates">
                                            <Setter Property="Kind" Value="Update"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Lore">
                                            <Setter Property="Kind" Value="BookOpenOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPurple}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Media">
                                            <Setter Property="Kind" Value="MovieOpenOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="PatchNotes">
                                            <Setter Property="Kind" Value="FileDocumentOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentYellow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </Border>

                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderColor}" Margin="20,8" VerticalAlignment="Stretch" Opacity="0.5"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="NEWS CENTER"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Dev"><Setter Property="Text" Value="DEV NEWS"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Esports"><Setter Property="Text" Value="ESPORTS NEWS"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="GameUpdates"><Setter Property="Text" Value="GAME UPDATES"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Lore"><Setter Property="Text" Value="LORE ARCHIVE"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Media"><Setter Property="Text" Value="MEDIA GALLERY"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="PatchNotes"><Setter Property="Text" Value="PATCH NOTES"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Opacity="0.8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Official Riot Games news feed for League of Legends."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Dev"><Setter Property="Text" Value="Developer insights and behind-the-scenes updates from the LoL team."/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Esports"><Setter Property="Text" Value="The world stage for professional League of Legends."/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="GameUpdates"><Setter Property="Text" Value="The definitive source on all updates coming to the game."/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Lore"><Setter Property="Text" Value="Stories, champions and the world of Runeterra."/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="Media"><Setter Property="Text" Value="Cinematics, music and creative content from the Rift."/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedItem.Category, ElementName=CategoryComboBox}" Value="PatchNotes"><Setter Property="Text" Value="Official patch notes and balance changes for League of Legends."/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. TOOLBAR -->
            <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Margin="32,16,32,16" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Category Label -->
                        <ColumnDefinition Width="Auto"/> <!-- ComboBox -->
                        <ColumnDefinition Width="Auto"/> <!-- Refresh -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Search -->
                        <ColumnDefinition Width="Auto"/> <!-- Count Badge -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="CATEGORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1" x:Name="CategoryComboBox"
                              Width="220" Height="36"
                              Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="CategoryComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="36" Height="36" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Refresh feed">
                        <materialIcons:MaterialIcon x:Name="RefreshIcon" Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource TextSecondary}"/>
                    </Button>

                    <shared:SearchBoxControl Grid.Column="4" x:Name="SearchBox" Width="250" Margin="0,0,14,0" VerticalAlignment="Center" SearchTextChanged="SearchBox_SearchTextChanged" Tag="Search news..."/>

                    <Border Grid.Column="5" Background="{StaticResource HoverColor}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="NewspaperVariantOutline" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalCount, StringFormat={}{0} RESULTS}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. CONTENT AREA -->
            <Grid Grid.Row="2" Margin="32,4,32,32">
                <!-- News List (Virtualized) -->
                <ListBox x:Name="NewsListBox"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource NewsCardTemplate}"
                         ItemContainerStyle="{StaticResource NewsCardItemStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"/>

                <!-- LOADING OVERLAY -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialIcons:MaterialIcon Kind="Loading" Width="44" Height="44" Foreground="{StaticResource AccentBrush}" Style="{StaticResource SpinningIconStyle}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="FETCHING NEWS FEED..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ERROR STATE -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="32,28"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="40" Height="40" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="UNABLE TO LOAD NEWS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Opacity="0.85" Margin="0,0,0,16"/>
                        <Button Content="RETRY" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="Retry_Click"/>
                    </StackPanel>
                </Border>

                <!-- EMPTY STATE -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Items.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        <Condition Binding="{Binding HasError}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialIcons:MaterialIcon Kind="NewspaperVariantOutline" Width="48" Height="48" Foreground="{StaticResource TextMuted}" Opacity="0.25" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="NO NEWS AVAILABLE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Select a category or press refresh to load the latest articles." FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- DETAIL READER VIEW (INLINE ARTICLE VIEW)                        -->
        <!-- ================================================================ -->
        <newsControls:NewsArticleReaderControl x:Name="NewsArticleReader"
                                               Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               BackRequested="NewsArticleReader_BackRequested"
                                               Margin="32,24,32,32"/>
    </Grid>
</UserControl>
