<UserControl x:Class="AssetsManager.Views.HashGuessingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Clean Dynamic Identity Header -->
            <RowDefinition Height="*"/>    <!-- Master-Detail Workspace (Full Height!) -->
        </Grid.RowDefinitions>

        <!-- DYNAMIC IDENTITY HEADER (SettingsCard Style) -->
        <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="32,24,32,0" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Hero Icon -->
                    <ColumnDefinition Width="Auto"/> <!-- Technical Separator -->
                    <ColumnDefinition Width="*"/>    <!-- Dynamic Titles -->
                </Grid.ColumnDefinitions>

                <!-- Hero Icon (Standardized 48x48 / 26x26) -->
                <Border Grid.Column="0" Background="{StaticResource HoverColor}" CornerRadius="10" Width="48" Height="48">
                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="26" Height="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon.Effect>
                            <DropShadowEffect Color="#FF5C85FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </materialIcons:MaterialIcon.Effect>
                    </materialIcons:MaterialIcon>
                </Border>

                <!-- Technical Vertical Separator (1px) -->
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderColor}" Margin="20,8" VerticalAlignment="Stretch" Opacity="0.5"/>

                <!-- Dynamic Titles Area -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="HASH GUESSING LAB" FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <TextBlock Text="Resolve unknown WAD, BIN &amp; RST hashes using specialized guessing algorithms and merge verified matches." FontSize="12" Foreground="{StaticResource TextSecondary}" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MASTER-DETAIL GUESSING WORKSPACE (Grid.Row="1", Height="*") -->
        <Grid Grid.Row="1" Margin="32,16,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/> <!-- Left Panel: Target Client, Active Unknowns & Attack Algorithms List -->
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>   <!-- Right Panel: Method Detail, Execution Hero & Live Results -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: TARGET CLIENT, ACTIVE UNKNOWNS & METHODS LIST -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Target Client Header -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/> <!-- Target Client Selector -->
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/> <!-- Active Unknowns Header -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/> <!-- Active Unknowns Card -->
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/> <!-- Attack Algorithms Header -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>    <!-- ListBox of Methods -->
                    </Grid.RowDefinitions>

                    <!-- TARGET CLIENT -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TARGET CLIENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ComboBox Grid.Row="2"
                              x:Name="DomainSelector"
                              Style="{StaticResource ModernComboBox}"
                              SelectedIndex="0"
                              Height="36"
                              VerticalContentAlignment="Center"
                              SelectionChanged="DomainSelector_SelectionChanged">
                        <ComboBoxItem Content="Game" Tag="Game"/>
                        <ComboBoxItem Content="Lcu" Tag="Lcu"/>
                        <ComboBoxItem Content="Bin" Tag="Bin"/>
                        <ComboBoxItem Content="Rst" Tag="Rst"/>
                    </ComboBox>

                    <!-- ACTIVE UNKNOWNS HEADER -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Radar" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ACTIVE UNKNOWNS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ACTIVE UNKNOWNS CARD -->
                    <Border Grid.Row="6" Background="{StaticResource HoverColor}" CornerRadius="8" Padding="14,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtUnknownCount" Text="Loading..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtUnknownBreakdown" Text="" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SidebarBackground}" CornerRadius="6" Width="30" Height="30" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ATTACK ALGORITHMS -->
                    <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Brain" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ATTACK ALGORITHMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Row="10"
                             x:Name="TxtMethodSearch"
                             Style="{StaticResource StandardSearchBoxStyle}"
                             Height="34"
                             Tag="Search algorithms..."
                             TextChanged="TxtMethodSearch_TextChanged"/>

                    <ListBox Grid.Row="12"
                             x:Name="MethodsListBox"
                             ItemsSource="{Binding AvailableMethods}"
                             SelectedItem="{Binding SelectedMethod}"
                             ItemTemplate="{StaticResource HashMethodTemplate}"
                             ItemContainerStyle="{StaticResource HashMethodItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: METHOD DETAIL, EXECUTION HERO & RESULTS -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Selected Method Card with Hero Run Button -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>    <!-- Results Section -->
                </Grid.RowDefinitions>

                <!-- SELECTED METHOD HERO CARD -->
                <Border Grid.Row="0" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="18,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Method Info & Action Buttons -->
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/> <!-- Sub-Algorithms Checkbox Grid -->
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                        </Grid.RowDefinitions>

                        <!-- Method Info & Action Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Title & Desc -->
                                <ColumnDefinition Width="Auto"/> <!-- Hero Action -->
                            </Grid.ColumnDefinitions>

                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="10"
                                    Background="{StaticResource SidebarBackground}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding SelectedMethod.IconKind, FallbackValue=LightningBolt}"
                                                            Width="24"
                                                            Height="24"
                                                            Foreground="{Binding SelectedMethod.BadgeBrush, FallbackValue={StaticResource AccentBrush}}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedMethod.Name, FallbackValue='Select an algorithm'}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding SelectedMethod.Description, FallbackValue='Choose a specialized attack algorithm from the left panel to execute.'}"
                                           Margin="0,3,0,0"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Hero Run Button & Cancel -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRunMethod"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="38"
                                        Padding="16,0"
                                        Click="RunSelectedMethod_Click"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RUN METHOD" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Cancel"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="38"
                                        Margin="8,0,0,0"
                                        Click="Cancel_Click"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-Algorithms Checkbox Grid (Visible when SelectedMethod.HasSubMethods == true) -->
                        <Grid Grid.Row="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMethod.HasSubMethods}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Toolbar: Select All / Deselect All -->
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/> <!-- ItemsControl with MaxHeight and ScrollViewer -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Tune" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="SELECT SUB-ALGORITHMS TO EXECUTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Select All" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" FontSize="10" Click="SelectAllSubMethods_Click" Margin="0,0,6,0"/>
                                    <Button Content="Deselect All" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" FontSize="10" Click="DeselectAllSubMethods_Click"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="2" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                <ItemsControl ItemsSource="{Binding SelectedMethod.SubMethods}"
                                              ItemTemplate="{StaticResource HashMethodSubItemTemplate}"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Progress Bar & Status -->
                        <Border Grid.Row="4" Background="{StaticResource HoverColor}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Sync" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                            <materialIcons:MaterialIcon.Style>
                                                <Style TargetType="materialIcons:MaterialIcon">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="RotationStoryboard">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="RotationStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialIcons:MaterialIcon.Style>
                                        </materialIcons:MaterialIcon>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" FontWeight="Black" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <ProgressBar Grid.Row="2" Value="{Binding ProgressValue}" Maximum="100" Height="8" Style="{StaticResource ModernProgressBar}" IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RESULTS SECTION -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Export -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CheckDecagram" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="DETERMINISTIC RESULTS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource HoverColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Matches.Count, StringFormat='{}{0} Resolved &amp; Saved'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Export JSON" Style="{StaticResource SecondaryButton}" Click="ExportJson_Click"
                                    ToolTip="Export all current resolved matches to a JSON file"/>
                        </Grid>

                        <!-- Results ListView -->
                        <ListView x:Name="ResultsListView"
                                  Grid.Row="2"
                                  ItemsSource="{Binding Matches}"
                                  Style="{StaticResource ModernTableListView}"
                                  Loaded="ResultsListView_Loaded"
                                  SizeChanged="ResultsListView_SizeChanged">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="Hash" Width="105">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeader}">
                                                <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,7"/>
                                            </Style>
                                        </GridViewColumn.HeaderContainerStyle>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HashText}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Domain" Width="58">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeader}">
                                                <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,7"/>
                                            </Style>
                                        </GridViewColumn.HeaderContainerStyle>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DomainText}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Resolved value" Width="230">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeader}">
                                                <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,7"/>
                                            </Style>
                                        </GridViewColumn.HeaderContainerStyle>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path=Path}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Strategy" Width="105">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeader}">
                                                <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,7"/>
                                            </Style>
                                        </GridViewColumn.HeaderContainerStyle>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HoverColor}" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StrategyText}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Source WAD" Width="150">
                                        <GridViewColumn.HeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeader}">
                                                <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,7"/>
                                            </Style>
                                        </GridViewColumn.HeaderContainerStyle>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SourceWadPath}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
