<UserControl x:Class="AssetsManager.Views.HashGuessingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource AppFontFamily}">
    <UserControl.Resources>
        <Style x:Key="LabCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style x:Key="LabSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="LabResultsTable" TargetType="ListView" BasedOn="{StaticResource ModernTableListView}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CompactModuleHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="{StaticResource SidebarBackground}" CornerRadius="10" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="26" Height="26" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Hash Guessing Lab" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Turn unknown hashes into verified asset names." Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,16,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource LabSurface}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialIcons:MaterialIcon Kind="Target" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="TARGET DOMAIN" Style="{StaticResource LabCaption}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="DomainSelector" Style="{StaticResource ModernComboBox}"
                                  SelectedIndex="0" Height="36" VerticalContentAlignment="Center"
                                  SelectionChanged="DomainSelector_SelectionChanged">
                            <ComboBoxItem Content="Game" Tag="Game"/>
                            <ComboBoxItem Content="Lcu" Tag="Lcu"/>
                            <ComboBoxItem Content="Bin" Tag="Bin"/>
                            <!-- RST remains available for future reactivation. -->
                            <!-- <ComboBoxItem Content="RST strings" Tag="Rst"/> -->
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource SidebarBackground}" CornerRadius="10" Padding="16,14" Margin="0,16,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="UNKNOWN HASHES" Style="{StaticResource LabCaption}"/>
                                <TextBlock x:Name="TxtUnknownCount" Text="Loading..." FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtUnknownBreakdown" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Radar" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" Opacity="0.8" VerticalAlignment="Top" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="FlaskOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="SELECT A METHOD" Style="{StaticResource LabCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AvailableMethods.Count, StringFormat='{}{0} available'}" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBox x:Name="TxtMethodSearch" Style="{StaticResource StandardSearchBoxStyle}" Height="34"
                                 Tag="Find a method..." TextChanged="TxtMethodSearch_TextChanged" Margin="0,0,0,12"/>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="MethodsListBox" ItemsSource="{Binding AvailableMethods}" SelectedItem="{Binding SelectedMethod}"
                                 ItemTemplate="{StaticResource HashGuessingTemplate}" ItemContainerStyle="{StaticResource HashGuessingItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="No methods match your search." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvailableMethods.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="Auto"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMethod.HasSubMethods}" Value="True">
                                        <Setter Property="Height" Value="1.8*"/>
                                        <Setter Property="MinHeight" Value="210"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource LabSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,18,20,16">
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CONFIGURE &amp; RUN" Style="{StaticResource LabCaption}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SelectedMethod.Category, TargetNullValue='No method selected'}" FontSize="10" Foreground="{Binding SelectedMethod.BadgeBrush, FallbackValue={StaticResource AccentBrush}}"/>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource SidebarBackground}" VerticalAlignment="Top">
                                        <materialIcons:MaterialIcon Kind="{Binding SelectedMethod.IconKind, FallbackValue=LightningBolt}" Width="26" Height="26"
                                                                    Foreground="{Binding SelectedMethod.BadgeBrush, FallbackValue={StaticResource AccentBrush}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding SelectedMethod.Name, TargetNullValue='Select a method', FallbackValue='Select a method'}"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedMethod.Description, TargetNullValue='Choose a method from the library to get started.'}"
                                                   Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMethod.HasSubMethods}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="INCLUDED STRATEGIES" Style="{StaticResource LabCaption}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource TransparentIconButton}" Width="28" Height="28" Click="SelectAllSubMethods_Click" ToolTip="Select all strategies" Margin="0,0,4,0">
                                                <materialIcons:MaterialIcon Kind="SelectAll" Width="16" Height="16"/>
                                            </Button>
                                            <Button Style="{StaticResource TransparentIconButton}" Width="28" Height="28" Click="DeselectAllSubMethods_Click" ToolTip="Deselect all strategies">
                                                <materialIcons:MaterialIcon Kind="SelectRemove" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedMethod.SubMethods}" ItemTemplate="{StaticResource HashGuessingSubItemTemplate}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialIcons:MaterialIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="CircleOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Kind" Value="Sync"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="RotationStoryboard">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="RotationStoryboard"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProgressValue}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0"
                                            Click="Cancel_Click" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button x:Name="BtnRunMethod" Style="{StaticResource PrimaryButton}" Height="36" Padding="20,0" Click="RunSelectedMethod_Click"
                                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Run method" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding ProgressValue}" Maximum="100" Height="3" Margin="0,10,0,0" IsIndeterminate="{Binding IsProgressIndeterminate}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource ModernProgressBar}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProgressValue}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource LabSurface}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="CheckDecagram" Width="14" Height="14" Foreground="{StaticResource AccentTeal}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Resolved matches" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="6" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Matches.Count, StringFormat='{}{0:N0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Verified findings are saved to your local catalogs." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,8,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="ExportJson_Click" ToolTip="Export current resolved matches to JSON" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="Export" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Export JSON" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView x:Name="ResultsListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Matches}"
                                  Style="{StaticResource LabResultsTable}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Loaded="ResultsListView_Loaded"
                                  SizeChanged="ResultsListView_SizeChanged">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernGridViewColumnHeader}">
                                            <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0,7"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Header="Hash" Width="132">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HashText}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" ToolTip="{Binding HashText}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Domain" Width="54">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DomainText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Resolved value" Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path=Path}" ToolTip="{Binding Path=Path}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Strategy" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HoverColor}" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StrategyText}" ToolTip="{Binding StrategyText}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Source WAD" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SourceWadPath}" ToolTip="{Binding SourceWadPath}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Border Grid.Row="1" Background="{StaticResource CardBackground}" Margin="0,34,0,0" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Matches.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="32" Height="32" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Your next discovery starts here"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Text" Value="Searching for verified matches"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Verified matches will appear here." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
