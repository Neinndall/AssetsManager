<UserControl x:Class="AssetsManager.Views.HashGuessingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Main Split (Config & Bento) -->
            <RowDefinition Height="*"/>    <!-- Results & Progress -->
        </Grid.RowDefinitions>

        <!-- DYNAMIC IDENTITY HEADER (SettingsCard Style) -->
        <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="32,24,32,0" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Hero Icon -->
                    <ColumnDefinition Width="Auto"/> <!-- Technical Separator -->
                    <ColumnDefinition Width="*"/>    <!-- Dynamic Titles -->
                </Grid.ColumnDefinitions>

                <!-- Hero Icon (Standardized 48x48 / 26x26) -->
                <Border Grid.Column="0" Background="{StaticResource HoverColor}" CornerRadius="10" Width="48" Height="48">
                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="26" Height="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon.Effect>
                            <DropShadowEffect Color="#FF5C85FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </materialIcons:MaterialIcon.Effect>
                    </materialIcons:MaterialIcon>
                </Border>

                <!-- Technical Vertical Separator (1px) -->
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderColor}" Margin="20,8" VerticalAlignment="Stretch" Opacity="0.5"/>

                <!-- Dynamic Titles Area (22px / 12px) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="HASH GUESSING LAB" FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <TextBlock Text="Resolve unknown WAD hashes from embedded asset paths and merge verified matches into the main hash files." FontSize="12" Foreground="{StaticResource TextMuted}" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT AREA -->
        <Grid Grid.Row="1" Margin="32,20,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CONFIGURATION & STATS -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Lab Env Title -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/> <!-- Domain Selector -->
                        <RowDefinition Height="16"/>  <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Divider -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>    <!-- Stats Details -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ENVIRONMENT CONFIG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Domain Selector -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Target Client Domain" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DomainSelector" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Height="36" VerticalContentAlignment="Center" SelectionChanged="DomainSelector_SelectionChanged">
                            <ComboBoxItem Content="GAME" Tag="Game"/>
                            <ComboBoxItem Content="LCU" Tag="Lcu"/>
                            <ComboBoxItem Content="BIN" Tag="Bin"/>
                            <ComboBoxItem Content="RST" Tag="Rst"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}" Opacity="0.5"/>

                    <!-- Stats / State -->
                    <StackPanel Grid.Row="6" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialIcons:MaterialIcon Kind="ChartBar" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="LAB STATS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Background="{StaticResource HoverColor}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Centralized Unknowns" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtUnknownCount" Text="Loading..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <materialIcons:MaterialIcon Grid.Column="1" Kind="HelpCircleOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource HoverColor}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Matches Found" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Matches.Count, FallbackValue='0'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <materialIcons:MaterialIcon Grid.Column="1" Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: SELECTION CARD ACTIONS (Matches ManageVersionsControl buttons style) -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>    <!-- Bento Menu -->
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Brain" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="GUESSING ALGORITHMS &amp; STRATEGIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <Grid>
                            <!-- GAME OPTIONS -->
                            <StackPanel x:Name="GameOptionsPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="FileSearch" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="WAD PATH EXTRACTION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Click="RunGrepGame_Click" Margin="4,0,4,16" Padding="12">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="WAD Path GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Extract game paths from WADs" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="GamepadVariantOutline" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GAME RESOLVERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- GAME Basic -->
                                    <Button Click="RunGameBasic_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="GAME Basic Suite" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Standard canonical &amp; short ranges" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- GAME Extended -->
                                    <Button Click="RunGameExtended_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="CrownOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="GAME Extended" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Chromas, bins, textures &amp; banners" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="WrenchOutline" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="UTILITY STRATEGIES" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <!-- Canonical -->
                                    <Button Click="RunCanonical_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="HexagonOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Canonical Patterns" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Standard paths" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Locales -->
                                    <Button Click="RunLocales_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Translate" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Locale Variants" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Region &amp; lang tags" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Numbers -->
                                    <Button Click="RunNumbers_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Numeric" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Numeric Ranges" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Iterate numeric indexes" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- LCU OPTIONS -->
                            <StackPanel x:Name="LcuOptionsPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="FileSearch" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="WAD PATH EXTRACTION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Click="RunGrepLcu_Click" Margin="4,0,4,16" Padding="12">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="WAD Path GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Extract client paths from WADs" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="Lan" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LCU RESOLVERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- LCU Basic -->
                                    <Button Click="RunLcuBasic_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FileCabinet" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="LCU Basic Suite" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Canonical &amp; LCU plugin structure" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- LCU Advanced -->
                                    <Button Click="RunLcuAdvanced_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="LightningBolt" Width="24" Height="24" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="LCU Advanced" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="SVGs, PNGs, word insertion &amp; TFTs" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="WrenchOutline" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="UTILITY STRATEGIES" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <!-- Canonical -->
                                    <Button Click="RunCanonical_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="HexagonOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Canonical Patterns" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Standard paths" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Locales -->
                                    <Button Click="RunLocales_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Translate" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Locale Variants" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Region &amp; lang tags" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Numbers -->
                                    <Button Click="RunNumbers_Click" Margin="4" Padding="12">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SelectionCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Numeric" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Numeric Ranges" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Iterate numeric indexes" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- BIN OPTIONS -->
                            <StackPanel x:Name="BinOptionsPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="FileCabinet" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                                    <TextBlock Text="BIN INTERNAL HASHES" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Button Click="BuildInternalInventory_Click" Margin="4,0,4,12" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Build BIN Inventory" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Parse internal hashes from BIN files" FontSize="9.5" Foreground="{StaticResource TextSecondary}"/></StackPanel>
                                    </Grid>
                                </Button>
                                <UniformGrid Columns="2">
                                    <Button Click="RunInternalContent_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                                        <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialIcons:MaterialIcon Kind="CodeBraces" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="BIN Local GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Local BIN, text and executable" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel></Grid>
                                    </Button>
                                    <Button Click="RunInternalStructural_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                                        <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialIcons:MaterialIcon Kind="ShieldOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="BIN Structural" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Entries, fields, types and values" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel></Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- RST OPTIONS -->
                            <StackPanel x:Name="RstOptionsPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                    <materialIcons:MaterialIcon Kind="Translate" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                                    <TextBlock Text="RST STRINGTABLE HASHES" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Button Click="BuildInternalInventory_Click" Margin="4,0,4,12" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Build RST Inventory" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Parse XXH3/XXH64 unknown keys" FontSize="9.5" Foreground="{StaticResource TextSecondary}"/></StackPanel>
                                    </Grid>
                                </Button>
                                <UniformGrid Columns="2">
                                    <Button Click="RunInternalContent_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                                        <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialIcons:MaterialIcon Kind="Translate" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="RST Content GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="BIN strings and text resources" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel></Grid>
                                    </Button>
                                    <Button Click="RunInternalStructural_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                                        <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialIcons:MaterialIcon Kind="Numeric" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="RST Structural" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Cross-version and numeric keys" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel></Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- RESULTS AND POLISHED PROGRESS SECTION -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="32,20,32,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Promotion Button -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/> <!-- Polished Progress Bar area -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>    <!-- ListView results -->
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CheckDecagram" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="DETERMINISTIC RESULTS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource HoverColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Matches.Count, StringFormat='{}{0} Resolved &amp; Saved'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Padding="14,5"
                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Polished Progress Bar -->
                <Border Grid.Row="2" Background="{StaticResource HoverColor}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Icon -->
                                <materialIcons:MaterialIcon Kind="Sync" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                    <materialIcons:MaterialIcon.Style>
                                        <Style TargetType="materialIcons:MaterialIcon">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="RotationStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="RotationStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialIcons:MaterialIcon.Style>
                                </materialIcons:MaterialIcon>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Progress Value Badge -->
                            <TextBlock Grid.Column="1" Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Black" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Smooth Modern Progress Bar -->
                        <ProgressBar Grid.Row="2" Value="{Binding ProgressValue}" Maximum="100" Height="8" Style="{StaticResource ModernProgressBar}" IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                    </Grid>
                </Border>
                
                <!-- Results List -->
                <ListView Grid.Row="4" ItemsSource="{Binding Matches}" Style="{StaticResource ModernListView}" SizeChanged="ListView_SizeChanged">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Hash" Width="140">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HashText}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Domain" Width="80">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DomainText}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Resolved value" Width="340">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=Path}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Strategy" Width="135">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource HoverColor}" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StrategyText}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Source WAD" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SourceWadPath}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
