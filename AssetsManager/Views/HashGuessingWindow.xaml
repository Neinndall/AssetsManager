<UserControl x:Class="AssetsManager.Views.HashGuessingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Config & Dashboard Bar -->
            <RowDefinition Height="Auto"/> <!-- Algorithms & Strategies Bento -->
            <RowDefinition Height="*"/>    <!-- Results & Progress -->
        </Grid.RowDefinitions>

        <!-- DYNAMIC IDENTITY HEADER (SettingsCard Style) -->
        <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="32,24,32,0" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Hero Icon -->
                    <ColumnDefinition Width="Auto"/> <!-- Technical Separator -->
                    <ColumnDefinition Width="*"/>    <!-- Dynamic Titles -->
                </Grid.ColumnDefinitions>

                <!-- Hero Icon (Standardized 48x48 / 26x26) -->
                <Border Grid.Column="0" Background="{StaticResource HoverColor}" CornerRadius="10" Width="48" Height="48">
                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="26" Height="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon.Effect>
                            <DropShadowEffect Color="#FF5C85FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </materialIcons:MaterialIcon.Effect>
                    </materialIcons:MaterialIcon>
                </Border>

                <!-- Technical Vertical Separator (1px) -->
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderColor}" Margin="20,8" VerticalAlignment="Stretch" Opacity="0.5"/>

                <!-- Dynamic Titles Area (22px / 12px) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="HASH GUESSING LAB" FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <TextBlock Text="Resolve unknown WAD, BIN &amp; RST hashes using specialized guessing algorithms and merge verified matches." FontSize="12" Foreground="{StaticResource TextSecondary}" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONFIG & DASHBOARD STATS BAR -->
        <Grid Grid.Row="1" Margin="32,16,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- Target Client Domain -->
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>   <!-- Stats Cards Grid -->
            </Grid.ColumnDefinitions>

            <!-- DOMAIN SELECTOR CARD -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="14,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TARGET CLIENT DOMAIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="DomainSelector" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Height="36" VerticalContentAlignment="Center" SelectionChanged="DomainSelector_SelectionChanged">
                        <ComboBoxItem Content="GAME (WAD Hashes)" Tag="Game"/>
                        <ComboBoxItem Content="LCU (Client Hashes)" Tag="Lcu"/>
                        <ComboBoxItem Content="BIN (Internal Hashes)" Tag="Bin"/>
                        <ComboBoxItem Content="RST (String Table Keys)" Tag="Rst"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- STATS OVERVIEW CARDS -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Unresolved Hashes -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="UNRESOLVED HASHES IN SCOPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtUnknownCount" Text="Loading..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="TxtUnknownBreakdown" Text="Loading..." FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource HoverColor}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Matches Found -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DETERMINISTIC MATCHES FOUND" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Matches.Count, FallbackValue='0'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="Verified and committed to dictionary" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource HoverColor}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ALGORITHMS & STRATEGIES BENTO MENU -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="32,16,32,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/> <!-- Content Panels -->
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Brain" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="GUESSING ALGORITHMS &amp; STRATEGIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- GAME OPTIONS PANEL -->
                <StackPanel x:Name="GameOptionsPanel" Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <UniformGrid Columns="3">
                        <!-- WAD Path GREP -->
                        <Button Click="RunGrepGame_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="WAD Path GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Extract game paths from WADs" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- GAME Basic -->
                        <Button Click="RunGameBasic_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GAME Basic Suite" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Canonical &amp; short ranges" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- GAME Extended -->
                        <Button Click="RunGameExtended_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CrownOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GAME Extended" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Chromas, bins &amp; textures" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Canonical -->
                        <Button Click="RunCanonical_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="HexagonOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Canonical Patterns" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Standard path templates" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Locales -->
                        <Button Click="RunLocales_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Translate" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Locale Variants" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Region &amp; language tags" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Numbers -->
                        <Button Click="RunNumbers_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Numeric" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Numeric Ranges" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Iterate numeric indexes" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- LCU OPTIONS PANEL -->
                <StackPanel x:Name="LcuOptionsPanel" Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <UniformGrid Columns="3">
                        <!-- LCU GREP -->
                        <Button Click="RunGrepLcu_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="WAD Path GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Extract client paths from WADs" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- LCU Basic -->
                        <Button Click="RunLcuBasic_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileCabinet" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="LCU Basic Suite" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Canonical &amp; plugin structure" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- LCU Advanced -->
                        <Button Click="RunLcuAdvanced_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="LightningBolt" Width="24" Height="24" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="LCU Advanced" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="SVGs, PNGs &amp; TFTs" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- LCU V1 Paths -->
                        <Button Click="RunLcuV1Paths_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FileCodeOutline" Width="24" Height="24" Foreground="{StaticResource AccentTeal}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="LCU V1 Paths" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Intensive word-pair patterns" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Canonical -->
                        <Button Click="RunCanonical_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="HexagonOutline" Width="24" Height="24" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Canonical Patterns" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Standard path templates" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Locales -->
                        <Button Click="RunLocales_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Translate" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Locale Variants" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Region &amp; language tags" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- BIN OPTIONS PANEL -->
                <StackPanel x:Name="BinOptionsPanel" Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <UniformGrid Columns="3">
                        <Button Click="BuildInternalInventory_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Build BIN Inventory" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="BIN runtime + active Meta Schema" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Click="RunInternalContent_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="BIN Context" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Verified context-linked values" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Click="RunInternalStructural_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="FlaskOutline" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Meta Schema Guess" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Review-only type/field candidates" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- RST OPTIONS PANEL -->
                <StackPanel x:Name="RstOptionsPanel" Grid.Row="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=DomainSelector}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <UniformGrid Columns="3">
                        <Button Click="BuildInternalInventory_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Build RST Inventory" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Parse XXH3/XXH64 unknown keys" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Click="RunInternalContent_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="Translate" Width="24" Height="24" Foreground="{StaticResource AccentPurple}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="RST Content GREP" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="BIN strings and text resources" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Click="RunInternalStructural_Click" Margin="4" Padding="12" Style="{StaticResource SelectionCardButtonStyle}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon Kind="Numeric" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="RST Structural" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Cross-version and numeric keys" FontSize="9.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESULTS AND POLISHED PROGRESS SECTION (FLEXIBLE HEIGHT *) -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="32,16,32,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Promotion Button -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/> <!-- Polished Progress Bar area -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>    <!-- ListView results -->
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CheckDecagram" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="DETERMINISTIC RESULTS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource HoverColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Matches.Count, StringFormat='{}{0} Resolved &amp; Saved'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"
                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Polished Progress Bar -->
                <Border Grid.Row="2" Background="{StaticResource HoverColor}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Icon -->
                                <materialIcons:MaterialIcon Kind="Sync" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                    <materialIcons:MaterialIcon.Style>
                                        <Style TargetType="materialIcons:MaterialIcon">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="RotationStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="RotationStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialIcons:MaterialIcon.Style>
                                </materialIcons:MaterialIcon>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Progress Value Badge -->
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" FontWeight="Black" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Smooth Modern Progress Bar -->
                        <ProgressBar Grid.Row="2" Value="{Binding ProgressValue}" Maximum="100" Height="8" Style="{StaticResource ModernProgressBar}" IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                    </Grid>
                </Border>
                
                <!-- Results List -->
                <ListView x:Name="ResultsListView"
                          Grid.Row="4"
                          ItemsSource="{Binding Matches}"
                          Style="{StaticResource HashResultsListView}"
                          Loaded="ResultsListView_Loaded"
                          SizeChanged="ResultsListView_SizeChanged">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Hash" Width="120">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource HashResultsColumnHeader}">
                                        <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HashText}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Domain" Width="130">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource HashResultsColumnHeader}">
                                        <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DomainText}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Resolved value" Width="320">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource HashResultsColumnHeader}">
                                        <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=Path}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Strategy" Width="170">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource HashResultsColumnHeader}">
                                        <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource HoverColor}" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StrategyText}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Source WAD" Width="240">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource HashResultsColumnHeader}">
                                        <EventSetter Event="SizeChanged" Handler="ResultsColumnHeader_SizeChanged"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SourceWadPath}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
