<UserControl x:Class="AssetsManager.Views.Controls.Viewer.VfxInspectorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource SidebarBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Segmented Tab Style (using HoverColor from Colors.xaml) -->
        <Style x:Key="LtkSegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Padding="8,5" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List Item Container: Animations (HoverColor on hover & selection) -->
        <Style x:Key="LtkAnimationItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon x:Name="ItemIcon" Grid.Column="0" Kind="MotionPlayOutline" Width="17" Height="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ItemTitle" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:F2}s'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" Padding="6,2" CornerRadius="4"
                                        Background="#26F59E0B"
                                        Visibility="{Binding HasVfx, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding VfxSummary}" FontSize="9" FontWeight="Bold" Foreground="#FFFBBF24"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List Item Container: VFX Systems (HoverColor on hover & selection) -->
        <Style x:Key="LtkSystemItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialIcons:MaterialIcon x:Name="ItemIcon" Grid.Column="0" Kind="ApplicationCogOutline" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ItemTitle" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding EmitterCount, StringFormat='{}Emitters: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding TextureCount, StringFormat='{}Tex: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Toolbar / ROOT Selector -->
            <RowDefinition Height="*"/>    <!-- 1: Main Management Area -->
        </Grid.RowDefinitions>

        <!-- 0. TOP TOOLBAR: Unified Capsule with ROOT & BIN selection -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title / Metadata -->
                    <ColumnDefinition Width="*"/>    <!-- Tools Capsule -->
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="VFX MANAGEMENT" Style="{StaticResource ToolSectionLabel}" Margin="0,0,0,2"/>
                    <TextBlock Text="Champion VFX &amp; Emitter Control Deck" FontSize="10" Foreground="{StaticResource TextPrimary}" Opacity="0.8"/>
                </StackPanel>

                <!-- Right: Path & BIN Selection Tools Capsule (wraps instead of clipping on narrow widths) -->
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource SidebarBackground}" CornerRadius="6" Padding="10,4"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                    <WrapPanel VerticalAlignment="Center">
                        <!-- ROOT Path Group -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ROOT Path:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="RootPathTextBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="11" Width="220"
                                     VerticalAlignment="Center" KeyDown="RootPathTextBox_KeyDown"/>
                            <Button Click="BrowseRoot_Click"
                                    Style="{StaticResource BrowseButtonStyle}" Width="32" Height="32" Padding="0" Margin="6,0,0,0" ToolTip="Browse ROOT Directory">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <!-- SEPARATOR -->
                        <Border Width="1" Height="20" Background="{StaticResource BorderColor}" Margin="12,0" VerticalAlignment="Center" Opacity="0.8"/>

                        <!-- Skin Selector Group -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{StaticResource AccentOrange}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Skin:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BinComboBox" ItemsSource="{Binding DetectedSkins}" SelectedItem="{Binding SelectedSkin, Mode=TwoWay}"
                                      SelectionChanged="BinSelector_SelectionChanged" Style="{StaticResource ModernComboBox}"
                                      Width="170" Height="32" FontSize="11" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,0">
                                            <materialIcons:MaterialIcon Kind="Palette" Width="14" Height="14" Foreground="{StaticResource AccentOrange}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1. MAIN MANAGEMENT WORKSPACE -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/> <!-- Left: Systems List -->
                <ColumnDefinition Width="8"/>   <!-- Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Right: 3D Viewport & Systems Breakdown -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: VFX Systems List -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="10" 
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Systems ListView -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <!-- Mode Switch Capsule: ANIMATIONS vs SYSTEMS (.BIN) in LTK Slate Style -->
                        <Border Background="{StaticResource SidebarBackground}" CornerRadius="8" Padding="2" Margin="0,0,0,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <UniformGrid Columns="2" Height="30">
                                <RadioButton Content="ANIMACIONES"
                                             IsChecked="{Binding IsAnimationMode, Mode=TwoWay}"
                                             Style="{StaticResource LtkSegmentedTabStyle}"
                                             FontSize="10.5" FontWeight="Bold"/>
                                <RadioButton Content="SISTEMAS (.BIN)"
                                             IsChecked="{Binding IsRawSystemsMode, Mode=TwoWay}"
                                             Style="{StaticResource LtkSegmentedTabStyle}"
                                             FontSize="10.5" FontWeight="Bold"/>
                            </UniformGrid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsAnimationMode, Converter={StaticResource BoolToVis}}">
                            <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="18" Height="18" Foreground="#3B82F6" Margin="0,0,8,0"/>
                            <TextBlock Text="CLIPS &amp; ANIMATIONS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRawSystemsMode, Converter={StaticResource BoolToVis}}">
                            <materialIcons:MaterialIcon Kind="ApplicationCogOutline" Width="18" Height="18" Foreground="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="VFX SYSTEMS (.BIN)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Search Filter (visible for both modes) -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardSearchBoxStyle}"
                             Tag="Search animations, clips or VFX..."
                             Height="34"
                             Margin="0,0,0,10"
                             TextChanged="SearchQuery_TextChanged"/>

                    <!-- Content Lists Container -->
                    <Grid Grid.Row="2">
                        <!-- 1. ANIMATIONS LIST (Champion Viewport / Skin Viewport mode) -->
                        <ListView ItemsSource="{Binding DetectedAnimations}"
                                  SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource LtkAnimationItemStyle}"
                                  Visibility="{Binding IsAnimationMode, Converter={StaticResource BoolToVis}}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <!-- 2. RAW SYSTEMS LIST (VFX Diagnostic Inspector mode) -->
                        <ListView ItemsSource="{Binding Systems}"
                                  SelectedItem="{Binding SelectedSystem, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource LtkSystemItemStyle}"
                                  Visibility="{Binding IsRawSystemsMode, Converter={StaticResource BoolToVis}}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT PANEL: 3D Viewport & Independent Timeline Deck (Split Vertically) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220"/> <!-- 3D Viewport Card -->
                    <RowDefinition Height="6"/>                  <!-- Resize Splitter -->
                    <RowDefinition Height="2*" MinHeight="170"/> <!-- Timeline Deck Card -->
                </Grid.RowDefinitions>

                <!-- 1. 3D REAL-TIME VIEWPORT CARD (Edge-to-Edge) -->
                <Border Grid.Row="0" Background="#0A0A0E" CornerRadius="10" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <glWpfControl:GLWpfControl x:Name="OpenTkControl" 
                                             Ready="OpenTkControl_Ready" 
                                             Render="OpenTkControl_Render"/>

                        <!-- HUD Overlay in Viewport (Top-Left: System & Live Particles) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="AutoAwesome" Width="15" Height="15" Foreground="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedSystem.Name, FallbackValue='No system selected'}" FontWeight="Bold" FontSize="11.5" Foreground="White" VerticalAlignment="Center"/>
                                <Border Width="1" Height="14" Background="{StaticResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="Grain" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LiveParticleCount, StringFormat='{}Particles: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Viewport Quick Toolbar (Top-Right: Champion Mesh Toggle & Reset Camera) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="4,3">
                            <StackPanel Orientation="Horizontal">
                                <!-- Simulation Rig Motion Preset (LTK-Manager style: Still, Burst, Missile, Trail) -->
                                <Button Click="RigPreset_Click" Style="{StaticResource TransparentIconButton}" 
                                        Height="26" Padding="6,0" Margin="0,0,4,0" 
                                        ToolTip="VFX Simulation Rig Motion (Still / Burst / Missile / Trail)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="{Binding RigPresetIcon}" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RigPresetText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#FF161822" BorderBrush="{StaticResource BorderColor}" Foreground="White">
                                            <MenuItem Header="Still (Stationary single run)" Tag="Still" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="14" Height="14" Foreground="{StaticResource TextSecondary}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Burst (Stationary loop)" Tag="Burst" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Sparkles" Width="14" Foreground="{StaticResource AccentGreen}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Missile (Flight projectile path)" Tag="Missile" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Trail (Orbit circuit path)" Tag="Trail" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{StaticResource AccentPurple}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Champion Mesh Toggle -->
                                <ToggleButton IsChecked="{Binding ShowChampionMesh, Mode=TwoWay}" 
                                              Style="{StaticResource TransparentIconToggleButton}" 
                                              Width="28" Height="26" Margin="0,0,4,0" 
                                              ToolTip="Toggle Champion 3D Model Mesh (when available)" 
                                              Visibility="{Binding HasChampionMesh, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="15" Height="15"/>
                                </ToggleButton>

                                <!-- Reset Camera / Focus (F) -->
                                <Button Click="ResetCamera_Click" Style="{StaticResource TransparentIconButton}" 
                                            Width="28" Height="26" ToolTip="Reset Camera View (F)">
                                    <materialIcons:MaterialIcon Kind="CameraRetakeOutline" Width="15" Height="15" Foreground="{StaticResource TextSecondary}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- SPLITTER (Seamless Viewport vs Timeline height adjust) -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                              Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>

                <!-- 2. TIMELINE & TRANSPORT DECK (Independent Card outside Viewport, LTK-Manager / DAW Studio Style) -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="10" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 1. Top Transport Controls & Search Bar -->
                            <RowDefinition Height="Auto"/> <!-- 2. Separator -->
                            <RowDefinition Height="Auto"/> <!-- 3. Time Ruler Header (Aligned with Tracks) -->
                            <RowDefinition Height="*"/>    <!-- 4. Scrollable Emitter Lanes & Interactive Tracks Grid -->
                        </Grid.RowDefinitions>

                        <!-- 1. TOP TRANSPORT CONTROLS & SEARCH BAR (LTK-Manager layout) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Left: Badge & Filter Search -->
                                <ColumnDefinition Width="*"/>    <!-- Middle spacer -->
                                <ColumnDefinition Width="Auto"/> <!-- Right: Transport Buttons, Time, Speed, Loop, BG -->
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Slider to preserve two-way time binding & event hooks -->
                            <Slider x:Name="TimeSlider" Visibility="Collapsed" Minimum="0" Maximum="{Binding TotalDuration}" 
                                    Value="{Binding CurrentTime, Mode=TwoWay}" ValueChanged="TimeSlider_ValueChanged"
                                    PreviewMouseDown="TimeSlider_PreviewMouseDown" PreviewMouseUp="TimeSlider_PreviewMouseUp"/>

                            <!-- LEFT: [TIMELINE] BADGE & FILTER SEARCH BOX -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- TIMELINE Pill Badge -->
                                <Border Background="#161A24" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="TIMELINE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Filter Emitters Search Input -->
                                <Border Background="{StaticResource DarkBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        CornerRadius="5" Height="28" Width="180" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FilterVariant" Width="13" Height="13" 
                                                                    Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="EmitterFilterTextBox"
                                                 Text="{Binding EmitterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="EmitterFilter_TextChanged"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="White"
                                                 FontSize="11" VerticalContentAlignment="Center" Padding="0,0,4,0"/>
                                        <!-- Watermark / Placeholder -->
                                        <TextBlock Grid.Column="1" Text="Filter emitters..." Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Click="ClearEmitterFilter_Click" Style="{StaticResource TransparentIconButton}"
                                                Width="20" Height="20" Margin="0,0,2,0" ToolTip="Clear Filter"
                                                Visibility="{Binding HasEmitterFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource TextMuted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT: TRANSPORT ACTION BUTTONS, TIME READOUT, SPEED, LOOP, BG -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Step Back Button (|<) -->
                                <Button Click="StepBack_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Step Back / Rewind to 0.00s">
                                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="16" Height="16" Foreground="{StaticResource TextPrimary}"/>
                                </Button>

                                <!-- Dynamic Play / Pause / Replay Button -->
                                <Button Click="PlayPauseToggle_Click" Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                                        Background="#1E2330" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <materialIcons:MaterialIcon Width="16" Height="16">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="Play"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Kind" Value="Pause"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                                            <Condition Binding="{Binding IsReplayState}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Kind" Value="Replay"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <!-- Step Forward Button (>|) -->
                                <Button Click="StepForward_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="28" Height="28" Padding="0" Margin="0,0,10,0" ToolTip="Step Forward (+1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipNext" Width="16" Height="16" Foreground="{StaticResource TextPrimary}"/>
                                </Button>

                                <!-- Time Readout: 0.36 / 11.75 s -->
                                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas">
                                    <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat={}{0:F2}}" Foreground="{StaticResource TextPrimary}"/>
                                    <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                                    <Run Text="{Binding TotalDuration, Mode=OneWay, StringFormat={}{0:F2} s}" Foreground="{StaticResource TextMuted}"/>
                                    <Run Text="{Binding ActiveLoopDurationText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                </TextBlock>

                                <!-- Separator -->
                                <Border Width="1" Height="18" Background="{StaticResource BorderColor}" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.6"/>

                                <!-- Speed Control -->
                                <materialIcons:MaterialIcon Kind="Speedometer" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SpeedComboBox" Style="{StaticResource ModernComboBox}" Width="76" Height="26" SelectionChanged="Speed_SelectionChanged" SelectedIndex="2" Margin="0,0,8,0">
                                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                </ComboBox>

                                <!-- Loop Toggle Pill Button -->
                                <ToggleButton IsChecked="{Binding IsPreviewLoopEnabled, Mode=TwoWay}"
                                              Height="26" Padding="8,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Toggle Loop Boundary">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#253B82F6"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="Loop" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <!-- BG Mode Selector -->
                                <TextBlock Text="BG:" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BgComboBox" Style="{StaticResource ModernComboBox}" Width="80" Height="26" SelectionChanged="BgMode_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Alpha"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 2. SUBTLE SEPARATOR -->
                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,6" Opacity="0.6"/>

                        <!-- 3. TIME RULER HEADER (Aligned with lanes) -->
                        <Grid Grid.Row="2" Margin="0,0,0,4"
                              PreviewMouseDown="Ruler_PreviewMouseDown"
                              PreviewMouseMove="Ruler_PreviewMouseMove"
                              PreviewMouseUp="Ruler_PreviewMouseUp"
                              Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/> <!-- Name & Solo/Mute Header Column -->
                                <ColumnDefinition Width="*"/>   <!-- Time Ruler Ticks & Loop Indicator -->
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/> <!-- Mute All Toggle -->
                                    <ColumnDefinition Width="24"/> <!-- Clear Solos -->
                                    <ColumnDefinition Width="*"/>  <!-- Label -->
                                    <ColumnDefinition Width="24"/> <!-- Header Solo Tag -->
                                </Grid.ColumnDefinitions>

                                <!-- Mute All Toggle -->
                                <Button Grid.Column="0" Click="ToggleMuteAll_Click" Style="{StaticResource TransparentIconButton}" 
                                        Width="20" Height="20" Padding="0" ToolTip="Mute / Unmute All Emitters">
                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="13" Height="13" Foreground="{StaticResource TextMuted}"/>
                                </Button>

                                <!-- Clear Solos Button -->
                                <Button Grid.Column="1" Click="ClearAllSolos_Click" Style="{StaticResource TransparentIconButton}" 
                                        Width="20" Height="20" Padding="0" ToolTip="Clear All Solos" 
                                        IsEnabled="{Binding HasAnySolo}">
                                    <TextBlock Text="S" FontSize="10" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnySolo}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFD700"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="EMITTERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="S" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Ruler Ticks & Live Caption Header -->
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/> <!-- Live Count Column Header -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="0.00s" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding QuarterDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="{Binding HalfDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Text="live" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                            </Grid>
                        </Grid>

                        <!-- 4. TIMELINE TRACKS (Scrollable Emitters Lanes + Sweeping Needles) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                            <Grid x:Name="TimelineInteractiveGrid" Background="Transparent" 
                                  PreviewMouseDown="TimelineGrid_PreviewMouseDown" 
                                  PreviewMouseMove="TimelineGrid_PreviewMouseMove" 
                                  PreviewMouseUp="TimelineGrid_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/> <!-- Names, Thumbnails, Toggles & Solos Column -->
                                    <ColumnDefinition Width="*"/>   <!-- Tracks Canvas Column -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Master System Row + Emitters List -->
                                <StackPanel Grid.Column="0">
                                    <!-- Row #0: Master VFX System Name -->
                                    <Border Height="24" Margin="0,1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#08FFFFFF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoAwesome" Width="13" Height="13" Foreground="#22C55E" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedSystem.Name, FallbackValue='VFX System'}" FontSize="11" FontWeight="Bold" Foreground="#22C55E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Emitter Rows -->
                                    <ItemsControl ItemsSource="{Binding Emitters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="24" Margin="0,1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.4"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.4"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/> <!-- Mute (Eye) -->
                                                            <ColumnDefinition Width="22"/> <!-- Thumbnail Image/Icon -->
                                                            <ColumnDefinition Width="*"/>  <!-- Emitter Name -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Index [16] -->
                                                            <ColumnDefinition Width="24"/> <!-- Solo ('S') -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mute Button (Eye) -->
                                                        <Button Grid.Column="0" Click="EmitterMute_Click" Style="{StaticResource TransparentIconButton}" 
                                                                Width="20" Height="20" Padding="0" ToolTip="Mute (Hide) this emitter" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Width="13" Height="13">
                                                                <materialIcons:MaterialIcon.Style>
                                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                                        <Setter Property="Kind" Value="EyeOutline"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                <Setter Property="Kind" Value="EyeOffOutline"/>
                                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialIcons:MaterialIcon.Style>
                                                            </materialIcons:MaterialIcon>
                                                        </Button>

                                                        <!-- Thumbnail Swatch (Image preview if loaded, else primitive icon) -->
                                                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="2" 
                                                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                                                Background="#10FFFFFF" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding ImagePreview}" Width="16" Height="16" Stretch="UniformToFill" 
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <materialIcons:MaterialIcon Kind="TextureBox" Width="11" Height="11" Foreground="{StaticResource TextMuted}"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon.Style>
                                                                        <Style TargetType="materialIcons:MaterialIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialIcons:MaterialIcon.Style>
                                                                </materialIcons:MaterialIcon>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Emitter Name -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" 
                                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" 
                                                                   ToolTip="{Binding Name}" Margin="4,0,2,0"/>

                                                        <!-- Index Number [16] -->
                                                        <TextBlock Grid.Column="3" Text="{Binding IndexNumber, StringFormat='[{0}]'}" FontSize="9.5" FontFamily="Consolas" 
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Solo Button ('S') -->
                                                        <Button Grid.Column="4" Click="EmitterSolo_Click" Width="20" Height="20" Padding="0" ToolTip="Solo this emitter" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                            <Setter Property="Background" Value="#33FFD700"/>
                                                                            <Setter Property="BorderBrush" Value="#FFD700"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="S" FontSize="10" FontWeight="Black">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FFD700"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right Column: Master Track Bar + Emitter Tracks Bars + Sweeping Needles -->
                                <Grid Grid.Column="1" Margin="8,0,0,0" x:Name="TracksCanvasContainer" SizeChanged="TracksCanvasContainer_SizeChanged">
                                    <StackPanel>
                                        <!-- Row #0: Master VFX System Bar (Subtle sleek bar) -->
                                        <Border Height="24" Margin="0,1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#08FFFFFF">
                                            <Border Background="#2022C55E" BorderBrush="#8022C55E" BorderThickness="1" CornerRadius="2" Height="14" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,44,0"/>
                                        </Border>

                                        <!-- Emitter Bars Stack -->
                                        <ItemsControl ItemsSource="{Binding Emitters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="24" Margin="0,1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.4"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <!-- Authored emitter interval (soft, translucent slate-blue bar with 1px border) -->
                                                            <Border Background="{Binding TrackBrush}" BorderBrush="{Binding TrackBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="2" Height="14" VerticalAlignment="Center" 
                                                                    Margin="{Binding TrackMargin}" HorizontalAlignment="Left" Width="{Binding TrackWidth}">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                                                                </Border.Effect>
                                                            </Border>

                                                            <!-- Emission trigger marker -->
                                                            <Ellipse Width="7" Height="7" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1" 
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                     Margin="{Binding DelayMarkerMargin}" 
                                                                     Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                                     ToolTip="{Binding DelayTime, StringFormat='Emission Trigger: {0:F2}s'}"/>

                                                            <!-- Live Particle Count on Far Right Edge -->
                                                            <TextBlock Text="{Binding ActiveParticleCount}" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Active System Loop Region Translucent Background Overlay -->
                                    <Canvas x:Name="LoopRegionCanvas" IsHitTestVisible="False" Panel.ZIndex="5">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoopEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Rectangle x:Name="LoopRegionRect" Canvas.Left="0" Canvas.Top="0" Height="800"
                                                   Fill="#143B82F6" IsHitTestVisible="False"/>
                                    </Canvas>

                                    <!-- Playhead Needle Overlay Canvas -->
                                    <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False" Panel.ZIndex="10">
                                        <Line x:Name="PlayheadLine" X1="0" Y1="0" X2="0" Y2="800" 
                                              Stroke="#3B82F6" StrokeThickness="1.5"/>
                                        <!-- Playhead Time Chip Flag (LTK-Manager style blue pill reading e.g. 0.38) -->
                                        <Border x:Name="PlayheadTimeChip" Canvas.Left="-18" Canvas.Top="0"
                                                Background="#3B82F6" CornerRadius="2" Padding="3,1" Width="36">
                                            <TextBlock x:Name="PlayheadTimeText" Text="0.00" FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                                                       Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                    </Canvas>

                                    <!-- Active System Loop Boundary Needle Overlay Canvas -->
                                    <Canvas x:Name="LoopBoundaryCanvas" Panel.ZIndex="100">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoopEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Line x:Name="LoopBoundaryLine" X1="0" Y1="0" X2="0" Y2="800" 
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Ellipse x:Name="LoopBoundaryHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE" 
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5" 
                                                 PreviewMouseDown="LoopBoundaryHandle_PreviewMouseDown" 
                                                 PreviewMouseMove="LoopBoundaryHandle_PreviewMouseMove" 
                                                 PreviewMouseUp="LoopBoundaryHandle_PreviewMouseUp" 
                                                 ToolTip="Drag to adjust preview loop boundary">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
