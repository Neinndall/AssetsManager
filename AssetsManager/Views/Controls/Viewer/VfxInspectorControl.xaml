<UserControl x:Class="AssetsManager.Views.Controls.Viewer.VfxInspectorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AssetsManager.Views.Models.Viewer"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource SidebarBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="VfxBrowserItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="IsExpanded" Value="False"/>
            <EventSetter Event="Expanded" Handler="BrowserItem_Expanded"/>
            <Style.Triggers>
                <!-- Only VfxSpellBrowserItem exposes IsPlayable. Unsupported/ambiguous/unavailable
                     spells stay visible like LTK, but cannot start an invalid preview. -->
                <DataTrigger Binding="{Binding IsPlayable}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VfxBrowserBranchStyle" TargetType="TreeViewItem" BasedOn="{StaticResource VfxBrowserItemStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxBrowserFolder}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#4DB6AC" Margin="8,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Children.Count, StringFormat='{}{0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,1,2,0" VerticalAlignment="Center"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:MapBrowserNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid Margin="2,5" ToolTip="{Binding Subtitle}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Kind="Map" Width="15" Height="15" Foreground="#38BDF8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Children.Count, StringFormat='{}{0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,1,2,0" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Click="MapBrowserEye_Click" Style="{StaticResource TransparentIconButton}"
                        Width="22" Height="22" Padding="0" Margin="2,0,0,0" ToolTip="Show / hide map item"
                        Visibility="{Binding CanHide, Converter={StaticResource BoolToVisibilityConverter}}">
                    <materialIcons:MaterialIcon Width="13" Height="13">
                        <materialIcons:MaterialIcon.Style>
                            <Style TargetType="materialIcons:MaterialIcon">
                                <Setter Property="Kind" Value="Eye"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Kind" Value="EyeOff"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialIcons:MaterialIcon.Style>
                    </materialIcons:MaterialIcon>
                </Button>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxSkinItem}" ItemsSource="{Binding Sections}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid Margin="2,5" ToolTip="{Binding DisplayName}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{StaticResource AccentOrange}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" MaxWidth="260">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxBrowserSection}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource VfxBrowserItemStyle}">
            <StackPanel Orientation="Horizontal" Margin="2,5">
                <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count, StringFormat='{}{0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:VfxSystemDiagnosticItem}">
            <StackPanel Orientation="Horizontal" Margin="2,4" ToolTip="{Binding Name}">
                <materialIcons:MaterialIcon Kind="ApplicationCogOutline" Width="14" Height="14" Foreground="#10B981" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="235" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:AnimationClipCatalogItem}">
            <StackPanel Orientation="Horizontal" Margin="2,4" ToolTip="{Binding TooltipSummary}">
                <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="225" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Duration, StringFormat='{}{0:F2}s'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:VfxSpellBrowserItem}">
            <StackPanel Orientation="Horizontal" Margin="2,4" ToolTip="{Binding ObjectPath}">
                <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="14" Height="14" Foreground="#A78BFA" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="205" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding AvailabilityText}" FontSize="9" Foreground="#A78BFA" Margin="8,1,0,0"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="TimelineLaneRowStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Background" Value="#07000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#122D6DF6"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#182D6DF6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSolo}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimelineTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Toolbar / ROOT Selector -->
            <RowDefinition Height="*"/>    <!-- 1: Main Management Area -->
        </Grid.RowDefinitions>

        <!-- 0. TOP TOOLBAR: Extracted asset folder -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title / Metadata -->
                    <ColumnDefinition Width="*"/>    <!-- Tools Capsule -->
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="VFX STUDIO" Style="{StaticResource ToolSectionLabel}" Margin="0,0,0,2"/>
                    <TextBlock Text="Browse maps, skins, effects and animations" FontSize="10" Foreground="{StaticResource TextPrimary}" Opacity="0.8"/>
                </StackPanel>

                <!-- Right: asset folder selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="6" Padding="10,4"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- ROOT Path Group -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Folder:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="RootPathTextBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="11" Width="220"
                                         VerticalAlignment="Center" KeyDown="RootPathTextBox_KeyDown"/>
                                <Button Click="BrowseRoot_Click"
                                        Style="{StaticResource BrowseButtonStyle}" Width="32" Height="32" Padding="0" Margin="6,0,0,0" ToolTip="Browse ROOT Directory">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. MAIN MANAGEMENT WORKSPACE -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/> <!-- Left: Systems List -->
                <ColumnDefinition Width="8"/>   <!-- Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Right: 3D Viewport & Systems Breakdown -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: VFX Systems List -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="10" 
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Systems ListView -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Click="ExitStudio_Click"
                                Style="{StaticResource TransparentIconButton}"
                                Width="24" Height="24"
                                Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="Exit VFX Studio">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15"/>
                        </Button>
                        <materialIcons:MaterialIcon Grid.Column="1" Kind="LayersOutline" Width="14" Height="14"
                                                    Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="ASSETS" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Grid.Column="3" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="PROJECT"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        </Border>
                    </Grid>

                    <!-- Search Filter (visible for both modes) -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardSearchBoxStyle}"
                             Tag="Search assets..."
                             Height="30"
                             Margin="0,0,0,8"
                             TextChanged="SearchQuery_TextChanged"/>

                    <TreeView x:Name="VfxBrowser" Grid.Row="2" ItemsSource="{Binding BrowserRoots}"
                              Style="{StaticResource ModernTreeView}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}"
                              SelectedItemChanged="VfxBrowser_SelectedItemChanged" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT PANEL: 3D Viewport & Independent Timeline Deck (Split Vertically) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220"/> <!-- 3D Viewport Card -->
                    <RowDefinition Height="6"/>                  <!-- Resize Splitter -->
                    <RowDefinition Height="2*" MinHeight="170"/> <!-- Timeline Deck Card -->
                </Grid.RowDefinitions>

                <!-- 1. 3D REAL-TIME VIEWPORT CARD (Edge-to-Edge) -->
                <Grid Grid.Row="0">
                    <!-- Base background with rounded corners -->
                    <Border Background="#0A0A0E" CornerRadius="10"/>

                    <!-- Viewport surface clipped cleanly to rounded geometry -->
                    <Grid x:Name="ViewportClipGrid" SizeChanged="ViewportClipGrid_SizeChanged">
                        <glWpfControl:GLWpfControl x:Name="OpenTkControl" 
                                             Ready="OpenTkControl_Ready" 
                                             Render="OpenTkControl_Render"/>

                        <!-- Selected-emitter authoring. Text edits preview immediately; Save BIN commits atomically. -->
                        <Border x:Name="EmitterAuthoringPanel"
                                VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12"
                                Width="360" Padding="10,8" Panel.ZIndex="20"
                                Background="#E612131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding HasSelectedEmitter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="14" Height="14"
                                                                    Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding SelectedEmitter.Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="210"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#142D6DF6" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="LIVE AUTHORING" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="TRANSFORM OVERRIDES" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="X" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Y" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Z" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="Translate" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="EmitterTranslationXTextBox" Grid.Row="1" Grid.Column="1" Margin="2"
                                             Style="{StaticResource ModernTextBox}" Height="25" Padding="5,0" FontSize="10" FontFamily="Consolas"
                                             TextChanged="EmitterTransform_TextChanged" KeyDown="EmitterTransform_KeyDown"/>
                                    <TextBox x:Name="EmitterTranslationYTextBox" Grid.Row="1" Grid.Column="2" Margin="2"
                                             Style="{StaticResource ModernTextBox}" Height="25" Padding="5,0" FontSize="10" FontFamily="Consolas"
                                             TextChanged="EmitterTransform_TextChanged" KeyDown="EmitterTransform_KeyDown"/>
                                    <TextBox x:Name="EmitterTranslationZTextBox" Grid.Row="1" Grid.Column="3" Margin="2"
                                             Style="{StaticResource ModernTextBox}" Height="25" Padding="5,0" FontSize="10" FontFamily="Consolas"
                                             TextChanged="EmitterTransform_TextChanged" KeyDown="EmitterTransform_KeyDown"/>

                                    <TextBlock Grid.Row="2" Text="Rotate°" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="EmitterRotationXTextBox" Grid.Row="2" Grid.Column="1" Margin="2"
                                             Style="{StaticResource ModernTextBox}" Height="25" Padding="5,0" FontSize="10" FontFamily="Consolas"
                                             TextChanged="EmitterTransform_TextChanged" KeyDown="EmitterTransform_KeyDown"/>
                                    <TextBox x:Name="EmitterRotationYTextBox" Grid.Row="2" Grid.Column="2" Margin="2"
                                             Style="{StaticResource ModernTextBox}" Height="25" Padding="5,0" FontSize="10" FontFamily="Consolas"
                                             TextChanged="EmitterTransform_TextChanged" KeyDown="EmitterTransform_KeyDown"/>
                                    <TextBox x:Name="EmitterRotationZTextBox" Grid.Row="2" Grid.Column="3" Margin="2"
                                             Style="{StaticResource ModernTextBox}" Height="25" Padding="5,0" FontSize="10" FontFamily="Consolas"
                                             TextChanged="EmitterTransform_TextChanged" KeyDown="EmitterTransform_KeyDown"/>
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="ApplyEmitterTransforms_Click" Style="{StaticResource SmallTextButtonStyle}"
                                            Padding="8,3" ToolTip="Persist the previewed overrides to the source BIN">
                                        <StackPanel Orientation="Horizontal">
                                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="Save BIN" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="EmitterAuthoringStatusText" Grid.Column="1" Margin="8,0,0,0"
                                               Text="Edit values to preview · Enter saves · Esc reverts"
                                               FontSize="9.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderColor}" Opacity="0.55" Margin="0,8,0,7"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FORCES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EmitterForceSummaryText" Grid.Column="1" FontSize="9" FontFamily="Consolas"
                                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <WrapPanel Margin="0,5,0,0">
                                    <Button Tag="Acceleration" Click="AddEmitterForce_Click" Style="{StaticResource SmallTextButtonStyle}" Margin="0,0,4,4" Padding="6,2" Content="+ Accel"/>
                                    <Button Tag="Attraction" Click="AddEmitterForce_Click" Style="{StaticResource SmallTextButtonStyle}" Margin="0,0,4,4" Padding="6,2" Content="+ Attract"/>
                                    <Button Tag="Noise" Click="AddEmitterForce_Click" Style="{StaticResource SmallTextButtonStyle}" Margin="0,0,4,4" Padding="6,2" Content="+ Noise"/>
                                    <Button Tag="Drag" Click="AddEmitterForce_Click" Style="{StaticResource SmallTextButtonStyle}" Margin="0,0,4,4" Padding="6,2" Content="+ Drag"/>
                                    <Button Tag="Orbital" Click="AddEmitterForce_Click" Style="{StaticResource SmallTextButtonStyle}" Margin="0,0,4,4" Padding="6,2" Content="+ Orbital"/>
                                </WrapPanel>

                                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,2,0,0">
                                    <ItemsControl ItemsSource="{Binding ForceAuthoringItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                                        CornerRadius="5" Background="#08000000" Margin="0,0,0,5" Padding="6,4">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Click="RemoveEmitterForce_Click"
                                                                    Style="{StaticResource TransparentIconButton}" Width="20" Height="20"
                                                                    Padding="0" ToolTip="Remove force">
                                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12"
                                                                                            Foreground="{StaticResource TextMuted}"/>
                                                            </Button>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Properties}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="88"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" FontSize="9.5"
                                                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>

                                                                        <TextBox Grid.Column="1" Text="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Height="24" Padding="5,0"
                                                                                 FontSize="9.5" FontFamily="Consolas"
                                                                                 KeyDown="ForceValue_KeyDown">
                                                                            <TextBox.Style>
                                                                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsScalar}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBox.Style>
                                                                        </TextBox>

                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsVector}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <TextBox Text="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Style="{StaticResource ModernTextBox}" Width="62" Height="24" Margin="0,0,3,0"
                                                                                     Padding="4,0" FontSize="9.5" FontFamily="Consolas"
                                                                                     KeyDown="ForceValue_KeyDown"/>
                                                                            <TextBox Text="{Binding YText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Style="{StaticResource ModernTextBox}" Width="62" Height="24" Margin="0,0,3,0"
                                                                                     Padding="4,0" FontSize="9.5" FontFamily="Consolas"
                                                                                     KeyDown="ForceValue_KeyDown"/>
                                                                            <TextBox Text="{Binding ZText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Style="{StaticResource ModernTextBox}" Width="62" Height="24"
                                                                                     Padding="4,0" FontSize="9.5" FontFamily="Consolas"
                                                                                     KeyDown="ForceValue_KeyDown"/>
                                                                        </StackPanel>

                                                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                                  Click="ForceBool_Click"
                                                                                  VerticalAlignment="Center">
                                                                            <CheckBox.Style>
                                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </CheckBox.Style>
                                                                        </CheckBox>

                                                                        <TextBlock Grid.Column="2" Text="CURVE" FontSize="8" FontWeight="Bold"
                                                                                   Foreground="{StaticResource AccentBrush}" Margin="5,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Height="1" Background="{StaticResource BorderColor}" Opacity="0.55" Margin="0,7,0,7"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CURVES" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CurveAuthoringItems}"
                                              SelectedItem="{Binding SelectedCurveAuthoringItem, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Style="{StaticResource ModernComboBox}"
                                              Height="25" FontSize="9.5"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedCurveAuthoringItem.StateText}"
                                               FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" Margin="7,0,0,0"/>
                                </Grid>

                                <Grid DataContext="{Binding SelectedCurveAuthoringItem}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FieldName}" FontSize="8.5" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Click="ActivateCurve_Click"
                                                Style="{StaticResource SmallTextButtonStyle}" Padding="7,2"
                                                Content="Activate curve"
                                                Visibility="{Binding CanActivate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ListBox ItemsSource="{Binding Keys}"
                                                 SelectedItem="{Binding DataContext.SelectedCurveKeyAuthoringItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                 MaxHeight="112" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,1"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayIndex, StringFormat='#{0}'}" FontSize="8.5"
                                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource ModernTextBox}" Height="23" Margin="0,0,3,0"
                                                                 Padding="4,0" FontSize="9" FontFamily="Consolas"
                                                                 ToolTip="Key time" KeyDown="CurveKey_KeyDown"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <TextBox Text="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ModernTextBox}" Width="43" Height="23" Margin="0,0,2,0"
                                                                     Padding="3,0" FontSize="9" FontFamily="Consolas" ToolTip="X / value"
                                                                     KeyDown="CurveKey_KeyDown"/>
                                                            <TextBox Text="{Binding YText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="43" Height="23" Margin="0,0,2,0" Padding="3,0"
                                                                     FontSize="9" FontFamily="Consolas" ToolTip="Y" KeyDown="CurveKey_KeyDown">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasY}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBox Text="{Binding ZText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="43" Height="23" Margin="0,0,2,0" Padding="3,0"
                                                                     FontSize="9" FontFamily="Consolas" ToolTip="Z" KeyDown="CurveKey_KeyDown">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasZ}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBox Text="{Binding WText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="43" Height="23" Padding="3,0"
                                                                     FontSize="9" FontFamily="Consolas" ToolTip="W / alpha" KeyDown="CurveKey_KeyDown">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasW}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Click="RemoveCurveKey_Click"
                                                                Style="{StaticResource TransparentIconButton}" Width="20" Height="22"
                                                                Padding="0" Margin="3,0,0,0" ToolTip="Remove key">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11"
                                                                                        Foreground="{StaticResource TextMuted}"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Click="AddCurveKey_Click" Style="{StaticResource SmallTextButtonStyle}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0" Padding="7,2" Content="+ Key"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HUD Overlay in Viewport (Top-Left: System & Live Particles) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="AutoAwesome" Width="15" Height="15" Foreground="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewportSelectionTitle}" FontWeight="Bold" FontSize="11.5" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                <Border Width="1" Height="14" Background="{StaticResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewportSelectionDetail}" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                        </Border>

                        <!-- Viewport Quick Toolbar (Top-Right: preview, rig, mesh and camera controls) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="4,3">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,6,0"
                                            Visibility="{Binding HasMultipleMapVariants, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="VARIANT:" Foreground="{StaticResource TextMuted}" FontSize="9.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding MapVariants}"
                                              SelectedItem="{Binding SelectedMapVariant, Mode=TwoWay}"
                                              DisplayMemberPath="Label" Style="{StaticResource ModernComboBox}"
                                              Width="112" Height="24" FontSize="9.5"/>
                                </StackPanel>

                                <Button x:Name="MapLayersButton"
                                        Click="MapLayers_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="MAP visibility layers"
                                        Visibility="{Binding HasMapLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13"
                                                                    Foreground="#38BDF8" Margin="0,0,5,0"/>
                                        <TextBlock Text="Layers" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding ActiveMapLayerCount, StringFormat=' {0}'}" FontSize="10"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="MapLayersPopup"
                                       PlacementTarget="{Binding ElementName=MapLayersButton}"
                                       Placement="Bottom" HorizontalOffset="-55" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True"
                                       DataContext="{Binding DataContext, ElementName=MapLayersButton}">
                                    <Border Width="205" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.42"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="MAP LAYERS" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}" Margin="2,0,0,7"/>
                                            <ItemsControl ItemsSource="{Binding MapLayers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Click="MapLayerCheckBox_Click"
                                                                  Margin="0,2,0,2">
                                                            <Grid Width="165">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="10.5"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding TriangleText}"
                                                                           FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                                                           FontFamily="Consolas" Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button x:Name="MapSunButton"
                                        Click="MapSun_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="MAP sun override"
                                        Visibility="{Binding HasMapPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="13" Height="13"
                                                                    Foreground="#FFD166" Margin="0,0,5,0"/>
                                        <TextBlock Text="Sun" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="MapSunPopup"
                                       PlacementTarget="{Binding ElementName=MapSunButton}"
                                       Placement="Bottom" HorizontalOffset="-120" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
                                    <Border Width="310" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="11">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.42"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="SUN OVERRIDE" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Button Content="Reset" HorizontalAlignment="Right" Padding="7,2"
                                                        Style="{StaticResource TransparentIconButton}" Click="MapSunReset_Click"/>
                                            </Grid>
                                            <TextBlock Text="Azimuth" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                            <Slider x:Name="MapSunAzimuthSlider" Minimum="-180" Maximum="180" TickFrequency="1"
                                                    Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                            <TextBlock Text="Elevation" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                            <Slider x:Name="MapSunElevationSlider" Minimum="0" Maximum="89" TickFrequency="1"
                                                    Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Sun strength" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                                    <Slider x:Name="MapSunStrengthSlider" Minimum="0" Maximum="2" TickFrequency="0.01"
                                                            Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Ambient" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                                    <Slider x:Name="MapSunAmbientSlider" Minimum="0" Maximum="2" TickFrequency="0.01"
                                                            Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Sun color" FontSize="9.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="MapSunColorTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                         Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas"
                                                         TextChanged="MapSunColor_TextChanged"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Sky color" FontSize="9.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="MapSunSkyColorTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                         Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas"
                                                         TextChanged="MapSunColor_TextChanged"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Ground" FontSize="9.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="MapSunGroundColorTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                         Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas"
                                                         TextChanged="MapSunColor_TextChanged"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button x:Name="MapPostButton"
                                        Click="MapPost_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="MAP post effects override"
                                        Visibility="{Binding HasMapPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ImageFilterVintage" Width="13" Height="13"
                                                                    Foreground="#A78BFA" Margin="0,0,5,0"/>
                                        <TextBlock Text="Post" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="MapPostPopup"
                                       PlacementTarget="{Binding ElementName=MapPostButton}"
                                       Placement="Bottom" HorizontalOffset="-220" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
                                    <Border Width="390" MaxHeight="620" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="11">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.42"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,0,5,0">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="POST EFFECTS" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    <Button Content="Reset" HorizontalAlignment="Right" Padding="7,2"
                                                            Style="{StaticResource TransparentIconButton}" Click="MapPostReset_Click"/>
                                                </Grid>

                                                <TextBlock Text="AMBIENT OCCLUSION" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                                <CheckBox x:Name="MapSsaoEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,4,0,4" Click="MapSsaoControl_Changed"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Quality" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <ComboBox x:Name="MapSsaoQualityCombo" Style="{StaticResource ModernComboBox}" Height="24"
                                                                  SelectionChanged="MapSsaoControl_Changed">
                                                            <ComboBoxItem Content="4 samples"/>
                                                            <ComboBoxItem Content="8 samples"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Radius" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <Slider x:Name="MapSsaoRadiusSlider" Minimum="0" Maximum="200" TickFrequency="1"
                                                                Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Power" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <Slider x:Name="MapSsaoPowerSlider" Minimum="0" Maximum="30" TickFrequency="0.5"
                                                                Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Intensity" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <Slider x:Name="MapSsaoIntensitySlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                                                                Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Bias" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <Slider x:Name="MapSsaoBiasSlider" Minimum="0" Maximum="20" TickFrequency="0.5"
                                                                Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Buffer scale" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <Slider x:Name="MapSsaoBufferScaleSlider" Minimum="0.25" Maximum="1" TickFrequency="0.05"
                                                                Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox x:Name="MapSsaoEdgeAwareCheck" Content="Edge-aware blur" Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,4,0,7" Click="MapSsaoControl_Changed"/>

                                                <Separator Margin="0,2,0,7"/>
                                                <TextBlock Text="DEPTH FOG" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <CheckBox x:Name="MapDepthFogEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,4,0,4" Click="MapPostControl_Changed"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Color" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="MapDepthFogColorTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                             Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapPostControl_Changed"/>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Start" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapDepthFogStartSlider" Minimum="0" Maximum="20000" TickFrequency="50" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="End" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapDepthFogEndSlider" Minimum="0" Maximum="20000" TickFrequency="50" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="Max" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapDepthFogMaxSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                </Grid>

                                                <Separator Margin="0,7,0,7"/>
                                                <TextBlock Text="HEIGHT FOG" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <CheckBox x:Name="MapHeightFogEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,4,0,4" Click="MapPostControl_Changed"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Color" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="MapHeightFogColorTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                             Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapPostControl_Changed"/>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Start" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapHeightFogStartSlider" Minimum="-1000" Maximum="1500" TickFrequency="10" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="End" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapHeightFogEndSlider" Minimum="-1000" Maximum="1500" TickFrequency="10" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="Max" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapHeightFogMaxSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                </Grid>

                                                <Separator Margin="0,7,0,7"/>
                                                <TextBlock Text="DEPTH OF FIELD" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <CheckBox x:Name="MapDofEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,4,0,4" Click="MapPostControl_Changed"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Focal" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapDofFocalSlider" Minimum="0" Maximum="10000" TickFrequency="50" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Focus width" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapDofWidthSlider" Minimum="0" Maximum="5000" TickFrequency="25" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="CoC" FontSize="9" Foreground="{StaticResource TextMuted}"/><Slider x:Name="MapDofCocSlider" Minimum="0" Maximum="30" TickFrequency="0.5" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/></StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>

                                <!-- Preview display controls mirror the VFX reference viewer. -->
                                <Button x:Name="PreviewShowButton"
                                        Click="PreviewShow_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="Preview display options">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Show" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding PreviewDisplayCount, StringFormat=' {0}'}" FontSize="10"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="PreviewShowPopup"
                                       PlacementTarget="{Binding ElementName=PreviewShowButton}"
                                       Placement="Bottom" HorizontalOffset="-70" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                       DataContext="{Binding DataContext, ElementName=PreviewShowButton}">
                                    <Border Width="190" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.42"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="SHOW" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}" Margin="2,0,0,7"/>
                                            <CheckBox Content="Grid" Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ShowPreviewGrid, Mode=TwoWay}"/>
                                            <CheckBox Content="Ground" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                      IsChecked="{Binding ShowPreviewGround, Mode=TwoWay}"/>
                                            <CheckBox Content="Stage" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                      IsChecked="{Binding ShowPreviewStage, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <ToggleButton x:Name="PreviewShadersToggle"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Height="26" Width="30" Margin="0,0,4,0"
                                              ToolTip="Use game shaders for Lit meshes"
                                              IsChecked="{Binding PreviewShaders, Mode=TwoWay}">
                                    <materialIcons:MaterialIcon Kind="PaletteOutline" Width="13" Height="13"/>
                                </ToggleButton>

                                <Button x:Name="PreviewViewModeButton"
                                        Click="PreviewViewMode_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="Preview view mode">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CubeOutline" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding PreviewViewModeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="PreviewViewModePopup"
                                       PlacementTarget="{Binding ElementName=PreviewViewModeButton}"
                                       Placement="Bottom" HorizontalOffset="-58" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                       DataContext="{Binding DataContext, ElementName=PreviewViewModeButton}">
                                    <Border Width="190" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="7">
                                        <StackPanel>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Lit"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewLit, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Unshaded"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewUnshaded, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Untextured"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewUntextured, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Wireframe"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewWireframe, Mode=TwoWay}"/>
                                            <Separator Margin="0,6,0,5"/>
                                            <CheckBox Content="Wire overlay"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding PreviewWireOverlay, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanPreviewWireOverlay}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button x:Name="PreviewCameraButton"
                                        Click="PreviewCamera_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="Preview camera preset">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="VideoOutline" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding PreviewCameraText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                    Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="PreviewCameraPopup"
                                       PlacementTarget="{Binding ElementName=PreviewCameraButton}"
                                       Placement="Bottom" HorizontalOffset="-48" VerticalOffset="6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                       DataContext="{Binding DataContext, ElementName=PreviewCameraButton}">
                                    <Border Width="160" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="7">
                                        <StackPanel>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Game"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraGame, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Orbit"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraOrbit, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Top"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraTop, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Front"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraFront, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Side"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraSide, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Simulation Rig Motion Preset (LTK-Manager style: Still, Burst, Missile, Trail) -->
                                <Button Click="RigPreset_Click" Style="{StaticResource TransparentIconButton}"
                                        Height="26" Padding="6,0" Margin="0,0,4,0"
                                        Visibility="{Binding HasStandaloneSystem, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Standalone system motion">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="{Binding RigPresetIcon}" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RigPresetText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#FF161822" BorderBrush="{StaticResource BorderColor}" Foreground="White"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Still — Stationary, once" Tag="Still" Click="SetRigPreset_Click" StaysOpenOnClick="True">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="14" Height="14" Foreground="{StaticResource TextSecondary}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Burst — Stationary, loop" Tag="Burst" Click="SetRigPreset_Click" StaysOpenOnClick="True">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Sparkles" Width="14" Foreground="{StaticResource AccentGreen}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Missile — Moving path" Tag="Missile" Click="SetRigPreset_Click" StaysOpenOnClick="True">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Trail — Orbiting path" Tag="Trail" Click="SetRigPreset_Click" StaysOpenOnClick="True">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{StaticResource AccentPurple}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <Separator/>

                                            <MenuItem StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <StackPanel Width="250" Margin="2">
                                                        <Grid Margin="0,0,0,3">
                                                            <TextBlock Text="Height" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                            <TextBlock x:Name="RigHeightValueText" Text="100 u" HorizontalAlignment="Right"
                                                                       FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                                        </Grid>
                                                        <Slider x:Name="RigHeightSlider" Minimum="0" Maximum="600" TickFrequency="10"
                                                                IsSnapToTickEnabled="True" Value="100" Style="{StaticResource HUDSliderStyle}"
                                                                ValueChanged="RigHeightSlider_ValueChanged"/>

                                                        <StackPanel x:Name="RigDistancePanel" Margin="0,7,0,0">
                                                            <Grid Margin="0,0,0,3">
                                                                <TextBlock Text="Distance" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock x:Name="RigDistanceValueText" Text="1200 u" HorizontalAlignment="Right"
                                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                                            </Grid>
                                                            <Slider x:Name="RigDistanceSlider" Minimum="200" Maximum="4000" TickFrequency="50"
                                                                    IsSnapToTickEnabled="True" Value="1200" Style="{StaticResource HUDSliderStyle}"
                                                                    ValueChanged="RigDistanceSlider_ValueChanged"/>
                                                            <Grid Margin="0,5,0,3">
                                                                <TextBlock Text="Speed" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock x:Name="RigSpeedValueText" Text="1600 u/s" HorizontalAlignment="Right"
                                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                                            </Grid>
                                                            <Slider x:Name="RigSpeedSlider" Minimum="100" Maximum="5000" TickFrequency="50"
                                                                    IsSnapToTickEnabled="True" Value="1600" Style="{StaticResource HUDSliderStyle}"
                                                                    ValueChanged="RigSpeedSlider_ValueChanged"/>
                                                        </StackPanel>

                                                        <StackPanel x:Name="RigOrbitPanel" Margin="0,7,0,0">
                                                            <Grid Margin="0,0,0,3">
                                                                <TextBlock Text="Radius" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock x:Name="RigRadiusValueText" Text="300 u" HorizontalAlignment="Right"
                                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                                            </Grid>
                                                            <Slider x:Name="RigRadiusSlider" Minimum="50" Maximum="1600" TickFrequency="25"
                                                                    IsSnapToTickEnabled="True" Value="300" Style="{StaticResource HUDSliderStyle}"
                                                                    ValueChanged="RigRadiusSlider_ValueChanged"/>
                                                            <Grid Margin="0,5,0,3">
                                                                <TextBlock Text="Period" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock x:Name="RigPeriodValueText" Text="3.00 s" HorizontalAlignment="Right"
                                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                                            </Grid>
                                                            <Slider x:Name="RigPeriodSlider" Minimum="0.25" Maximum="12" TickFrequency="0.25"
                                                                    IsSnapToTickEnabled="True" Value="3" Style="{StaticResource HUDSliderStyle}"
                                                                    ValueChanged="RigPeriodSlider_ValueChanged"/>
                                                        </StackPanel>

                                                        <Grid Margin="0,9,0,0">
                                                            <TextBlock Text="Seed" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                            <Button HorizontalAlignment="Right" Click="RerollSeed_Click"
                                                                    Style="{StaticResource SmallTextButtonStyle}"
                                                                    ToolTip="Generate another deterministic VFX variation">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialIcons:MaterialIcon Kind="DiceMultipleOutline" Width="13" Height="13"
                                                                                                Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{Binding PlaybackSeed}" FontSize="10" FontFamily="Consolas"
                                                                               Foreground="{StaticResource TextSecondary}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Champion Mesh Toggle -->
                                <ToggleButton IsChecked="{Binding ShowChampionMesh, Mode=TwoWay}" 
                                              Style="{StaticResource TransparentIconToggleButton}" 
                                              Width="28" Height="26" Margin="0,0,4,0" 
                                              ToolTip="Toggle Champion 3D Model Mesh (when available)" 
                                              Visibility="{Binding HasChampionMesh, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="15" Height="15"/>
                                </ToggleButton>

                                <!-- Reset the active camera preset after free orbit, pan, or zoom. -->
                                <Button Click="ResetCamera_Click"
                                        Style="{StaticResource TransparentIconButton}"
                                        Width="28" Height="26" Margin="0,0,4,0"
                                        ToolTip="Reset Camera (F)">
                                    <materialIcons:MaterialIcon Kind="Restore" Width="15" Height="15"/>
                                </Button>

                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rounded Border Stroke Overlay (crisp 1px outline, unclipped, hit-test transparent) -->
                    <Border CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" IsHitTestVisible="False"/>
                </Grid>

                <!-- SPLITTER (Seamless Viewport vs Timeline height adjust) -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                              Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>

                <!-- 2. TIMELINE & TRANSPORT DECK (Independent Card outside Viewport, LTK-Manager / DAW Studio Style) -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,8">
                    <Grid>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 1. Top Transport Controls & Search Bar -->
                            <RowDefinition Height="Auto"/> <!-- 2. Separator -->
                            <RowDefinition Height="Auto"/> <!-- 3. Time Ruler Header (Aligned with Tracks) -->
                            <RowDefinition Height="*"/>    <!-- 4. Scrollable Emitter Lanes & Interactive Tracks Grid -->
                        </Grid.RowDefinitions>

                        <!-- 1. TOP TRANSPORT CONTROLS & SEARCH BAR (LTK-Manager layout) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Left: Badge & Filter Search -->
                                <ColumnDefinition Width="*"/>    <!-- Middle spacer -->
                                <ColumnDefinition Width="Auto"/> <!-- Right: Transport Buttons, Time, Speed, Loop, BG -->
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Slider to preserve two-way time binding & event hooks -->
                            <Slider x:Name="TimeSlider" Visibility="Collapsed" Minimum="0" Maximum="{Binding TotalDuration}" 
                                    Value="{Binding CurrentTime, Mode=TwoWay}" ValueChanged="TimeSlider_ValueChanged"
                                    PreviewMouseDown="TimeSlider_PreviewMouseDown" PreviewMouseUp="TimeSlider_PreviewMouseUp"/>

                            <!-- LEFT: TIMELINE IDENTITY + FILTER -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="TIMELINE" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emitters.Count}" FontSize="9.5" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                </StackPanel>

                                <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        CornerRadius="5" Height="28" Width="170" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FilterVariant" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="EmitterFilterTextBox"
                                                 Text="{Binding EmitterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="EmitterFilter_TextChanged"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="White"
                                                 FontSize="11" VerticalContentAlignment="Center" Padding="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="Filter emitters" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Click="ClearEmitterFilter_Click" Style="{StaticResource TransparentIconButton}"
                                                Width="20" Height="20" Margin="0,0,2,0" ToolTip="Clear Filter"
                                                Visibility="{Binding HasEmitterFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT: TRANSPORT ACTION BUTTONS, TIME READOUT, SPEED, LOOP, BG -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Step Back Button (|<) -->
                                <Button Click="StepBack_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Step Back (-1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18"/>
                                </Button>

                                <!-- Dynamic Play / Pause / Replay Button -->
                                <Button Click="PlayPauseToggle_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Play / Pause / Replay">
                                    <materialIcons:MaterialIcon Width="18" Height="18">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="Play"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Kind" Value="Pause"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                                            <Condition Binding="{Binding IsReplayState}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Kind" Value="Replay"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <!-- Step Forward Button (>|) -->
                                <Button Click="StepForward_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,8,0" ToolTip="Step Forward (+1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18"/>
                                </Button>

                                <!-- Time Readout -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas">
                                        <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat={}{0:F2}}" Foreground="{StaticResource TextPrimary}"/>
                                        <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding TotalDuration, Mode=OneWay, StringFormat={}{0:F2}s}" Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding ActiveLoopDurationText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Width="1" Height="18" Background="{StaticResource BorderColor}" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.6"/>

                                <!-- Parametric AnimationGraph clips choose one authored mValue at a time. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Visibility="{Binding HasAnimationParameters, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="PARAM:" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" Width="72" Height="26"
                                              ItemsSource="{Binding AnimationParameterValues}"
                                              SelectedItem="{Binding AnimationParameter, Mode=TwoWay}"
                                              ItemStringFormat="{}{0:0.###}"/>
                                </StackPanel>

                                <!-- Speed Control -->
                                <materialIcons:MaterialIcon Kind="Speedometer" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SpeedComboBox" Style="{StaticResource ModernComboBox}" Width="76" Height="26" SelectionChanged="Speed_SelectionChanged" SelectedIndex="4" Margin="0,0,8,0">
                                    <ComboBoxItem Content="0.05x" Tag="0.05"/>
                                    <ComboBoxItem Content="0.1x" Tag="0.1"/>
                                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                </ComboBox>
                                <!-- One timeline loop control is shared by Systems, Clips, and Spells. -->
                                <ToggleButton x:Name="TimelineLoopToggleButton"
                                              Click="TimelineLoopToggleButton_Click"
                                              IsChecked="{Binding IsPreviewLoopEnabled, Mode=TwoWay}"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Width="30" Height="28" Padding="0"
                                              Margin="0,0,8,0" ToolTip="Loop preview and edit timeline range">
                                    <materialIcons:MaterialIcon Kind="RepeatVariant" Width="17" Height="17"/>
                                </ToggleButton>

                                <!-- BG Mode Selector -->
                                <TextBlock Text="BG:" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BgComboBox" Style="{StaticResource ModernComboBox}" Width="80" Height="26" SelectionChanged="BgMode_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Alpha"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 2. SUBTLE SEPARATOR -->
                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,2,0,6" Opacity="0.45"/>

                        <!-- 3. TIME RULER HEADER (Aligned with lanes) -->
                        <Grid Grid.Row="2" Margin="0,0,0,2" Height="26" Background="#08000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/> <!-- Name & Solo/Mute Header Column -->
                                <ColumnDefinition Width="*"/>   <!-- Time Ruler Ticks & Loop Indicator -->
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/> <!-- Global visibility -->
                                    <ColumnDefinition Width="*"/>  <!-- Label -->
                                    <ColumnDefinition Width="24"/> <!-- Global solo -->
                                </Grid.ColumnDefinitions>

                                <!-- Global visibility: applies to the complete VFX graph. -->
                                <Button Grid.Column="0" Click="ToggleMuteAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Show / Hide All Emitters">
                                    <materialIcons:MaterialIcon Width="13" Height="13">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="EyeOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllMuted}" Value="True">
                                                        <Setter Property="Kind" Value="EyeOffOutline"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="EMITTERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <!-- Global solo: mirrors the per-emitter S controls. -->
                                <Button Grid.Column="2" Click="ToggleSoloAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Solo / Unsolo All Emitters">
                                    <TextBlock Text="S" FontSize="9.5" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnySolo}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <!-- Ruler Ticks & Live Caption Header -->
                            <Grid Grid.Column="1" Margin="8,0,0,0" Cursor="Hand"
                                  PreviewMouseDown="Ruler_PreviewMouseDown"
                                  PreviewMouseMove="Ruler_PreviewMouseMove"
                                  PreviewMouseUp="Ruler_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/> <!-- Live Count Column Header -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="2" Width="1" Height="10" Background="#38FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="3" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="0" Text="0.00s" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding QuarterDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding HalfDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>
                        </Grid>

                        <!-- 4. TIMELINE TRACKS (Scrollable Emitters Lanes + Sweeping Needles) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                            <Grid x:Name="TimelineInteractiveGrid" Background="Transparent" 
                                  PreviewMouseDown="TimelineGrid_PreviewMouseDown" 
                                  PreviewMouseMove="TimelineGrid_PreviewMouseMove" 
                                  PreviewMouseUp="TimelineGrid_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/> <!-- Names, Thumbnails, Toggles & Solos Column -->
                                    <ColumnDefinition Width="*"/>   <!-- Tracks Canvas Column -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Emitters List -->
                                <StackPanel Grid.Column="0">
                                    <!-- Emitter Rows -->
                                    <ItemsControl ItemsSource="{Binding Emitters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TimelineLaneRowStyle}"
                                                        MouseLeftButtonDown="EmitterLane_MouseLeftButtonDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/> <!-- Mute (Eye) -->
                                                            <ColumnDefinition Width="22"/> <!-- Thumbnail Image/Icon -->
                                                            <ColumnDefinition Width="*"/>  <!-- Emitter Name -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Index [16] -->
                                                            <ColumnDefinition Width="24"/> <!-- Solo ('S') -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mute Button (Eye) -->
                                                        <Button Grid.Column="0" Click="EmitterMute_Click" Style="{StaticResource TransparentIconButton}" 
                                                                Width="20" Height="20" Padding="0" ToolTip="Mute (Hide) this emitter" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Width="13" Height="13">
                                                                <materialIcons:MaterialIcon.Style>
                                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                                        <Setter Property="Kind" Value="EyeOutline"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                <Setter Property="Kind" Value="EyeOffOutline"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialIcons:MaterialIcon.Style>
                                                            </materialIcons:MaterialIcon>
                                                        </Button>

                                                        <!-- Thumbnail Swatch (Image preview if loaded, else primitive icon) -->
                                                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="2" 
                                                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                                                Background="#10FFFFFF" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding ImagePreview}" Width="16" Height="16" Stretch="UniformToFill" 
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <materialIcons:MaterialIcon Kind="TextureBox" Width="11" Height="11" Foreground="{StaticResource TextMuted}"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon.Style>
                                                                        <Style TargetType="materialIcons:MaterialIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialIcons:MaterialIcon.Style>
                                                                </materialIcons:MaterialIcon>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Emitter Name -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" 
                                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" 
                                                                   ToolTip="{Binding Name}" Margin="4,0,2,0"/>

                                                        <!-- Index Number [16] -->
                                                        <TextBlock Grid.Column="3" Text="{Binding IndexNumber, StringFormat='[{0}]'}" FontSize="9.5" FontFamily="Consolas" 
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Solo Button ('S') -->
                                                        <Button Grid.Column="4" Click="EmitterSolo_Click" Width="20" Height="20" Padding="0" ToolTip="Solo this emitter" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="S" FontSize="10" FontWeight="Black">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right Column: Emitter Tracks Bars + Sweeping Needles -->
                                <Grid Grid.Column="1" Margin="8,0,0,0" x:Name="TracksCanvasContainer" SizeChanged="TracksCanvasContainer_SizeChanged" ClipToBounds="True"
                                      Background="#05000000">
                                    <!-- Temporal grid: quarter marks remain visible behind every lane. -->
                                    <Grid IsHitTestVisible="False" Panel.ZIndex="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="2" Width="1" Background="#20FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="3" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="4" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <StackPanel Panel.ZIndex="1">
                                        <!-- Emitter Bars Stack -->
                                        <ItemsControl ItemsSource="{Binding Emitters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TimelineLaneRowStyle}">
                                                        <Grid>
                                                            <!-- Authored emitter interval -->
                                                            <Border Background="{Binding TrackBrush}" BorderBrush="{Binding TrackBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="3" Height="16" VerticalAlignment="Center"
                                                                    Margin="{Binding TrackMargin}" HorizontalAlignment="Left" Width="{Binding TrackWidth}">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.22"/>
                                                                </Border.Effect>
                                                                <Border BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" CornerRadius="3"/>
                                                            </Border>

                                                            <!-- Emission trigger marker -->
                                                            <Ellipse Width="7" Height="7" Fill="#FBBF24" Stroke="#111827" StrokeThickness="1"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                     Margin="{Binding DelayMarkerMargin}"
                                                                     Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                     ToolTip="{Binding DelayTime, StringFormat='Emission Trigger: {0:F2}s'}">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect Color="#FBBF24" BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>

                                                            <!-- Live Particle Count -->
                                                            <Border Width="34" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                    Background="#0D000000" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding ActiveParticleCount}" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Playhead Needle Overlay Canvas -->
                                    <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False" Panel.ZIndex="10">
                                        <Line x:Name="PlayheadLine" X1="0" Y1="6" X2="0" Y2="800"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0.95"/>
                                        <Path x:Name="PlayheadHandle" Data="M 0,0 L 10,0 L 5,6 Z"
                                              Canvas.Top="0" Fill="{StaticResource AccentBrush}">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="5" ShadowDepth="0" Opacity="0.75"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>

                                    <!-- Active System Loop Boundary Needle Overlay Canvas -->
                                    <Canvas x:Name="LoopBoundaryCanvas" Panel.ZIndex="100">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoopEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Border x:Name="LoopRangeBand" Canvas.Top="0" Height="800" Width="0"
                                                Background="#10FFD700" IsHitTestVisible="False"/>
                                        <Line x:Name="LoopStartLine" X1="0" Y1="0" X2="0" Y2="800"
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Line x:Name="LoopBoundaryLine" X1="0" Y1="0" X2="0" Y2="800" 
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Ellipse x:Name="LoopStartHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE"
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5"
                                                 PreviewMouseDown="LoopStartHandle_PreviewMouseDown"
                                                 PreviewMouseMove="LoopStartHandle_PreviewMouseMove"
                                                 PreviewMouseUp="LoopStartHandle_PreviewMouseUp"
                                                 ToolTip="Drag to adjust preview loop start">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="LoopBoundaryHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE" 
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5" 
                                                 PreviewMouseDown="LoopBoundaryHandle_PreviewMouseDown" 
                                                 PreviewMouseMove="LoopBoundaryHandle_PreviewMouseMove" 
                                                 PreviewMouseUp="LoopBoundaryHandle_PreviewMouseUp" 
                                                 ToolTip="Drag to adjust preview loop end">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
