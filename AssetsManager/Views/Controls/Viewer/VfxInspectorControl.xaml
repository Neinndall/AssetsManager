<UserControl x:Class="AssetsManager.Views.Controls.Viewer.VfxInspectorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AssetsManager.Views.Models.Viewer"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource SidebarBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="VfxBrowserItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="IsExpanded" Value="False"/>
            <EventSetter Event="Expanded" Handler="BrowserItem_Expanded"/>
        </Style>
        <Style x:Key="VfxBrowserBranchStyle" TargetType="TreeViewItem" BasedOn="{StaticResource VfxBrowserItemStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxSkinItem}" ItemsSource="{Binding Sections}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid Margin="2,5" ToolTip="{Binding DisplayName}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{StaticResource AccentOrange}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" MaxWidth="260">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxBrowserSection}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource VfxBrowserItemStyle}">
            <StackPanel Orientation="Horizontal" Margin="2,5">
                <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count, StringFormat='{}{0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:VfxSystemDiagnosticItem}">
            <StackPanel Orientation="Horizontal" Margin="2,4" ToolTip="{Binding Name}">
                <materialIcons:MaterialIcon Kind="ApplicationCogOutline" Width="14" Height="14" Foreground="#10B981" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="235" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:AnimationClipCatalogItem}">
            <StackPanel Orientation="Horizontal" Margin="2,4" ToolTip="{Binding VfxSummary}">
                <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="225" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Duration, StringFormat='{}{0:F2}s'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="TimelineLaneRowStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Background" Value="#07000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#122D6DF6"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSolo}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimelineTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Toolbar / ROOT Selector -->
            <RowDefinition Height="*"/>    <!-- 1: Main Management Area -->
        </Grid.RowDefinitions>

        <!-- 0. TOP TOOLBAR: Extracted asset folder -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title / Metadata -->
                    <ColumnDefinition Width="*"/>    <!-- Tools Capsule -->
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="VFX STUDIO" Style="{StaticResource ToolSectionLabel}" Margin="0,0,0,2"/>
                    <TextBlock Text="Browse skins, effects and animations" FontSize="10" Foreground="{StaticResource TextPrimary}" Opacity="0.8"/>
                </StackPanel>

                <!-- Right: asset folder selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="6" Padding="10,4"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- ROOT Path Group -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Folder:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="RootPathTextBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="11" Width="220"
                                         VerticalAlignment="Center" KeyDown="RootPathTextBox_KeyDown"/>
                                <Button Click="BrowseRoot_Click"
                                        Style="{StaticResource BrowseButtonStyle}" Width="32" Height="32" Padding="0" Margin="6,0,0,0" ToolTip="Browse ROOT Directory">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. MAIN MANAGEMENT WORKSPACE -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/> <!-- Left: Systems List -->
                <ColumnDefinition Width="8"/>   <!-- Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Right: 3D Viewport & Systems Breakdown -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: VFX Systems List -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" CornerRadius="10" 
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Systems ListView -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Click="ExitStudio_Click"
                                Style="{StaticResource TransparentIconButton}"
                                Width="24" Height="24"
                                Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="Exit VFX Studio">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15"/>
                        </Button>
                        <materialIcons:MaterialIcon Grid.Column="1" Kind="LayersOutline" Width="14" Height="14"
                                                    Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="ASSETS" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Grid.Column="3" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DetectedSkins.Count, StringFormat='{}{0} BINs'}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        </Border>
                    </Grid>

                    <!-- Search Filter (visible for both modes) -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardSearchBoxStyle}"
                             Tag="Search assets..."
                             Height="30"
                             Margin="0,0,0,8"
                             TextChanged="SearchQuery_TextChanged"/>

                    <TreeView x:Name="VfxBrowser" Grid.Row="2" ItemsSource="{Binding DetectedSkins}"
                              Style="{StaticResource ModernTreeView}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}"
                              SelectedItemChanged="VfxBrowser_SelectedItemChanged" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT PANEL: 3D Viewport & Independent Timeline Deck (Split Vertically) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220"/> <!-- 3D Viewport Card -->
                    <RowDefinition Height="6"/>                  <!-- Resize Splitter -->
                    <RowDefinition Height="2*" MinHeight="170"/> <!-- Timeline Deck Card -->
                </Grid.RowDefinitions>

                <!-- 1. 3D REAL-TIME VIEWPORT CARD (Edge-to-Edge) -->
                <Grid Grid.Row="0">
                    <!-- Base background with rounded corners -->
                    <Border Background="#0A0A0E" CornerRadius="10"/>

                    <!-- Viewport surface clipped cleanly to rounded geometry -->
                    <Grid x:Name="ViewportClipGrid" SizeChanged="ViewportClipGrid_SizeChanged">
                        <glWpfControl:GLWpfControl x:Name="OpenTkControl" 
                                             Ready="OpenTkControl_Ready" 
                                             Render="OpenTkControl_Render"/>

                        <!-- HUD Overlay in Viewport (Top-Left: System & Live Particles) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="AutoAwesome" Width="15" Height="15" Foreground="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedSystem.Name, FallbackValue='No system selected'}" FontWeight="Bold" FontSize="11.5" Foreground="White" VerticalAlignment="Center"/>
                                <Border Width="1" Height="14" Background="{StaticResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="Grain" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LiveParticleCount, StringFormat='{}Particles: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Viewport Quick Toolbar (Top-Right: Champion Mesh Toggle & Reset Camera) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="4,3">
                            <StackPanel Orientation="Horizontal">
                                <!-- Simulation Rig Motion Preset (LTK-Manager style: Still, Burst, Missile, Trail) -->
                                <Button Click="RigPreset_Click" Style="{StaticResource TransparentIconButton}" 
                                        Height="26" Padding="6,0" Margin="0,0,4,0" 
                                        ToolTip="VFX Simulation Rig Motion (Still / Burst / Missile / Trail)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="{Binding RigPresetIcon}" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RigPresetText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#FF161822" BorderBrush="{StaticResource BorderColor}" Foreground="White">
                                            <MenuItem Header="Still (Stationary single run)" Tag="Still" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="14" Height="14" Foreground="{StaticResource TextSecondary}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Burst (Stationary loop)" Tag="Burst" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Sparkles" Width="14" Foreground="{StaticResource AccentGreen}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Missile (Flight projectile path)" Tag="Missile" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Trail (Orbit circuit path)" Tag="Trail" Click="SetRigPreset_Click">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{StaticResource AccentPurple}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Champion Mesh Toggle -->
                                <ToggleButton IsChecked="{Binding ShowChampionMesh, Mode=TwoWay}" 
                                              Style="{StaticResource TransparentIconToggleButton}" 
                                              Width="28" Height="26" Margin="0,0,4,0" 
                                              ToolTip="Toggle Champion 3D Model Mesh (when available)" 
                                              Visibility="{Binding HasChampionMesh, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="15" Height="15"/>
                                </ToggleButton>

                                <!-- Reset Camera / Focus (F) -->
                                <Button Click="ResetCamera_Click" Style="{StaticResource TransparentIconButton}" 
                                            Width="28" Height="26" ToolTip="Reset Camera View (F)">
                                    <materialIcons:MaterialIcon Kind="CameraRetakeOutline" Width="15" Height="15" Foreground="{StaticResource TextSecondary}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rounded Border Stroke Overlay (crisp 1px outline, unclipped, hit-test transparent) -->
                    <Border CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" IsHitTestVisible="False"/>
                </Grid>

                <!-- SPLITTER (Seamless Viewport vs Timeline height adjust) -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                              Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>

                <!-- 2. TIMELINE & TRANSPORT DECK (Independent Card outside Viewport, LTK-Manager / DAW Studio Style) -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 1. Top Transport Controls & Search Bar -->
                            <RowDefinition Height="Auto"/> <!-- 2. Separator -->
                            <RowDefinition Height="Auto"/> <!-- 3. Time Ruler Header (Aligned with Tracks) -->
                            <RowDefinition Height="*"/>    <!-- 4. Scrollable Emitter Lanes & Interactive Tracks Grid -->
                        </Grid.RowDefinitions>

                        <!-- 1. TOP TRANSPORT CONTROLS & SEARCH BAR (LTK-Manager layout) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Left: Badge & Filter Search -->
                                <ColumnDefinition Width="*"/>    <!-- Middle spacer -->
                                <ColumnDefinition Width="Auto"/> <!-- Right: Transport Buttons, Time, Speed, Loop, BG -->
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Slider to preserve two-way time binding & event hooks -->
                            <Slider x:Name="TimeSlider" Visibility="Collapsed" Minimum="0" Maximum="{Binding TotalDuration}" 
                                    Value="{Binding CurrentTime, Mode=TwoWay}" ValueChanged="TimeSlider_ValueChanged"
                                    PreviewMouseDown="TimeSlider_PreviewMouseDown" PreviewMouseUp="TimeSlider_PreviewMouseUp"/>

                            <!-- LEFT: TIMELINE IDENTITY + FILTER -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="TIMELINE" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emitters.Count}" FontSize="9.5" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                </StackPanel>

                                <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        CornerRadius="5" Height="28" Width="170" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FilterVariant" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="EmitterFilterTextBox"
                                                 Text="{Binding EmitterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="EmitterFilter_TextChanged"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="White"
                                                 FontSize="11" VerticalContentAlignment="Center" Padding="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="Filter emitters" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Click="ClearEmitterFilter_Click" Style="{StaticResource TransparentIconButton}"
                                                Width="20" Height="20" Margin="0,0,2,0" ToolTip="Clear Filter"
                                                Visibility="{Binding HasEmitterFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT: TRANSPORT ACTION BUTTONS, TIME READOUT, SPEED, LOOP, BG -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Step Back Button (|<) -->
                                <Button Click="StepBack_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Step Back / Rewind to 0.00s">
                                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18"/>
                                </Button>

                                <!-- Dynamic Play / Pause / Replay Button -->
                                <Button Click="PlayPauseToggle_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Play / Pause / Replay">
                                    <materialIcons:MaterialIcon Width="18" Height="18">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="Play"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Kind" Value="Pause"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                                            <Condition Binding="{Binding IsReplayState}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Kind" Value="Replay"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <!-- Step Forward Button (>|) -->
                                <Button Click="StepForward_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,8,0" ToolTip="Step Forward (+1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18"/>
                                </Button>

                                <!-- Time Readout -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas">
                                        <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat={}{0:F2}}" Foreground="{StaticResource TextPrimary}"/>
                                        <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding TotalDuration, Mode=OneWay, StringFormat={}{0:F2}s}" Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding ActiveLoopDurationText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Width="1" Height="18" Background="{StaticResource BorderColor}" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.6"/>

                                <!-- Speed Control -->
                                <materialIcons:MaterialIcon Kind="Speedometer" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SpeedComboBox" Style="{StaticResource ModernComboBox}" Width="76" Height="26" SelectionChanged="Speed_SelectionChanged" SelectedIndex="2" Margin="0,0,8,0">
                                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                </ComboBox>

                                <!-- Loop toggle: same visual language as the transport controls. -->
                                <ToggleButton IsChecked="{Binding IsPreviewLoopEnabled, Mode=TwoWay}"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Width="30" Height="28" Padding="0"
                                              Margin="0,0,8,0" ToolTip="Toggle Loop Boundary">
                                    <materialIcons:MaterialIcon Kind="RepeatVariant" Width="17" Height="17"/>
                                </ToggleButton>

                                <!-- BG Mode Selector -->
                                <TextBlock Text="BG:" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BgComboBox" Style="{StaticResource ModernComboBox}" Width="80" Height="26" SelectionChanged="BgMode_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Alpha"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 2. SUBTLE SEPARATOR -->
                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,2,0,6" Opacity="0.45"/>

                        <!-- 3. TIME RULER HEADER (Aligned with lanes) -->
                        <Grid Grid.Row="2" Margin="0,0,0,2" Height="26" Background="#08000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/> <!-- Name & Solo/Mute Header Column -->
                                <ColumnDefinition Width="*"/>   <!-- Time Ruler Ticks & Loop Indicator -->
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/> <!-- Global visibility -->
                                    <ColumnDefinition Width="*"/>  <!-- Label -->
                                    <ColumnDefinition Width="24"/> <!-- Global solo -->
                                </Grid.ColumnDefinitions>

                                <!-- Global visibility: applies to the complete VFX graph. -->
                                <Button Grid.Column="0" Click="ToggleMuteAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Show / Hide All Emitters">
                                    <materialIcons:MaterialIcon Width="13" Height="13">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="EyeOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllMuted}" Value="True">
                                                        <Setter Property="Kind" Value="EyeOffOutline"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="EMITTERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <!-- Global solo: mirrors the per-emitter S controls. -->
                                <Button Grid.Column="2" Click="ToggleSoloAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Solo / Unsolo All Emitters">
                                    <TextBlock Text="S" FontSize="9.5" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnySolo}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <!-- Ruler Ticks & Live Caption Header -->
                            <Grid Grid.Column="1" Margin="8,0,0,0" Cursor="Hand"
                                  PreviewMouseDown="Ruler_PreviewMouseDown"
                                  PreviewMouseMove="Ruler_PreviewMouseMove"
                                  PreviewMouseUp="Ruler_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/> <!-- Live Count Column Header -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="2" Width="1" Height="10" Background="#38FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="3" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="0" Text="0.00s" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding QuarterDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding HalfDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>
                        </Grid>

                        <!-- 4. TIMELINE TRACKS (Scrollable Emitters Lanes + Sweeping Needles) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                            <Grid x:Name="TimelineInteractiveGrid" Background="Transparent" 
                                  PreviewMouseDown="TimelineGrid_PreviewMouseDown" 
                                  PreviewMouseMove="TimelineGrid_PreviewMouseMove" 
                                  PreviewMouseUp="TimelineGrid_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/> <!-- Names, Thumbnails, Toggles & Solos Column -->
                                    <ColumnDefinition Width="*"/>   <!-- Tracks Canvas Column -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Emitters List -->
                                <StackPanel Grid.Column="0">
                                    <!-- Emitter Rows -->
                                    <ItemsControl ItemsSource="{Binding Emitters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TimelineLaneRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/> <!-- Mute (Eye) -->
                                                            <ColumnDefinition Width="22"/> <!-- Thumbnail Image/Icon -->
                                                            <ColumnDefinition Width="*"/>  <!-- Emitter Name -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Index [16] -->
                                                            <ColumnDefinition Width="24"/> <!-- Solo ('S') -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mute Button (Eye) -->
                                                        <Button Grid.Column="0" Click="EmitterMute_Click" Style="{StaticResource TransparentIconButton}" 
                                                                Width="20" Height="20" Padding="0" ToolTip="Mute (Hide) this emitter" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Width="13" Height="13">
                                                                <materialIcons:MaterialIcon.Style>
                                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                                        <Setter Property="Kind" Value="EyeOutline"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                <Setter Property="Kind" Value="EyeOffOutline"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialIcons:MaterialIcon.Style>
                                                            </materialIcons:MaterialIcon>
                                                        </Button>

                                                        <!-- Thumbnail Swatch (Image preview if loaded, else primitive icon) -->
                                                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="2" 
                                                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                                                Background="#10FFFFFF" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding ImagePreview}" Width="16" Height="16" Stretch="UniformToFill" 
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <materialIcons:MaterialIcon Kind="TextureBox" Width="11" Height="11" Foreground="{StaticResource TextMuted}"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon.Style>
                                                                        <Style TargetType="materialIcons:MaterialIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialIcons:MaterialIcon.Style>
                                                                </materialIcons:MaterialIcon>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Emitter Name -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" 
                                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" 
                                                                   ToolTip="{Binding Name}" Margin="4,0,2,0"/>

                                                        <!-- Index Number [16] -->
                                                        <TextBlock Grid.Column="3" Text="{Binding IndexNumber, StringFormat='[{0}]'}" FontSize="9.5" FontFamily="Consolas" 
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Solo Button ('S') -->
                                                        <Button Grid.Column="4" Click="EmitterSolo_Click" Width="20" Height="20" Padding="0" ToolTip="Solo this emitter" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="S" FontSize="10" FontWeight="Black">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right Column: Emitter Tracks Bars + Sweeping Needles -->
                                <Grid Grid.Column="1" Margin="8,0,0,0" x:Name="TracksCanvasContainer" SizeChanged="TracksCanvasContainer_SizeChanged" ClipToBounds="True"
                                      Background="#05000000">
                                    <!-- Temporal grid: quarter marks remain visible behind every lane. -->
                                    <Grid IsHitTestVisible="False" Panel.ZIndex="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="2" Width="1" Background="#20FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="3" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="4" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <StackPanel Panel.ZIndex="1">
                                        <!-- Emitter Bars Stack -->
                                        <ItemsControl ItemsSource="{Binding Emitters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TimelineLaneRowStyle}">
                                                        <Grid>
                                                            <!-- Authored emitter interval -->
                                                            <Border Background="{Binding TrackBrush}" BorderBrush="{Binding TrackBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="3" Height="16" VerticalAlignment="Center"
                                                                    Margin="{Binding TrackMargin}" HorizontalAlignment="Left" Width="{Binding TrackWidth}">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.22"/>
                                                                </Border.Effect>
                                                                <Border BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" CornerRadius="3"/>
                                                            </Border>

                                                            <!-- Emission trigger marker -->
                                                            <Ellipse Width="7" Height="7" Fill="#FBBF24" Stroke="#111827" StrokeThickness="1"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                     Margin="{Binding DelayMarkerMargin}"
                                                                     Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                     ToolTip="{Binding DelayTime, StringFormat='Emission Trigger: {0:F2}s'}">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect Color="#FBBF24" BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>

                                                            <!-- Live Particle Count -->
                                                            <Border Width="34" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                    Background="#0D000000" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding ActiveParticleCount}" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Playhead Needle Overlay Canvas -->
                                    <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False" Panel.ZIndex="10">
                                        <Line x:Name="PlayheadLine" X1="0" Y1="6" X2="0" Y2="800"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0.95"/>
                                        <Path x:Name="PlayheadHandle" Data="M 0,0 L 10,0 L 5,6 Z"
                                              Canvas.Top="0" Fill="{StaticResource AccentBrush}">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="5" ShadowDepth="0" Opacity="0.75"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>

                                    <!-- Active System Loop Boundary Needle Overlay Canvas -->
                                    <Canvas x:Name="LoopBoundaryCanvas" Panel.ZIndex="100">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoopEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Line x:Name="LoopBoundaryLine" X1="0" Y1="0" X2="0" Y2="800" 
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Ellipse x:Name="LoopBoundaryHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE" 
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5" 
                                                 PreviewMouseDown="LoopBoundaryHandle_PreviewMouseDown" 
                                                 PreviewMouseMove="LoopBoundaryHandle_PreviewMouseMove" 
                                                 PreviewMouseUp="LoopBoundaryHandle_PreviewMouseUp" 
                                                 ToolTip="Drag to adjust preview loop boundary">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
