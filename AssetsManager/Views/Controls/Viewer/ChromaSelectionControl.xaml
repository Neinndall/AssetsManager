<UserControl x:Class="AssetsManager.Views.Controls.Viewer.ChromaSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="ChromaFamilyItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="BackgroundLayer"
                                    Background="{StaticResource CardBackground}"
                                    CornerRadius="10"/>
                            <ContentPresenter Margin="12,10"/>
                            <Border x:Name="SelectionBorder"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="AccentStrip"
                                    Width="2"
                                    Height="28"
                                    Margin="-1,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="1"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BackgroundLayer" Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="AccentStrip" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChromaFamilyTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="44"
                        Height="44"
                        CornerRadius="9"
                        Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PreviewImage}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border Width="12"
                                Height="12"
                                Margin="0,0,-3,-3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1.5">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SwatchColor}"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="10,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding ModelName}"
                               Margin="0,2,0,0"
                               FontSize="9"
                               Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ModelName}"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="7,4"
                        VerticalAlignment="Center"
                        Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Text="{Binding ChromaCount}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChromaCardTemplate">
            <Border x:Name="CardRoot"
                    Width="148"
                    Height="180"
                    Margin="7"
                    Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonDown="ChromaCard_MouseLeftButtonDown">
                <Grid SnapsToDevicePixels="True">
                    <Border x:Name="CardBackground"
                            Background="{StaticResource CardBackground}"
                            CornerRadius="12"/>

                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="9"
                                Background="{StaticResource SidebarBackground}">
                            <Grid>
                                <Border CornerRadius="9">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border Width="24"
                                        Height="24"
                                        Margin="0,0,-4,-4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="12"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="2">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SwatchColor}"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.45"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Margin="0,9,0,1"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding PreviewTextureName}"
                                       MaxWidth="120"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PreviewTextureName}"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CardBorder"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="False"/>

                    <Border x:Name="SelectedBadge"
                            Width="24"
                            Height="24"
                            Margin="0,7,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource CardBackground}"
                            CornerRadius="12"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <materialIcons:MaterialIcon Kind="CheckCircle"
                                                    Width="19"
                                                    Height="19"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>
                </Grid>

            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardBackground" Property="Background" Value="{StaticResource HoverColor}"/>
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CardBackground" Property="Background" Value="{StaticResource HoverColor}"/>
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                    <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="28,16"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44"
                            Height="44"
                            Margin="0,0,14,0"
                            Background="{StaticResource SidebarBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <materialIcons:MaterialIcon Kind="PaletteSwatchOutline"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CHROMA LIBRARY"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18,18,14,18"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="4,0,4,12">
                        <TextBlock Text="SOURCE SKINS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="Choose the model family"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <ListBox x:Name="FamilyListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding AvailableFamilies}"
                             SelectedItem="{Binding SelectedFamily, Mode=OneWay}"
                             SelectionChanged="FamilyListBox_SelectionChanged"
                             ItemTemplate="{StaticResource ChromaFamilyTemplate}"
                             ItemContainerStyle="{StaticResource ChromaFamilyItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource SidebarBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="24,15"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{StaticResource SidebarBackground}"
                                    CornerRadius="9">
                                <materialIcons:MaterialIcon Kind="SourceBranch"
                                                            Width="20"
                                                            Height="20"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedFamily.Name}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="  CHROMAS"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMuted}">
                                    <Run Text="{Binding SelectedFamily.ModelName, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SelectedFamily.ChromaCountText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="SelectFamilyButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CheckAll"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"/>
                                    <TextBlock Text="SELECT FAMILY"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="ClearFamilyButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Eraser"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"/>
                                    <TextBlock Text="CLEAR"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedFamily.Chromas}"
                                  ItemTemplate="{StaticResource ChromaCardTemplate}"
                                  Margin="13"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                          SpacingMode="Uniform"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CubeOutline"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,9,0"
                                                Foreground="{StaticResource AccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectionText}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Selected chromas will be loaded as separate scene models"
                                   Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Height="34"
                            Padding="16,0"
                            Margin="0,0,10,0"
                            Click="CloseButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Close"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,7,0"/>
                            <TextBlock Text="CANCEL" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}"
                            Height="34"
                            Padding="18,0"
                            IsEnabled="{Binding HasSelection}"
                            Click="LoadSelectedButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="PlayCircle"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="LOAD SELECTED" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="{StaticResource SidebarBackground}"
                Opacity="0.94"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="64"
                        Height="64"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <materialIcons:MaterialIcon Kind="Sync"
                                                Width="32"
                                                Height="32"
                                                Foreground="{StaticResource AccentBrush}"
                                                Style="{StaticResource SpinningIconStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ANALYZING CHROMA FAMILIES..."
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Linking inherited models and texture variants"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
