<UserControl x:Class="AssetsManager.Views.Controls.Viewer.BrowseProjectControl" x:Name="BrowserRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:explorer="clr-namespace:AssetsManager.Views.Controls.Explorer"
             xmlns:shared="clr-namespace:AssetsManager.Views.Controls.Shared"
             xmlns:viewer="clr-namespace:AssetsManager.Views.Controls.Viewer"
             xmlns:models="clr-namespace:AssetsManager.Views.Models.Viewer">
    <UserControl.Resources>
        <Style x:Key="ProjectFolderStyle" TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <EventSetter Event="Expanded" Handler="Folder_Expanded"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:ProjectBrowserFolder}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ProjectFolderStyle}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                <icons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{StaticResource AccentOrange}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate x:Key="ProjectFileTemplate">
            <Grid Width="104" Height="102" Margin="3" ToolTip="{Binding FullPath}">
                <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="6"/>
                <StackPanel Margin="6,5">
                    <Grid Height="64">
                        <icons:MaterialIcon Kind="{Binding IconKind}" Foreground="{Binding IconColor}" Width="36" Height="36"
                                            Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="82" Height="62"
                               Loaded="Thumbnail_Loaded" IsVisibleChanged="Thumbnail_IsVisibleChanged"
                               Visibility="{Binding IsThumbnailEnabled, RelativeSource={RelativeSource AncestorType={x:Type viewer:BrowseProjectControl}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="10.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center" MaxHeight="28" LineHeight="14" Margin="0,3,0,0" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverSurface" Property="Background" Value="{StaticResource HoverColor}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverSurface" Property="Background" Value="{StaticResource HoverColor}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Border Background="{StaticResource CardBackground}"/>
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="PROJECTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Click="ChangeProject_Click" Style="{StaticResource TransparentIconButton}" Width="26" Height="26" Padding="0" ToolTip="Choose project folder"
                            Visibility="{Binding IsStandalone, ElementName=BrowserRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <icons:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14"/>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsThumbnailEnabled, ElementName=BrowserRoot, Mode=TwoWay}" Style="{StaticResource TransparentIconToggleButton}" Width="26" Height="26" Padding="0" ToolTip="Texture thumbnails">
                        <icons:MaterialIcon Kind="ImageOutline" Width="14" Height="14"/>
                    </ToggleButton>
                    <Button Click="Reveal_Click" Style="{StaticResource TransparentIconButton}" Width="26" Height="26" Padding="0" ToolTip="Show in Explorer">
                        <icons:MaterialIcon Kind="OpenInNew" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Click="Up_Click" Style="{StaticResource TransparentIconButton}" Width="26" Height="26" Padding="0" Margin="0,0,10,0" ToolTip="Parent folder">
                        <icons:MaterialIcon Kind="ArrowUp" Width="14" Height="14"/>
                    </Button>
                    <explorer:BreadcrumbControl x:Name="Breadcrumbs" Grid.Column="1" FontSize="10" ItemClicked="Breadcrumbs_ItemClicked"/>
                </Grid>
                <shared:SearchBoxControl x:Name="SearchBox" Grid.Column="2" Height="26" Tag="Search project files..." SearchTextChanged="Search_TextChanged"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Click="OpenStudio_Click" Style="{StaticResource TransparentIconButton}" Width="26" Height="26" Padding="0" ToolTip="Open project in 3D Studio"
                            Visibility="{Binding IsStandalone, ElementName=BrowserRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <icons:MaterialIcon Kind="CubeOutline" Width="14" Height="14"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource TransparentIconButton}" Width="26" Height="26" Padding="0" ToolTip="Close project browser">
                        <icons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" MinWidth="120"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="8,6,4,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="FOLDERS" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="2,0,0,5"/>
                <TreeView x:Name="FoldersTree" Grid.Row="1" Style="{StaticResource ModernTreeView}" ItemContainerStyle="{StaticResource ProjectFolderStyle}"
                          SelectedItemChanged="Folders_SelectedItemChanged"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
            <Grid Grid.Column="2" Margin="6,2,6,0">
                <ListBox x:Name="FilesList" Style="{StaticResource ModernFileGridListBox}" ItemTemplate="{StaticResource ProjectFileTemplate}"
                         SelectionChanged="Files_SelectionChanged"/>
                <TextBlock x:Name="EmptyMessage" Text="Open a project to browse its files." Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" Margin="12"/>
            </Grid>
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>
            <Border x:Name="PreviewPanel" Grid.Column="4" Width="240" MinWidth="160" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Padding="12,8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="ImageOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="TEXTURE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="ClosePreview_Click" Style="{StaticResource TransparentIconButton}" Width="22" Height="22" Padding="0" ToolTip="Close preview">
                            <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="SelectionLabel" Grid.Row="1" FontSize="11" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Image x:Name="PreviewImage" Grid.Row="2" Stretch="Uniform"/>
                    <TextBlock x:Name="PreviewMessage" Grid.Row="2" Text="Select a texture to preview it." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="SummaryText" Grid.Row="2" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="12,4,12,6"/>
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,1,0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
