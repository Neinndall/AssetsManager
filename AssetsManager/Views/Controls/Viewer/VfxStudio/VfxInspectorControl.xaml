<UserControl x:Class="AssetsManager.Views.Controls.Viewer.VfxInspectorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:viewerControls="clr-namespace:AssetsManager.Views.Controls.Viewer"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AssetsManager.Views.Models.Viewer"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource SidebarBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Compact TreeView Expander ToggleButton for VFX Studio Browser -->
        <Style x:Key="TreeViewToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="14" Height="14">
                            <materialIcons:MaterialIcon Style="{StaticResource AnimatedChevronStyle}" Width="10" Height="10"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VfxBrowserItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Padding" Value="2,1"/>
            <EventSetter Event="Expanded" Handler="BrowserItem_Expanded"/>
            <Style.Triggers>
                <!-- Only VfxSpellBrowserItem exposes IsPlayable. Unsupported/ambiguous/unavailable
                     spells stay visible like LTK, but cannot start an invalid preview. -->
                <DataTrigger Binding="{Binding IsPlayable}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VfxBrowserBranchStyle" TargetType="TreeViewItem" BasedOn="{StaticResource VfxBrowserItemStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxBrowserFolder}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid Margin="1,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Kind="FolderOutline" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="#154DB6AC" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Subtitle}" FontSize="9" FontWeight="SemiBold" Foreground="#4DB6AC"/>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Subtitle}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <Border Grid.Column="2" Background="#0CFFFFFF" CornerRadius="4" Padding="5,1" Margin="6,0,2,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Children.Count}" FontSize="8.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:MapBrowserNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid Margin="1,2" ToolTip="{Binding Subtitle}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon.Style>
                        <Style TargetType="materialIcons:MaterialIcon">
                            <Setter Property="Kind" Value="Map"/>
                            <Setter Property="Foreground" Value="#38BDF8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Map">
                                    <Setter Property="Kind" Value="Map"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Geometry">
                                    <Setter Property="Kind" Value="VectorPolygon"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Materials">
                                    <Setter Property="Kind" Value="PaletteOutline"/>
                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Material">
                                    <Setter Property="Kind" Value="CircleSlice8"/>
                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Chunks">
                                    <Setter Property="Kind" Value="LayersOutline"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Chunk">
                                    <Setter Property="Kind" Value="PackageVariantClosed"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Placeable">
                                    <Setter Property="Kind" Value="CubeOutline"/>
                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Characters">
                                    <Setter Property="Kind" Value="AccountGroupOutline"/>
                                    <Setter Property="Foreground" Value="#EC4899"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="CharacterSkin">
                                    <Setter Property="Kind" Value="AccountOutline"/>
                                    <Setter Property="Foreground" Value="#EC4899"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="CharacterPlacement">
                                    <Setter Property="Kind" Value="MapMarkerOutline"/>
                                    <Setter Property="Foreground" Value="#EC4899"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Clips">
                                    <Setter Property="Kind" Value="MoviePlayOutline"/>
                                    <Setter Property="Foreground" Value="#F43F5E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Clip">
                                    <Setter Property="Kind" Value="PlayOutline"/>
                                    <Setter Property="Foreground" Value="#F43F5E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Particles">
                                    <Setter Property="Kind" Value="AutoAwesome"/>
                                    <Setter Property="Foreground" Value="#A855F7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ParticleSystem">
                                    <Setter Property="Kind" Value="Creation"/>
                                    <Setter Property="Foreground" Value="#A855F7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ParticlePlacement">
                                    <Setter Property="Kind" Value="Sparkles"/>
                                    <Setter Property="Foreground" Value="#A855F7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialIcons:MaterialIcon.Style>
                </materialIcons:MaterialIcon>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="130" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#0CFFFFFF" CornerRadius="4" Padding="5,1" Margin="6,0,2,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Children.Count}" FontSize="8.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <Button Grid.Column="3" Click="MapBrowserEye_Click" PreviewMouseLeftButtonDown="MapBrowserEye_PreviewMouseLeftButtonDown"
                        Style="{StaticResource TransparentIconButton}"
                        Width="18" Height="18" Padding="0" Margin="2,0,0,0" ToolTip="Show / hide map item"
                        Visibility="{Binding CanHide, Converter={StaticResource BoolToVisibilityConverter}}">
                    <materialIcons:MaterialIcon Width="11" Height="11">
                        <materialIcons:MaterialIcon.Style>
                            <Style TargetType="materialIcons:MaterialIcon">
                                <Setter Property="Kind" Value="Eye"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Kind" Value="EyeOff"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialIcons:MaterialIcon.Style>
                    </materialIcons:MaterialIcon>
                </Button>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxSkinItem}" ItemsSource="{Binding Sections}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}">
            <Grid x:Name="SkinRow" Margin="1,2" Background="Transparent" ToolTip="{Binding DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in New Tab" Click="OpenSkinInNewTab_Click">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="TabPlus"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add to Current Scene" Click="AddSkinToScene_Click">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="AccountMultiplePlusOutline"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="12.5" Height="12.5" Foreground="{StaticResource AccentOrange}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" MaxWidth="260" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="8.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <Button x:Name="AddToSceneButton" Grid.Column="2" Click="AddSkinToScene_Click"
                        Style="{StaticResource TransparentIconButton}" Width="20" Height="20" Padding="0" Margin="4,0,2,0"
                        VerticalAlignment="Center" Visibility="Hidden" ToolTip="Add to current scene">
                    <materialIcons:MaterialIcon Kind="AccountMultiplePlusOutline" Width="12" Height="12"/>
                </Button>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <Trigger SourceName="SkinRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="AddToSceneButton" Property="Visibility" Value="Visible"/>
                </Trigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:VfxBrowserSection}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource VfxBrowserItemStyle}">
            <Grid Margin="1,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#0CFFFFFF" CornerRadius="4" Padding="5,1" Margin="6,0,2,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Items.Count}" FontSize="8.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:VfxSystemDiagnosticItem}">
            <StackPanel Orientation="Horizontal" Margin="1,2" ToolTip="{Binding Name}">
                <materialIcons:MaterialIcon Kind="ApplicationCogOutline" Width="11" Height="11" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="10.5" MaxWidth="235" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:AnimationClipCatalogItem}">
            <StackPanel Orientation="Horizontal" Margin="1,2" ToolTip="{Binding TooltipSummary}">
                <materialIcons:MaterialIcon x:Name="ClipIcon" Kind="MotionPlayOutline" Width="11" Height="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="10.5" MaxWidth="225" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="DurationText" Text="{Binding Duration, StringFormat='{}{0:F2}s'}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBindPose}" Value="True">
                    <Setter TargetName="ClipIcon" Property="Kind" Value="HumanHandsup"/>
                    <Setter TargetName="ClipIcon" Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter TargetName="DurationText" Property="Text" Value="T-Pose"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:VfxSpellBrowserItem}">
            <StackPanel Orientation="Horizontal" Margin="1,2" ToolTip="{Binding ObjectPath}">
                <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="11" Height="11" Foreground="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="10.5" MaxWidth="205" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Background="#18A78BFA" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvailabilityText}" FontSize="8.5" FontWeight="SemiBold" Foreground="#A78BFA"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="TimelineLaneRowStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Background" Value="#07000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#122D6DF6"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#182D6DF6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSolo}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimelineTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Map state controls shared by the MAP workspace and the Character backdrop. -->
        <DataTemplate x:Key="MapStateControlsTemplate">
            <StackPanel>
                <StackPanel Visibility="{Binding HasMapTransformations, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="TRANSFORMATION" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <ComboBox ItemsSource="{Binding MapTransformations}" SelectedItem="{Binding SelectedMapTransformation, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource ModernComboBox}" Height="28" Margin="0,4,0,8"
                              ToolTip="Rift state: terrain, structures and VFX a transformation shows or removes"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasMapSecondaryStates, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="OBJECTIVE PIT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <ComboBox ItemsSource="{Binding MapSecondaryStates}" SelectedItem="{Binding SelectedMapSecondaryState, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource ModernComboBox}" Height="28" Margin="0,4,0,8"
                              ToolTip="Secondary map state read by pit controllers (Summoner's Rift: Baron pit)"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasMapMutators, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,6">
                    <TextBlock Text="DECORATIONS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding MapMutators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,2" ToolTip="{Binding Name}">
                                    <TextBlock Text="{Binding Label}" FontSize="9.5"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ToggleButton x:Name="MapLayerBitsToggle" IsChecked="False" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Padding="0" Margin="0,2,0,4"
                              Visibility="{Binding HasMapLayers, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LAYER BITS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding ActiveMapLayerCount, StringFormat=' · {0} active'}" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding MapLayers}" Visibility="{Binding IsChecked, ElementName=MapLayerBitsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="MapLayerCheckBox_Click" Margin="0,2">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="9.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TriangleText}" FontSize="8.5" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- VFX STUDIO WORKSPACE -->
        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Left: Project asset browser -->
                <ColumnDefinition Width="4"/>   <!-- Assets splitter -->
                <ColumnDefinition x:Name="CenterContentCol" Width="*"/>   <!-- Center: workspace tabs, viewport and timeline -->
                <ColumnDefinition x:Name="InspectorSplitterCol" Width="Auto"/> <!-- Inspector splitter; collapses with the panel -->
                <ColumnDefinition x:Name="InspectorCol" Width="Auto"/> <!-- Right: contextual Inspector -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: project browser, intentionally structural rather than a nested card -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid Margin="12,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Asset tree -->
                    </Grid.RowDefinitions>

                    <!-- Active project and contextual tools -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Background="{StaticResource CardBackground}"
                            CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"
                                                            Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" ToolTip="{Binding ProjectPath}" VerticalAlignment="Center" Margin="0,0,5,0">
                                <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding ProjectName}" FontSize="9" FontFamily="Consolas"
                                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding TimelineVisible, Mode=TwoWay}"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Width="24" Height="26" Padding="0" ToolTip="Show / Hide Timeline">
                                    <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding InspectorVisible, Mode=TwoWay}"
                                              Visibility="{Binding HasContextInspector, Converter={StaticResource BoolToVis}}"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Width="24" Height="26" Padding="0" ToolTip="Show / Hide Inspector">
                                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="14" Height="14"/>
                                </ToggleButton>
                                <Button Click="BrowseRoot_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="24" Height="26" Padding="0" ToolTip="Open project folder">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="14" Height="14"/>
                                </Button>
                                <Button Click="CloseProject_Click" Style="{StaticResource TransparentIconButton}"
                                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}"
                                        Width="24" Height="26" Padding="0" ToolTip="Close project (keeps files on disk)">
                                    <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                </Button>
                                <Button Click="ExitStudio_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="24" Height="26" Padding="0" ToolTip="Exit VFX Studio">
                                    <materialIcons:MaterialIcon Kind="ExitToApp" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search Filter (visible for both modes) -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardSearchBoxStyle}"
                             Tag="Search assets..."
                             Height="28"
                             Margin="0,0,0,8"
                             TextChanged="SearchQuery_TextChanged"/>

                    <Grid Grid.Row="2">
                        <TreeView x:Name="VfxBrowser" ItemsSource="{Binding BrowserRoots}" Margin="10,0,0,0"
                                  Style="{StaticResource ModernTreeView}" ItemContainerStyle="{StaticResource VfxBrowserBranchStyle}"
                                  SelectedItemChanged="VfxBrowser_SelectedItemChanged" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding BrowserRoots.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsProjectLoading}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="30" Height="30" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ProjectBrowserMessage}" Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <Grid Background="{StaticResource SidebarBackground}"
                              Visibility="{Binding IsProjectLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="30" Height="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Loading project..." Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="{Binding ProjectBrowserMessage}" Foreground="{StaticResource TextMuted}" FontSize="10"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,14"/>
                                <ProgressBar Width="120" Height="4" Style="{StaticResource ModernProgressBar}"
                                             IsIndeterminate="{Binding IsProjectLoading}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT PANEL: workspace tabs + 3D viewport + independent timeline deck -->
            <Grid Grid.Column="2" Margin="6,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>               <!-- Workspace tabs -->
                    <RowDefinition Height="3*" MinHeight="220"/> <!-- 3D Viewport Card -->
                    <RowDefinition x:Name="TimelineSplitterRow" Height="6"/> <!-- Resize Splitter -->
                    <RowDefinition x:Name="TimelineDeckRow" Height="170" MinHeight="170"/> <!-- Timeline Deck Card -->
                </Grid.RowDefinitions>

                <!-- Open Skin / MAP workspaces. Mirrors Explorer tab interaction without coupling to FileSystemNodeModel. -->
                <Border Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,1"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasWorkspaceTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="WorkspaceTabsScrollLeftButton" Grid.Column="0" Click="WorkspaceTabsScrollLeft_Click"
                                Style="{StaticResource TransparentIconButton}" Width="24" Height="28" Padding="0"
                                Visibility="Collapsed" ToolTip="Scroll tabs left">
                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14"/>
                        </Button>
                        <ScrollViewer x:Name="WorkspaceTabsScrollViewer" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      ScrollChanged="WorkspaceTabsScrollViewer_ScrollChanged">
                            <ItemsControl ItemsSource="{Binding WorkspaceTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:VfxWorkspaceTab}">
                                        <Border x:Name="WorkspaceTabBorder" Margin="2,0" MinHeight="30"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0,2,0,0"
                                                CornerRadius="4,4,0,0" MouseLeftButtonDown="WorkspaceTab_MouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" Margin="8,4,4,4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon x:Name="WorkspaceTabIcon" Kind="PaletteOutline" Width="14" Height="14"
                                                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Subtitle}"/>
                                                <Border Background="#15FFFFFF" CornerRadius="6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                        Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Characters in this scene"
                                                        Visibility="{Binding HasExtraActors, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ExtraActorCount, StringFormat='+{0}'}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                                <Button x:Name="WorkspaceTabCloseButton" Click="CloseWorkspaceTab_Click"
                                                        Margin="8,0,0,0" Visibility="Hidden"
                                                        Style="{StaticResource SmallCloseButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:VfxWorkspaceTabKind.Map}">
                                                <Setter TargetName="WorkspaceTabIcon" Property="Kind" Value="Map"/>
                                                <Setter TargetName="WorkspaceTabIcon" Property="Foreground" Value="#38BDF8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="WorkspaceTabBorder" Property="Background" Value="{StaticResource CardBackground}"/>
                                                <Setter TargetName="WorkspaceTabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="WorkspaceTabCloseButton" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="WorkspaceTabBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                                                <Setter TargetName="WorkspaceTabCloseButton" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button x:Name="WorkspaceTabsScrollRightButton" Grid.Column="2" Click="WorkspaceTabsScrollRight_Click"
                                Style="{StaticResource TransparentIconButton}" Width="24" Height="28" Padding="0"
                                Visibility="Collapsed" ToolTip="Scroll tabs right">
                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 1. 3D REAL-TIME VIEWPORT CARD (Edge-to-Edge) -->
                <Grid Grid.Row="1">
                    <!-- Base background with rounded corners -->
                    <Border Background="#0A0A0E" CornerRadius="10"/>

                    <!-- Viewport surface clipped cleanly to rounded geometry -->
                    <Grid x:Name="ViewportClipGrid" SizeChanged="ViewportClipGrid_SizeChanged">
                        <glWpfControl:GLWpfControl x:Name="OpenTkControl" 
                                             Ready="OpenTkControl_Ready" 
                                             Render="OpenTkControl_Render"/>

                        <!-- Shared input surface: the normal Viewer transform gizmo gets first chance to
                             consume axis drags; unhandled gestures continue to the camera controller. -->
                        <Border x:Name="CameraInputSurface" Background="Transparent" Panel.ZIndex="2"/>

                        <viewerControls:ViewportTransformGizmo x:Name="CharacterTransformGizmoCanvas" IsHitTestVisible="False" Panel.ZIndex="5"/>

                        <!-- Character/Skin armature and optional joint labels follow the same pose as the SKN. -->
                        <Canvas x:Name="CharacterArmatureCanvas"
                                Panel.ZIndex="6"
                                IsHitTestVisible="False"
                                ClipToBounds="True"/>

                        <!-- HUD Overlay in Viewport (Top-Left: System & Live Particles) -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" 
                                Background="#CC12131A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="AutoAwesome" Width="15" Height="15" Foreground="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewportSelectionTitle}" FontWeight="Bold" FontSize="11.5" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                <Border Width="1" Height="14" Background="{StaticResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ViewportSelectionDetail}" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                        </Border>

                        <!-- Bottom-center action toolbar. Matches the normal Viewer placement, acrylic background, and chrome. -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                                Panel.ZIndex="20"
                                Background="#E618181B" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                CornerRadius="18" Padding="6,4"
                                Visibility="{Binding ViewportToolbarVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Group 1: Character / Actor Gizmo & Framing (Skin workspace only) -->
                                <Border Background="#1AFFFFFF" CornerRadius="11" Padding="2,1" Margin="0,0,2,0"
                                        Visibility="{Binding IsSkinWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton IsChecked="{Binding CharacterTransformGizmoEnabled, Mode=TwoWay}"
                                                      Style="{StaticResource TransparentIconToggleButton}"
                                                      Width="30" Height="30"
                                                      ToolTip="Move Character in viewport">
                                            <materialIcons:MaterialIcon Kind="AxisArrow" Width="14" Height="14"/>
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding CharacterAutoRotate, Mode=TwoWay}"
                                                      Style="{StaticResource TransparentIconToggleButton}"
                                                      Width="30" Height="30" Margin="2,0,0,0"
                                                      ToolTip="Auto Rotate Character">
                                            <materialIcons:MaterialIcon Kind="Rotate3DVariant" Width="14" Height="14"/>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>

                                <Rectangle Width="1" Fill="#22FFFFFF" Margin="2,7" VerticalAlignment="Stretch"
                                           Visibility="{Binding IsSkinWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Group 2: Display & Camera Options (Dropdown menus and shaders) -->
                                <Border Background="#1AFFFFFF" CornerRadius="11" Padding="2,1" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Show dropdown -->
                                        <Button x:Name="PreviewShowButton"
                                                Click="PreviewShow_Click"
                                                Style="{StaticResource TransparentIconButton}"
                                                Height="30" Padding="8,0"
                                                ToolTip="Preview display options">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Eye" Width="14" Height="14"
                                                                            Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Show" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviewDisplayCount, StringFormat=' {0}'}" FontSize="10"
                                                           FontFamily="Consolas" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                            Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- View Mode dropdown -->
                                        <Button x:Name="PreviewViewModeButton"
                                                Click="PreviewViewMode_Click"
                                                Style="{StaticResource TransparentIconButton}"
                                                Height="30" Padding="8,0" Margin="2,0,0,0"
                                                ToolTip="Preview view mode">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CubeOutline" Width="13" Height="13"
                                                                            Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviewViewModeText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                            Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Camera Preset dropdown -->
                                        <Button x:Name="PreviewCameraButton"
                                                Click="PreviewCamera_Click"
                                                Style="{StaticResource TransparentIconButton}"
                                                Height="30" Padding="8,0" Margin="2,0,0,0"
                                                ToolTip="Preview camera preset">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="VideoOutline" Width="13" Height="13"
                                                                            Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviewCameraText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                            Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Standalone Simulation Rig Motion Preset -->
                                        <Button x:Name="RigPresetButton"
                                                Click="RigPreset_Click" 
                                                Style="{StaticResource TransparentIconButton}"
                                                Height="30" Padding="8,0,12,0" Margin="2,0,0,0"
                                                Visibility="{Binding HasStandaloneSystem, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTip="Standalone system motion">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="{Binding RigPresetIcon}" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RigPresetText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="RigPresetContextMenu"
                                                             Closed="RigPresetContextMenu_Closed"
                                                             Background="#FF161822" BorderBrush="{StaticResource BorderColor}" Foreground="White"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Still — Stationary, once" Tag="Still" Click="SetRigPreset_Click">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="14" Height="14" Foreground="{StaticResource TextSecondary}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Burst — Stationary, loop" Tag="Burst" Click="SetRigPreset_Click">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="Sparkles" Width="14" Foreground="{StaticResource AccentGreen}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Missile — Moving path" Tag="Missile" Click="SetRigPreset_Click">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Trail — Orbiting path" Tag="Trail" Click="SetRigPreset_Click">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{StaticResource AccentPurple}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>

                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Popups for display & camera options -->
                                <Popup x:Name="PreviewShowPopup"
                                       PlacementTarget="{Binding ElementName=PreviewShowButton}"
                                       Placement="Top" HorizontalOffset="-58" VerticalOffset="-6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                       Closed="PreviewShowPopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=PreviewShowButton}">
                                    <Border Width="190" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="2,0,0,6" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Eye" Width="12" Height="12"
                                                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="SHOW" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox Content="Ground" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                      IsChecked="{Binding ShowPreviewGround, Mode=TwoWay}"/>
                                            <CheckBox Content="Grid" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                      IsChecked="{Binding ShowPreviewGrid, Mode=TwoWay}"/>
                                            <CheckBox Content="Stage" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                      IsChecked="{Binding ShowPreviewStage, Mode=TwoWay}"/>
                                            <CheckBox Content="Sky" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                      IsChecked="{Binding ShowPreviewSky, Mode=TwoWay}"/>


                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="13" Height="13"
                                                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                                                            VerticalAlignment="Center"/>
                                                <TextBlock Text="BACKGROUND" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ComboBox x:Name="BgComboBox" Style="{StaticResource ModernComboBox}" Height="28"
                                                      SelectionChanged="BgMode_SelectionChanged" SelectedIndex="0"
                                                      ToolTip="Preview backdrop. Sky and scene surfaces draw over it.">
                                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                                                <ComboBoxItem Content="Light" Tag="Light"/>
                                                <ComboBoxItem Content="Alpha (checkerboard)" Tag="Alpha"/>
                                            </ComboBox>

                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Popup x:Name="PreviewViewModePopup"
                                       PlacementTarget="{Binding ElementName=PreviewViewModeButton}"
                                       Placement="Top" HorizontalOffset="-58" VerticalOffset="-6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                       Closed="PreviewViewModePopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=PreviewViewModeButton}">
                                    <Border Width="190" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="7">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Lit"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewLit, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Unshaded"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewUnshaded, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Untextured"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewUntextured, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewViewMode" Content="Wireframe"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewViewWireframe, Mode=TwoWay}"/>
                                            <Separator Margin="0,6,0,5"/>
                                            <CheckBox Content="Wire overlay"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding PreviewWireOverlay, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanPreviewWireOverlay}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Popup x:Name="PreviewCameraPopup"
                                       PlacementTarget="{Binding ElementName=PreviewCameraButton}"
                                       Placement="Top" HorizontalOffset="-42" VerticalOffset="-6"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                       Closed="PreviewCameraPopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=PreviewCameraButton}">
                                    <Border Width="160" Background="#FF161822" BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1" CornerRadius="7" Padding="7">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Game"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraGame, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Orbit"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraOrbit, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Top"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraTop, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Front"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraFront, Mode=TwoWay}"/>
                                            <RadioButton GroupName="VfxPreviewCamera" Content="Side"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         IsChecked="{Binding IsPreviewCameraSide, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Rectangle Width="1" Fill="#22FFFFFF" Margin="2,7" VerticalAlignment="Stretch"
                                           Visibility="{Binding HasViewportContentControls, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Group 3: Content Controls & Shaders (Champion mesh/effects, Map structures/VFX, and Lit Shaders) -->
                                <Border Background="#1AFFFFFF" CornerRadius="11" Padding="2,1" Margin="2,0"
                                        Visibility="{Binding HasViewportContentControls, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Champion Controls -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding HasChampionMesh, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ToggleButton IsChecked="{Binding ShowChampionMesh, Mode=TwoWay}"
                                                          Style="{StaticResource TransparentIconToggleButton}"
                                                          Width="30" Height="30"
                                                          ToolTip="Toggle Champion 3D Model Mesh (when available)">
                                                <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton Click="PreviewBindPoseToggle_Click"
                                                          IsChecked="{Binding SelectedAnimation.IsBindPose, Mode=OneWay, FallbackValue=False, TargetNullValue=False}"
                                                          Style="{StaticResource TransparentIconToggleButton}"
                                                          IsEnabled="{Binding HasCharacterSkeleton}"
                                                          Width="30" Height="30" Margin="2,0,0,0"
                                                          ToolTip="T-Pose: toggle bind pose / return to animation">
                                                <materialIcons:MaterialIcon Kind="Human" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding CharacterEffectsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource TransparentIconToggleButton}"
                                                          Width="30" Height="30" Margin="2,0,0,0"
                                                          ToolTip="Show champion VFX">
                                                <materialIcons:MaterialIcon Kind="MagicStaff" Width="14" Height="14"/>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- Map Controls -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding HasMapPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ToggleButton IsChecked="{Binding MapStructuresVisible, Mode=TwoWay}"
                                                          Style="{StaticResource TransparentIconToggleButton}"
                                                          Width="30" Height="30" Margin="2,0,0,0"
                                                          ToolTip="Show map structures and props">
                                                <materialIcons:MaterialIcon Kind="HomeOutline" Width="14" Height="14"/>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{Binding MapParticlesVisible, Mode=TwoWay}"
                                                          Style="{StaticResource TransparentIconToggleButton}"
                                                          Width="30" Height="30" Margin="2,0,0,0"
                                                          ToolTip="Show map VFX">
                                                <materialIcons:MaterialIcon Kind="WeatherWindy" Width="14" Height="14"/>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- Shaders Toggle (Active for Lit meshes and terrain) -->
                                        <ToggleButton x:Name="PreviewShadersToggle"
                                                      Style="{StaticResource TransparentIconToggleButton}"
                                                      Width="30" Height="30" Margin="2,0,0,0"
                                                      ToolTip="Show game shaders"
                                                      IsChecked="{Binding PreviewShaders, Mode=TwoWay}">
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="14" Height="14"/>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>

                                <Rectangle Width="1" Fill="#22FFFFFF" Margin="2,7" VerticalAlignment="Stretch"/>

                                <!-- Group 4: Fit / Reset Camera -->
                                <Border Background="#1AFFFFFF" CornerRadius="11" Padding="2,1" Margin="2,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="ResetCamera_Click"
                                                Style="{StaticResource TransparentIconButton}"
                                                Width="30" Height="30"
                                                ToolTip="Fit to view">
                                            <materialIcons:MaterialIcon Kind="CropFree" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Compact viewport-toolbar affordance, matching the normal Viewer's FAB pattern. -->
                        <ToggleButton IsChecked="{Binding ViewportToolbarVisible, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,12,12" Cursor="Hand" Panel.ZIndex="30"
                                      ToolTip="Show / Hide Viewport Toolbar">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border" Width="36" Height="36" CornerRadius="18"
                                            Background="#E618181B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.4"/>
                                        </Border.Effect>
                                        <materialIcons:MaterialIcon x:Name="Icon" Kind="TuneVariant" Width="16" Height="16"
                                                                    Foreground="{StaticResource AccentBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF1E2233"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <!-- Rounded Border Stroke Overlay (crisp 1px outline, unclipped, hit-test transparent) -->
                    <Border CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" IsHitTestVisible="False"/>
                </Grid>

                <!-- SPLITTER (Seamless Viewport vs Timeline height adjust) -->
                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Visibility="{Binding TimelineVisible, Converter={StaticResource BoolToVis}}"
                              Background="Transparent" Cursor="SizeNS" ShowsPreview="False"/>

                <!-- 2. TIMELINE & TRANSPORT DECK (Independent Card outside Viewport, LTK-Manager / DAW Studio Style) -->
                <Border Grid.Row="3" Background="{StaticResource CardBackground}" CornerRadius="10"
                        Visibility="{Binding TimelineVisible, Converter={StaticResource BoolToVis}}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,8">
                    <Grid>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 1. Top Transport Controls & Search Bar -->
                            <RowDefinition Height="Auto"/> <!-- 2. Separator -->
                            <RowDefinition Height="Auto"/> <!-- 3. Time Ruler Header (Aligned with Tracks) -->
                            <RowDefinition Height="*"/>    <!-- 4. Scrollable Emitter Lanes & Interactive Tracks Grid -->
                        </Grid.RowDefinitions>

                        <!-- 1. TIMELINE TRANSPORT & SEARCH BAR -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Timeline, transport, time and options -->
                                <ColumnDefinition Width="*"/>    <!-- Middle spacer -->
                                <ColumnDefinition Width="Auto"/> <!-- Emitter filter -->
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Slider to preserve two-way time binding & event hooks -->
                            <Slider x:Name="TimeSlider" Visibility="Collapsed" Minimum="0" Maximum="{Binding TotalDuration}" 
                                    Value="{Binding CurrentTime, Mode=TwoWay}" ValueChanged="TimeSlider_ValueChanged"
                                    PreviewMouseDown="TimeSlider_PreviewMouseDown" PreviewMouseUp="TimeSlider_PreviewMouseUp"/>

                            <!-- Timeline identity, transport, time and playback options. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="TIMELINE" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emitters.Count}" FontSize="9.5" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="|" Foreground="{StaticResource TextMuted}" FontSize="14"
                                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>

                                <!-- Step Back Button (|<) -->
                                <Button Click="StepBack_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Step Back (-1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18"/>
                                </Button>

                                <!-- Dynamic Play / Pause / Replay Button -->
                                <Button Click="PlayPauseToggle_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Play / Pause / Replay">
                                    <materialIcons:MaterialIcon Width="18" Height="18">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="Play"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Kind" Value="Pause"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                                            <Condition Binding="{Binding IsReplayState}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Kind" Value="Replay"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <!-- Step Forward Button (>|) -->
                                <Button Click="StepForward_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Step Forward (+1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18"/>
                                </Button>

                                <!-- One timeline loop control is shared by Systems, Clips, and Spells. -->
                                <ToggleButton x:Name="TimelineLoopToggleButton"
                                              Click="TimelineLoopToggleButton_Click"
                                              IsChecked="{Binding IsPreviewLoopEnabled, Mode=TwoWay}"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Width="30" Height="28" Padding="0"
                                              Margin="0">
                                    <ToggleButton.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Loop preview and edit timeline range"/>
                                            <TextBlock Text="{Binding ActiveLoopDurationText}"/>
                                        </StackPanel>
                                    </ToggleButton.ToolTip>
                                    <materialIcons:MaterialIcon Kind="RepeatVariant" Width="17" Height="17"/>
                                </ToggleButton>

                                <TextBlock Text="|" Foreground="{StaticResource TextMuted}" FontSize="14"
                                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>

                                <!-- Time Readout -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas">
                                        <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat={}{0:F2}}" Foreground="{StaticResource TextPrimary}"/>
                                        <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding TotalDuration, Mode=OneWay, StringFormat={}{0:F2}s}" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Separator -->
                                <TextBlock Text="|" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <!-- Speed Control -->
                                <materialIcons:MaterialIcon Kind="Speedometer" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SpeedComboBox" Style="{StaticResource ModernComboBox}" Width="76" Height="26" SelectionChanged="Speed_SelectionChanged" SelectedIndex="4" Margin="0,0,8,0">
                                    <ComboBoxItem Content="0.05x" Tag="0.05"/>
                                    <ComboBoxItem Content="0.1x" Tag="0.1"/>
                                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                </ComboBox>

                                <Button x:Name="ChancePinButton" Click="ChancePinButton_Click"
                                        Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                                        Visibility="{Binding HasStandaloneSystem, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                            <Setter Property="ToolTip" Value="Particle randomness: random per birth"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChancePinToggle}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="#205B82FF"/>
                                                    <Setter Property="ToolTip" Value="Particle randomness: fixed value for new births"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialIcons:MaterialIcon Kind="Dice5Outline" Width="17" Height="17"/>
                                </Button>
                                <Popup x:Name="ChancePinPopup" PlacementTarget="{Binding ElementName=ChancePinButton}"
                                       Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" Closed="ChancePinPopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=ChancePinButton}">
                                    <Grid Width="240">
                                        <Border Background="{StaticResource CardBackground}" CornerRadius="7"/>
                                        <StackPanel Margin="12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <materialIcons:MaterialIcon Kind="Dice5Outline" Width="14" Height="14"
                                                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="PARTICLE RANDOMNESS" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChancePinToggle" Content="Fix random value" IsChecked="False"
                                                      Style="{StaticResource ModernCheckBox}" Click="ChancePinToggle_Click"
                                                      ToolTip="Use the chosen probability-table value for new particle births."/>
                                            <TextBlock Text="Off: random per birth. On: repeat the chosen value."
                                                       TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                       Margin="0,7,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="ChancePinSlider" Minimum="0" Maximum="1" Value="0.5"
                                                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                        IsEnabled="{Binding IsChecked, ElementName=ChancePinToggle}"
                                                        Style="{StaticResource HUDSliderStyle}" ToolTip="Probability-table draw (0 to 1)"
                                                        ValueChanged="ChancePinSlider_ValueChanged"/>
                                                <TextBlock x:Name="ChancePinValueText" Grid.Column="1" Text="0.50"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Popup>

                                <Button x:Name="TimelineOptionsButton" Click="TimelineOptionsButton_Click"
                                        Style="{StaticResource TransparentIconButton}" Width="30" Height="28" Padding="0"
                                        Visibility="{Binding HasAnimationParameters, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Animation options: authored parameter">
                                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18"/>
                                </Button>
                                <Popup x:Name="TimelineOptionsPopup" PlacementTarget="{Binding ElementName=TimelineOptionsButton}"
                                       Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" Closed="TimelineOptionsPopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=TimelineOptionsButton}">
                                    <Grid Width="220">
                                        <Border Background="{StaticResource CardBackground}" CornerRadius="7"/>
                                        <StackPanel Margin="12">
                                            <TextBlock Text="ANIMATION OPTIONS" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                                            <!-- Parametric AnimationGraph clips choose one authored mValue at a time. -->
                                            <StackPanel Margin="0,0,0,12"
                                                        Visibility="{Binding HasAnimationParameters, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Animation parameter" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                                           VerticalAlignment="Center" Margin="0,0,0,5"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" Width="Auto" Height="28"
                                                          ItemsSource="{Binding AnimationParameterValues}"
                                                          SelectedItem="{Binding AnimationParameter, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0:0.###}"/>
                                            </StackPanel>

                                        </StackPanel>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Popup>
                            </StackPanel>

                            <!-- Emitter filter stays at the right edge. -->
                                <Border Grid.Column="2" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        CornerRadius="5" Height="28" Width="170" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FilterVariant" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="EmitterFilterTextBox"
                                                 Text="{Binding EmitterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="EmitterFilter_TextChanged"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="White"
                                                 FontSize="11" VerticalContentAlignment="Center" Padding="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="Filter emitters" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Click="ClearEmitterFilter_Click" Style="{StaticResource TransparentIconButton}"
                                                Width="20" Height="20" Margin="0,0,2,0" ToolTip="Clear Filter"
                                                Visibility="{Binding HasEmitterFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                        </Grid>

                        <!-- 2. SUBTLE SEPARATOR -->
                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,2,0,6" Opacity="0.45"/>

                        <!-- 3. TIME RULER HEADER (Aligned with lanes) -->
                        <Grid Grid.Row="2" Margin="0,0,0,2" Height="26" Background="#08000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/> <!-- Name & Solo/Mute Header Column -->
                                <ColumnDefinition Width="*"/>   <!-- Time Ruler Ticks & Loop Indicator -->
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/> <!-- Global visibility -->
                                    <ColumnDefinition Width="*"/>  <!-- Label -->
                                    <ColumnDefinition Width="24"/> <!-- Global solo -->
                                </Grid.ColumnDefinitions>

                                <!-- Global visibility: applies to the complete VFX graph. -->
                                <Button Grid.Column="0" Click="ToggleMuteAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Show / Hide All Emitters">
                                    <materialIcons:MaterialIcon Width="13" Height="13">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="EyeOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllMuted}" Value="True">
                                                        <Setter Property="Kind" Value="EyeOffOutline"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="EMITTERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <!-- Global solo: mirrors the per-emitter S controls. -->
                                <Button Grid.Column="2" Click="ToggleSoloAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Solo / Unsolo All Emitters">
                                    <TextBlock Text="S" FontSize="9.5" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnySolo}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <!-- Ruler Ticks & Live Caption Header -->
                            <Grid Grid.Column="1" Margin="8,0,0,0" Cursor="Hand"
                                  PreviewMouseDown="Ruler_PreviewMouseDown"
                                  PreviewMouseMove="Ruler_PreviewMouseMove"
                                  PreviewMouseUp="Ruler_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/> <!-- Live Count Column Header -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="2" Width="1" Height="10" Background="#38FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="3" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="0" Text="0.00s" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding QuarterDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding HalfDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>
                        </Grid>

                        <!-- 4. TIMELINE TRACKS (Scrollable Emitters Lanes + Sweeping Needles) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                            <Grid x:Name="TimelineInteractiveGrid" Background="Transparent" 
                                  PreviewMouseDown="TimelineGrid_PreviewMouseDown" 
                                  PreviewMouseMove="TimelineGrid_PreviewMouseMove" 
                                  PreviewMouseUp="TimelineGrid_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/> <!-- Names, Thumbnails, Toggles & Solos Column -->
                                    <ColumnDefinition Width="*"/>   <!-- Tracks Canvas Column -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Emitters List -->
                                <StackPanel Grid.Column="0">
                                    <!-- Emitter Rows -->
                                    <ItemsControl ItemsSource="{Binding Emitters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TimelineLaneRowStyle}"
                                                        MouseLeftButtonDown="EmitterLane_MouseLeftButtonDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/> <!-- Mute (Eye) -->
                                                            <ColumnDefinition Width="22"/> <!-- Thumbnail Image/Icon -->
                                                            <ColumnDefinition Width="*"/>  <!-- Emitter Name -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Index [16] -->
                                                            <ColumnDefinition Width="24"/> <!-- Solo ('S') -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mute Button (Eye) -->
                                                        <Button Grid.Column="0" Click="EmitterMute_Click" Style="{StaticResource TransparentIconButton}" 
                                                                Width="20" Height="20" Padding="0" ToolTip="Mute (Hide) this emitter" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Width="13" Height="13">
                                                                <materialIcons:MaterialIcon.Style>
                                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                                        <Setter Property="Kind" Value="EyeOutline"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                <Setter Property="Kind" Value="EyeOffOutline"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialIcons:MaterialIcon.Style>
                                                            </materialIcons:MaterialIcon>
                                                        </Button>

                                                        <!-- Thumbnail Swatch (Image preview if loaded, else primitive icon) -->
                                                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="2" 
                                                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                                                Background="#10FFFFFF" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding ImagePreview}" Width="16" Height="16" Stretch="UniformToFill" 
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <materialIcons:MaterialIcon Kind="TextureBox" Width="11" Height="11" Foreground="{StaticResource TextMuted}"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon.Style>
                                                                        <Style TargetType="materialIcons:MaterialIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialIcons:MaterialIcon.Style>
                                                                </materialIcons:MaterialIcon>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Emitter Name -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" 
                                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" 
                                                                   ToolTip="{Binding Name}" Margin="4,0,2,0"/>

                                                        <!-- Index Number [16] -->
                                                        <TextBlock Grid.Column="3" Text="{Binding IndexNumber, StringFormat='[{0}]'}" FontSize="9.5" FontFamily="Consolas" 
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Solo Button ('S') -->
                                                        <Button Grid.Column="4" Click="EmitterSolo_Click" Width="20" Height="20" Padding="0" ToolTip="Solo this emitter" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="S" FontSize="10" FontWeight="Black">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right Column: Emitter Tracks Bars + Sweeping Needles -->
                                <Grid Grid.Column="1" Margin="8,0,0,0" x:Name="TracksCanvasContainer" SizeChanged="TracksCanvasContainer_SizeChanged" ClipToBounds="True"
                                      Background="#05000000">
                                    <!-- Temporal grid: quarter marks remain visible behind every lane. -->
                                    <Grid IsHitTestVisible="False" Panel.ZIndex="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="2" Width="1" Background="#20FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="3" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="4" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <StackPanel Panel.ZIndex="1">
                                        <!-- Emitter Bars Stack -->
                                        <ItemsControl ItemsSource="{Binding Emitters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TimelineLaneRowStyle}">
                                                        <Grid>
                                                            <!-- Authored emitter interval -->
                                                            <Border Background="{Binding TrackBrush}" BorderBrush="{Binding TrackBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="3" Height="16" VerticalAlignment="Center"
                                                                    Margin="{Binding TrackMargin}" HorizontalAlignment="Left" Width="{Binding TrackWidth}">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.22"/>
                                                                </Border.Effect>
                                                                <Border BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" CornerRadius="3"/>
                                                            </Border>

                                                            <!-- Emission trigger marker -->
                                                            <Ellipse Width="7" Height="7" Fill="#FBBF24" Stroke="#111827" StrokeThickness="1"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                     Margin="{Binding DelayMarkerMargin}"
                                                                     Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                     ToolTip="{Binding DelayTime, StringFormat='Emission Trigger: {0:F2}s'}">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect Color="#FBBF24" BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>

                                                            <!-- Live Particle Count -->
                                                            <Border Width="34" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                    Background="#0D000000" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding ActiveParticleCount}" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Playhead Needle Overlay Canvas -->
                                    <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False" Panel.ZIndex="10">
                                        <Line x:Name="PlayheadLine" X1="0" Y1="6" X2="0" Y2="800"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0.95"/>
                                        <Path x:Name="PlayheadHandle" Data="M 0,0 L 10,0 L 5,6 Z"
                                              Canvas.Top="0" Fill="{StaticResource AccentBrush}">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="5" ShadowDepth="0" Opacity="0.75"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>

                                    <!-- Active System Loop Boundary Needle Overlay Canvas -->
                                    <Canvas x:Name="LoopBoundaryCanvas" Panel.ZIndex="100">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoopEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Border x:Name="LoopRangeBand" Canvas.Top="0" Height="800" Width="0"
                                                Background="#10FFD700" IsHitTestVisible="False"/>
                                        <Line x:Name="LoopStartLine" X1="0" Y1="0" X2="0" Y2="800"
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Line x:Name="LoopBoundaryLine" X1="0" Y1="0" X2="0" Y2="800" 
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Ellipse x:Name="LoopStartHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE"
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5"
                                                 PreviewMouseDown="LoopStartHandle_PreviewMouseDown"
                                                 PreviewMouseMove="LoopStartHandle_PreviewMouseMove"
                                                 PreviewMouseUp="LoopStartHandle_PreviewMouseUp"
                                                 ToolTip="Drag to adjust preview loop start">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="LoopBoundaryHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE" 
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5" 
                                                 PreviewMouseDown="LoopBoundaryHandle_PreviewMouseDown" 
                                                 PreviewMouseMove="LoopBoundaryHandle_PreviewMouseMove" 
                                                 PreviewMouseUp="LoopBoundaryHandle_PreviewMouseUp" 
                                                 ToolTip="Drag to adjust preview loop end">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="InspectorSplitter_DragCompleted"
                          Visibility="{Binding IsInspectorPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Border x:Name="InspectorPanelBorder" Grid.Column="4" MinWidth="260"
                    Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1,0,0,0" Padding="12,12,12,12"
                    Visibility="{Binding IsInspectorPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0">
                        <!-- HERO INSPECTOR HEADER -->
                        <Border Margin="0,0,0,12"
                                Background="{StaticResource CardBackground}" 
                                CornerRadius="12" 
                                BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="15" Height="15" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="INSPECTOR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Scene / Transform / Geometry" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Click="CollapseInspectorSections_Click"
                                        Style="{StaticResource TransparentIconButton}" Width="26" Height="26"
                                        Margin="8,0,0,0" ToolTip="Collapse all sections">
                                    <materialIcons:MaterialIcon Kind="UnfoldLessHorizontal" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- CHARACTER / BACKDROP -->
                        <StackPanel Visibility="{Binding IsSkinWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- SCENE ACTORS HEADER -->
                            <ToggleButton x:Name="VfxSceneActorsSection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="AccountGroupOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="SCENE ACTORS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Select a Character to edit it" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedWorkspaceTab.Actors.Count}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <materialIcons:MaterialIcon Grid.Column="3" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- SCENE ACTORS CONTENT -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding IsChecked, ElementName=VfxSceneActorsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox x:Name="SceneActorsList" ItemsSource="{Binding SelectedWorkspaceTab.Actors, NotifyOnTargetUpdated=True}"
                                         SelectionMode="Extended"
                                         TargetUpdated="SceneActorsList_TargetUpdated"
                                         SelectionChanged="SceneActorsList_SelectionChanged"
                                         Style="{StaticResource ModernListBox}"
                                         ItemContainerStyle="{StaticResource ModernSelectableCardItemStyle}">
                                    <!-- At most MaxSceneActors rows: the Inspector ScrollViewer owns scrolling. -->
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:VfxSceneActor}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon x:Name="ActorIcon" Kind="AccountOutline" Width="14" Height="14"
                                                                                Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Subtitle}">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="ActorStatus" Text="{Binding StatusText}" FontSize="9" Opacity="0.8" Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay}" Style="{StaticResource TransparentIconToggleButton}"
                                                              Width="26" Height="26" Margin="4,0,0,0" ToolTip="Show / hide Character">
                                                    <materialIcons:MaterialIcon Kind="{Binding IsVisible, Converter={StaticResource BooleanToMaterialIconConverter}, ConverterParameter='Eye,EyeOff'}"
                                                                                Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ToggleButton>
                                                <Button x:Name="RemoveActorButton" Grid.Column="3" Click="RemoveSceneActor_Click" Style="{StaticResource TransparentIconButton}"
                                                        Width="26" Height="26" ToolTip="Remove from scene"
                                                        Visibility="{Binding DataContext.SelectedWorkspaceTab.HasExtraActors, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                    <Setter TargetName="ActorIcon" Property="Kind" Value="AccountEdit"/>
                                                    <Setter TargetName="ActorIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="ActorStatus" Property="Text" Value="Editing in Inspector"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Background="{StaticResource CardBackground}" CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AccountMultiplePlusOutline" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="Add Characters with + on a Skin in the project tree, or right-click it." FontSize="10"
                                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- STANDALONE VFX MOTION -->
                        <StackPanel Visibility="{Binding HasStandaloneSystem, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToggleButton x:Name="VfxMotionSection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VFX MOTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Preview movement and variation" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                                    Visibility="{Binding IsChecked, ElementName=VfxMotionSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="MOTION" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" Height="28" Margin="0,4,0,12"
                                              SelectedValuePath="Tag" SelectedValue="{Binding RigPresetText, Mode=OneWay}"
                                              SelectionChanged="InspectorRigPreset_SelectionChanged">
                                        <ComboBoxItem Content="Still" Tag="Still"/>
                                        <ComboBoxItem Content="Burst" Tag="Burst"/>
                                        <ComboBoxItem Content="Missile" Tag="Missile"/>
                                        <ComboBoxItem Content="Trail" Tag="Trail"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,3">
                                            <TextBlock Text="Height" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="RigHeightValueText" Text="100 u" HorizontalAlignment="Right"
                                                       FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                        </Grid>
                                        <Slider x:Name="RigHeightSlider" Minimum="0" Maximum="600" TickFrequency="10"
                                                IsSnapToTickEnabled="True" Value="100" Style="{StaticResource HUDSliderStyle}"
                                                ValueChanged="RigHeightSlider_ValueChanged"/>

                                        <StackPanel x:Name="RigDistancePanel" Margin="0,7,0,0">
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="Distance" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock x:Name="RigDistanceValueText" Text="1200 u" HorizontalAlignment="Right"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                            </Grid>
                                            <Slider x:Name="RigDistanceSlider" Minimum="200" Maximum="4000" TickFrequency="50"
                                                    IsSnapToTickEnabled="True" Value="1200" Style="{StaticResource HUDSliderStyle}"
                                                    ValueChanged="RigDistanceSlider_ValueChanged"/>
                                            <Grid Margin="0,5,0,3">
                                                <TextBlock Text="Speed" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock x:Name="RigSpeedValueText" Text="1600 u/s" HorizontalAlignment="Right"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                            </Grid>
                                            <Slider x:Name="RigSpeedSlider" Minimum="100" Maximum="5000" TickFrequency="50"
                                                    IsSnapToTickEnabled="True" Value="1600" Style="{StaticResource HUDSliderStyle}"
                                                    ValueChanged="RigSpeedSlider_ValueChanged"/>
                                        </StackPanel>

                                        <StackPanel x:Name="RigOrbitPanel" Margin="0,7,0,0">
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="Radius" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock x:Name="RigRadiusValueText" Text="300 u" HorizontalAlignment="Right"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                            </Grid>
                                            <Slider x:Name="RigRadiusSlider" Minimum="50" Maximum="1600" TickFrequency="25"
                                                    IsSnapToTickEnabled="True" Value="300" Style="{StaticResource HUDSliderStyle}"
                                                    ValueChanged="RigRadiusSlider_ValueChanged"/>
                                            <Grid Margin="0,5,0,3">
                                                <TextBlock Text="Period" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock x:Name="RigPeriodValueText" Text="3.00 s" HorizontalAlignment="Right"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                            </Grid>
                                            <Slider x:Name="RigPeriodSlider" Minimum="0.25" Maximum="12" TickFrequency="0.25"
                                                    IsSnapToTickEnabled="True" Value="3" Style="{StaticResource HUDSliderStyle}"
                                                    ValueChanged="RigPeriodSlider_ValueChanged"/>
                                        </StackPanel>

                                        <Grid Margin="0,9,0,0">
                                            <TextBlock Text="Seed" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Click="RerollSeed_Click"
                                                    Style="{StaticResource SmallTextButtonStyle}"
                                                    ToolTip="Generate another deterministic VFX variation">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialIcons:MaterialIcon Kind="DiceMultipleOutline" Width="13" Height="13"
                                                                                Foreground="{StaticResource TextSecondary}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding PlaybackSeed}" FontSize="10" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSkinWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- MAP BACKDROP HEADER -->
                            <ToggleButton x:Name="VfxMapBackdropSection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="MapOutline" Width="14" Height="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MAP BACKDROP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Environment &amp; stage scene" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- MAP BACKDROP CARD -->
                            <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="12" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Visibility="{Binding IsChecked, ElementName=VfxMapBackdropSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <CheckBox Content="Enable MAP backdrop" IsChecked="{Binding CharacterBackdropEnabled, Mode=TwoWay}" IsEnabled="{Binding HasCharacterBackdropOptions}" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding CharacterBackdrops}" SelectedItem="{Binding SelectedCharacterBackdrop, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding CharacterBackdropEnabled}" Style="{StaticResource ModernComboBox}" Height="28" Margin="0,0,0,10"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MapStateControlsTemplate}"
                                                    Visibility="{Binding HasActiveCharacterBackdrop, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>


                            <!-- TRANSFORM HEADER -->
                            <ToggleButton x:Name="VfxCharacterTransformSection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="AxisArrow" Width="14" Height="14" Foreground="{StaticResource AccentTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="TRANSFORM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Position, rotation and scale" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- TRANSFORM CONTENT -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=VfxCharacterTransformSection, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                <!-- Reset All Bar -->
                                <Border Background="{StaticResource CardBackground}" CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Restore" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="Reset all transforms" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Click="ResetCharacterPlacement_Click" Style="{StaticResource SmallTextButtonStyle}" 
                                                Content="RESET ALL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- POSITION CARD -->
                                <Border Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CursorMove" Width="13" Height="13" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="POSITION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="World coordinates" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" HorizontalAlignment="Right" Click="ResetCharacterPosition_Click" Style="{StaticResource TransparentIconButton}" Width="24" Height="24" ToolTip="Reset Position">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13"/>
                                            </Button>
                                        </Grid>
                                        
                                        <!-- X Axis -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1FFF6B35" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="X" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharPosXSlider" Minimum="-1000" Maximum="1000" Value="{Binding CharacterPositionX, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharPosXSlider, StringFormat={}{0:F0}}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <!-- Y Axis -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1F00E676" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Y" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharPosYSlider" Minimum="-1000" Maximum="3000" Value="{Binding CharacterPositionY, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharPosYSlider, StringFormat={}{0:F0}}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <!-- Z Axis -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1F00D1FF" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Z" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharPosZSlider" Minimum="-1000" Maximum="1000" Value="{Binding CharacterPositionZ, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharPosZSlider, StringFormat={}{0:F0}}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ROTATION CARD -->
                                <Border Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Rotate3DVariant" Width="13" Height="13" Foreground="{StaticResource AccentTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="ROTATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Euler angles in degrees" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" HorizontalAlignment="Right" Click="ResetCharacterRotation_Click" Style="{StaticResource TransparentIconButton}" Width="24" Height="24" ToolTip="Reset Rotation">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13"/>
                                            </Button>
                                        </Grid>
                                        <!-- RX -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1FFF6B35" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="X" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharRotXSlider" Minimum="-360" Maximum="360" Value="{Binding CharacterRotationX, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharRotXSlider, StringFormat={}{0:F0}°}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <!-- RY -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1F00E676" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Y" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharRotYSlider" Minimum="-360" Maximum="360" Value="{Binding CharacterRotationY, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharRotYSlider, StringFormat={}{0:F0}°}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <!-- RZ -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1F00D1FF" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Z" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharRotZSlider" Minimum="-360" Maximum="360" Value="{Binding CharacterRotationZ, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharRotZSlider, StringFormat={}{0:F0}°}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SCALE CARD -->
                                <Border Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Resize" Width="13" Height="13" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="SCALE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Uniform scale factor" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" HorizontalAlignment="Right" Click="ResetCharacterScale_Click" Style="{StaticResource TransparentIconButton}" Width="24" Height="24" ToolTip="Reset Scale">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13"/>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1FA78BFA" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="S" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Slider Grid.Column="1" x:Name="CharScaleSlider" Minimum="0.05" Maximum="4" Value="{Binding CharacterScaleMultiplier, Mode=TwoWay}" TickFrequency="0.05" VerticalAlignment="Center" Style="{StaticResource HUDSliderStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CharScaleSlider, StringFormat={}{0:F2}x}" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GAME STATE: buffs the skin's dynamic materials read (in combat, R form, passive ready...) -->
                            <StackPanel Visibility="{Binding HasCharacterGameStates, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ToggleButton x:Name="VfxCharacterGameStateSection" IsChecked="True" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                    <Grid Margin="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="14" Height="14" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="GAME STATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Buffs the skin's shaders react to" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                    </Grid>
                                </ToggleButton>

                                <StackPanel Visibility="{Binding IsChecked, ElementName=VfxCharacterGameStateSection, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                    <Border Background="{StaticResource CardBackground}" CornerRadius="12"
                                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,10">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding CharacterGameStates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}" Style="{StaticResource ModernCheckBox}" Margin="0,3,0,0"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Needs game shaders on. States tied to an animation follow the playing clip."
                                                       FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- GEOMETRY HEADER -->
                            <ToggleButton x:Name="VfxCharacterGeometrySection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="LayersOutline" Width="14" Height="14" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="GEOMETRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Armature and submesh textures" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>

                            <!-- GEOMETRY CONTENT -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=VfxCharacterGeometrySection, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                <Border Background="{StaticResource CardBackground}" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8"
                                        Visibility="{Binding HasCharacterForms, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="14" Height="14"
                                                                        Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="FORM" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding CharacterForms}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedCharacterForm, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Height="28"
                                                  ToolTip="Select character form"/>
                                    </StackPanel>
                                </Border>

                                <!-- Armature Card -->
                                <Border Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                    <UniformGrid Columns="2">
                                        <CheckBox Content="Show armature" IsChecked="{Binding ShowCharacterArmature, Mode=TwoWay}" IsEnabled="{Binding HasCharacterSkeleton}" Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox Content="Joint names" IsChecked="{Binding ShowCharacterJointNames, Mode=TwoWay}" IsEnabled="{Binding ShowCharacterArmature}" Style="{StaticResource ModernCheckBox}"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Submeshes Header Bar -->
                                <Border Background="{StaticResource CardBackground}" CornerRadius="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="LayersOutline" Width="14" Height="14" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="SUBMESHES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Visibility &amp; material textures" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="ResetCharacterSubmeshOverrides_Click" Style="{StaticResource SmallTextButtonStyle}"
                                                Content="RESET ALL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Submeshes List -->
                                <ItemsControl ItemsSource="{Binding CharacterSubmeshes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBackground}" CornerRadius="8"
                                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                                    Margin="0,0,0,6" Padding="10,8">
                                                <StackPanel>
                                                    <!-- Top: mesh icon + name + override indicator + visibility checkbox -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="CubeOutline" Width="14" Height="14" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   FontWeight="SemiBold" FontSize="11"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="6,0,8,0" VerticalAlignment="Center" ToolTip="Manually overridden"
                                                                Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <CheckBox Grid.Column="3"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  Style="{StaticResource ModernCheckBox}"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="Toggle Submesh Visibility"/>
                                                    </Grid>

                                                    <!-- Bottom: texture icon + dropdown -->
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="TextureBox" Width="13" Height="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableTextureNames}"
                                                                  SelectedItem="{Binding SelectedTextureName, Mode=TwoWay}"
                                                                  Style="{StaticResource ModernComboBox}"
                                                                  Height="28"
                                                                  ToolTip="Select submesh texture"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- MAP SCENE -->
                        <StackPanel Visibility="{Binding IsMapWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToggleButton x:Name="VfxMapSceneSection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Map" Width="14" Height="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MAP SCENE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Variant, transformation and decorations" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>
                            <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="12" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Visibility="{Binding IsChecked, ElementName=VfxMapSceneSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding CanSelectMapVariant, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="VARIANT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                        <ComboBox ItemsSource="{Binding MapVariants}" SelectedItem="{Binding SelectedMapVariant, Mode=TwoWay}" Style="{StaticResource ModernComboBox}" Height="28" Margin="0,4,0,8"
                                                  ToolTip="Map skin and the container it draws. Skins sharing a container use the same geometry.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Label}" FontSize="10"/>
                                                        <TextBlock Text="{Binding Detail, StringFormat=' · {0}'}" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MapStateControlsTemplate}"/>
                                </StackPanel>
                            </Border>

                            <ToggleButton x:Name="VfxMapLookSection" IsChecked="False" Style="{StaticResource CollapsibleSectionHeaderStyle}" Margin="0,0,0,4">
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="7" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="14" Height="14" Foreground="#FFD166" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MAP LOOK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Lighting and post processing" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="2" Style="{StaticResource AnimatedChevronStyle}"/>
                                </Grid>
                            </ToggleButton>
                            <Border Margin="0,0,0,4" Padding="14,12" CornerRadius="12" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Visibility="{Binding IsChecked, ElementName=VfxMapLookSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Tile Switcher (Sun | Post) matching Environment controls -->
                                    <UniformGrid Columns="2" Height="68" Margin="0,0,0,12">
                                        <ToggleButton x:Name="MapSunToggle" IsChecked="True" Style="{StaticResource ModernTileToggleButton}" Margin="0,0,2,0" Click="MapSunToggle_Click">
                                            <StackPanel>
                                                <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="22" Height="22" Margin="0,0,0,3"/>
                                                <TextBlock Text="Sun" FontSize="10.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="MapPostToggle" IsChecked="False" Style="{StaticResource ModernTileToggleButton}" Margin="2,0,0,0" Click="MapPostToggle_Click">
                                            <StackPanel>
                                                <materialIcons:MaterialIcon Kind="ImageFilterVintage" Width="22" Height="22" Margin="0,0,0,3"/>
                                                <TextBlock Text="Post" FontSize="10.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </UniformGrid>

                                    <!-- INLINE SUN PANEL -->
                                    <StackPanel x:Name="MapSunPanel" Visibility="Visible">
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="SUN OVERRIDE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <Button Content="Reset" HorizontalAlignment="Right" Padding="8,2" Style="{StaticResource SmallTextButtonStyle}" Foreground="{StaticResource AccentBrush}" Click="MapSunReset_Click"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,1">
                                            <TextBlock Text="Azimuth" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding Value, ElementName=MapSunAzimuthSlider, StringFormat={}{0:F0}°}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="MapSunAzimuthSlider" Minimum="-180" Maximum="180" TickFrequency="1" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                        <Grid Margin="0,6,0,1">
                                            <TextBlock Text="Elevation" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding Value, ElementName=MapSunElevationSlider, StringFormat={}{0:F0}°}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="MapSunElevationSlider" Minimum="0" Maximum="89" TickFrequency="1" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,1">
                                                    <TextBlock Text="Strength" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding Value, ElementName=MapSunStrengthSlider, StringFormat={}{0:F2}}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="MapSunStrengthSlider" Minimum="0" Maximum="2" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,1">
                                                    <TextBlock Text="Ambient" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding Value, ElementName=MapSunAmbientSlider, StringFormat={}{0:F2}}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="MapSunAmbientSlider" Minimum="0" Maximum="2" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSunControl_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Sun color" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                            <Border x:Name="MapSunColorSwatch" Grid.Column="1" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Color preview"/>
                                            <TextBox x:Name="MapSunColorTextBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapSunColor_TextChanged"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Sky color" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                            <Border x:Name="MapSunSkyColorSwatch" Grid.Column="1" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Color preview"/>
                                            <TextBox x:Name="MapSunSkyColorTextBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapSunColor_TextChanged"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Ground" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                            <Border x:Name="MapSunGroundColorSwatch" Grid.Column="1" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Color preview"/>
                                            <TextBox x:Name="MapSunGroundColorTextBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapSunColor_TextChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- INLINE POST-PROCESS PANEL -->
                                    <StackPanel x:Name="MapPostPanel" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="POST EFFECTS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <Button Content="Reset" HorizontalAlignment="Right" Padding="8,2" Style="{StaticResource SmallTextButtonStyle}" Foreground="{StaticResource AccentBrush}" Click="MapPostReset_Click"/>
                                        </Grid>

                                        <!-- AMBIENT OCCLUSION (SSAO) -->
                                        <Border Margin="0,0,0,10" Padding="10,9" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="BoxShadow" Width="13" Height="13" Foreground="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="AMBIENT OCCLUSION" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="MapSsaoEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right" Click="MapSsaoControl_Changed"/>
                                                </Grid>
                                                <StackPanel Visibility="{Binding IsChecked, ElementName=MapSsaoEnabledCheck, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                                                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="Quality" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                        <ComboBox x:Name="MapSsaoQualityCombo" HorizontalAlignment="Right" Width="110" Style="{StaticResource ModernComboBox}" Height="24" SelectionChanged="MapSsaoControl_Changed">
                                                            <ComboBoxItem Content="4 samples"/>
                                                            <ComboBoxItem Content="8 samples"/>
                                                        </ComboBox>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,1">
                                                        <TextBlock Text="Radius" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Value, ElementName=MapSsaoRadiusSlider, StringFormat={}{0:F0}}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="MapSsaoRadiusSlider" Minimum="0" Maximum="200" TickFrequency="1" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                    <Grid Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Power" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapSsaoPowerSlider, StringFormat={}{0:F1}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapSsaoPowerSlider" Minimum="0" Maximum="30" TickFrequency="0.5" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Intensity" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapSsaoIntensitySlider, StringFormat={}{0:F2}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapSsaoIntensitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Bias" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapSsaoBiasSlider, StringFormat={}{0:F1}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapSsaoBiasSlider" Minimum="0" Maximum="20" TickFrequency="0.5" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Buffer scale" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapSsaoBufferScaleSlider, StringFormat={}{0:P0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapSsaoBufferScaleSlider" Minimum="0.25" Maximum="1" TickFrequency="0.05" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapSsaoControl_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <CheckBox x:Name="MapSsaoEdgeAwareCheck" Content="Edge-aware blur" Style="{StaticResource ModernCheckBox}" Margin="0,7,0,2" Click="MapSsaoControl_Changed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- DEPTH FOG -->
                                        <Border Margin="0,0,0,10" Padding="10,9" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="WeatherFog" Width="13" Height="13" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="DEPTH FOG" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="MapDepthFogEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right" Click="MapPostControl_Changed"/>
                                                </Grid>
                                                <StackPanel Visibility="{Binding IsChecked, ElementName=MapDepthFogEnabledCheck, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                                                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Fog color" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                        <Border x:Name="MapDepthFogColorSwatch" Grid.Column="1" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#000000" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Color preview"/>
                                                        <TextBox x:Name="MapDepthFogColorTextBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapPostControl_Changed"/>
                                                    </Grid>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Start" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapDepthFogStartSlider, StringFormat={}{0:F0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapDepthFogStartSlider" Minimum="0" Maximum="20000" TickFrequency="50" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="End" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapDepthFogEndSlider, StringFormat={}{0:F0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapDepthFogEndSlider" Minimum="0" Maximum="20000" TickFrequency="50" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,5,0,1">
                                                        <TextBlock Text="Max intensity" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Value, ElementName=MapDepthFogMaxSlider, StringFormat={}{0:F2}}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="MapDepthFogMaxSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- HEIGHT FOG -->
                                        <Border Margin="0,0,0,10" Padding="10,9" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="CloudOutline" Width="13" Height="13" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="HEIGHT FOG" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="MapHeightFogEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right" Click="MapPostControl_Changed"/>
                                                </Grid>
                                                <StackPanel Visibility="{Binding IsChecked, ElementName=MapHeightFogEnabledCheck, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                                                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Fog color" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                        <Border x:Name="MapHeightFogColorSwatch" Grid.Column="1" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#000000" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Color preview"/>
                                                        <TextBox x:Name="MapHeightFogColorTextBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="24" Padding="5,0" FontSize="9.5" FontFamily="Consolas" TextChanged="MapPostControl_Changed"/>
                                                    </Grid>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Start" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapHeightFogStartSlider, StringFormat={}{0:F0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapHeightFogStartSlider" Minimum="-1000" Maximum="1500" TickFrequency="10" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="End" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapHeightFogEndSlider, StringFormat={}{0:F0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapHeightFogEndSlider" Minimum="-1000" Maximum="1500" TickFrequency="10" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,5,0,1">
                                                        <TextBlock Text="Max intensity" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Value, ElementName=MapHeightFogMaxSlider, StringFormat={}{0:F2}}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="MapHeightFogMaxSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- DEPTH OF FIELD -->
                                        <Border Margin="0,0,0,4" Padding="10,9" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="CameraIris" Width="13" Height="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="DEPTH OF FIELD" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="MapDofEnabledCheck" Content="Enabled" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right" Click="MapPostControl_Changed"/>
                                                </Grid>
                                                <StackPanel Visibility="{Binding IsChecked, ElementName=MapDofEnabledCheck, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                                                    <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Focal dist" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapDofFocalSlider, StringFormat={}{0:F0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapDofFocalSlider" Minimum="0" Maximum="10000" TickFrequency="50" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,1">
                                                                <TextBlock Text="Focus width" FontSize="8.5" Foreground="{StaticResource TextMuted}"/>
                                                                <TextBlock Text="{Binding Value, ElementName=MapDofWidthSlider, StringFormat={}{0:F0}}" FontSize="8.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Slider x:Name="MapDofWidthSlider" Minimum="0" Maximum="5000" TickFrequency="25" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,5,0,1">
                                                        <TextBlock Text="Blur (CoC)" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Value, ElementName=MapDofCocSlider, StringFormat={}{0:F1}}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="MapDofCocSlider" Minimum="0" Maximum="30" TickFrequency="0.5" Style="{StaticResource HUDSliderStyle}" ValueChanged="MapPostControl_Changed"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
