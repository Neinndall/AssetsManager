<UserControl x:Class="AssetsManager.Views.Controls.Viewer.ViewerProjectExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:shared="clr-namespace:AssetsManager.Views.Controls.Shared"
             xmlns:explorer="clr-namespace:AssetsManager.Views.Controls.Explorer"
             xmlns:local="clr-namespace:AssetsManager.Views.Controls.Viewer"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="900">

    <Border Background="{StaticResource SidebarBackground}" 
            BorderBrush="{StaticResource BorderColor}" 
            BorderThickness="1" 
            Margin="4,0,4,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top bar (Header, Breadcrumbs, Search) -->
                <RowDefinition Height="*"/>    <!-- Split view (Folders Tree vs File Grid) -->
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- TOP BAR (Breadcrumbs & Search)              -->
            <!-- ============================================ -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="6,3" Background="{StaticResource CardBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Label & Open Button -->
                        <ColumnDefinition Width="*"/>    <!-- Breadcrumbs -->
                        <ColumnDefinition Width="130"/>  <!-- Search Box -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Height="26" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="2,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PROJECTS" FontSize="9.5" FontWeight="Black" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Click="ChangeFolder_Click" Style="{StaticResource SmallTextButtonStyle}" Content="OPEN" FontSize="9" Padding="4,1" VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Background="{StaticResource BorderColor}" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Breadcrumbs display -->
                    <explorer:BreadcrumbControl Grid.Column="1"
                                                x:Name="Breadcrumbs"
                                                Margin="6,0"
                                                FontSize="10"
                                                VerticalAlignment="Center"
                                                ItemClicked="Breadcrumbs_ItemClicked"/>

                    <shared:SearchBoxControl Grid.Column="2" x:Name="SearchBox" Height="26"
                                             SearchTextChanged="SearchBox_SearchTextChanged"
                                             Tag="Search..."/>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- MAIN CONTENT AREA (Splitter Layout)          -->
            <!-- ============================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" MinWidth="120" MaxWidth="300"/> <!-- Folder Tree -->
                    <ColumnDefinition Width="Auto"/>                             <!-- Splitter -->
                    <ColumnDefinition Width="*"/>                                <!-- Files Wrap Panel Grid -->
                </Grid.ColumnDefinitions>

                <!-- 1. Folder Tree View Section -->
                <Grid Grid.Column="0" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="FOLDERS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,2,4,4"/>
                    
                    <TreeView Grid.Row="1" 
                              x:Name="FoldersTreeView"
                              Style="{StaticResource ModernTreeView}"
                              SelectedItemChanged="FoldersTreeView_SelectedItemChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:ProjectExplorerNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}" 
                                                                Foreground="{Binding IconColor}" 
                                                                Width="14" Height="14" 
                                                                Margin="0,0,5,0" 
                                                                VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="140"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>

                <!-- Vertical GridSplitter -->
                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Width="1"
                              Background="{StaticResource BorderColor}"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"/>

                <!-- 2. Files List (grid tiles) -->
                <ListBox Grid.Column="2"
                         x:Name="FilesListBox"
                         Margin="4"
                         Style="{StaticResource ModernFileGridListBox}"
                         PreviewMouseRightButtonDown="FilesListBox_PreviewMouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="FilesContextMenu_Opened">
                            <MenuItem x:Name="LoadAnimationsMenuItem"
                                      Header="Load Animations"
                                      Click="LoadAnimationsMenuItem_Click">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="AnimationPlay"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProjectExplorerNode}">
                            <Border x:Name="ItemBorder" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="4" Width="95" Height="95" Cursor="Hand">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>    <!-- Large Icon -->
                                        <RowDefinition Height="Auto"/> <!-- File/Folder name -->
                                    </Grid.RowDefinitions>
                                    
                                    <materialIcons:MaterialIcon Grid.Row="0"
                                                                Kind="{Binding IconKind}"
                                                                Foreground="{Binding IconColor}"
                                                                Width="36" Height="36"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="0,4,0,4"/>
                                    
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="26"
                                               MaxWidth="82"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverColor}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
