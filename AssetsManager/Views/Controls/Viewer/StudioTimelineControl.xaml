<UserControl x:Class="AssetsManager.Views.Controls.Viewer.StudioTimelineControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:viewerControls="clr-namespace:AssetsManager.Views.Controls.Viewer"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AssetsManager.Views.Models.Viewer"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
       >
    <UserControl.Resources>
<BooleanToVisibilityConverter x:Key="BoolToVis"/>
<Style x:Key="TimelineLaneRowStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Background" Value="#07000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#122D6DF6"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#182D6DF6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSolo}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
<Style x:Key="TimelineTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>
<Grid>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 1. Top Transport Controls & Search Bar -->
                            <RowDefinition Height="Auto"/> <!-- 2. Separator -->
                            <RowDefinition Height="Auto"/> <!-- 3. Time Ruler Header (Aligned with Tracks) -->
                            <RowDefinition Height="*"/>    <!-- 4. Scrollable Emitter Lanes & Interactive Tracks Grid -->
                        </Grid.RowDefinitions>

                        <!-- 1. TIMELINE TRANSPORT & SEARCH BAR -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Timeline, transport, time and options -->
                                <ColumnDefinition Width="*"/>    <!-- Middle spacer -->
                                <ColumnDefinition Width="Auto"/> <!-- Emitter filter -->
                            </Grid.ColumnDefinitions>

                            <!-- Hidden Slider to preserve two-way time binding & event hooks -->
                            <Slider x:Name="TimeSlider" Visibility="Collapsed" Minimum="0" Maximum="{Binding TotalDuration}"
                                    Value="{Binding CurrentTime, Mode=TwoWay}" ValueChanged="TimeSlider_ValueChanged"
                                    PreviewMouseDown="TimeSlider_PreviewMouseDown" PreviewMouseUp="TimeSlider_PreviewMouseUp"/>

                            <!-- Timeline identity, transport, time and playback options. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <materialIcons:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="TIMELINE" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emitters.Count}" FontSize="9.5" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="|" Foreground="{StaticResource TextMuted}" FontSize="14"
                                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>

                                <!-- Step Back Button (|<) -->
                                <Button Click="StepBack_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Step Back (-1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18"/>
                                </Button>

                                <!-- Dynamic Play / Pause / Replay Button -->
                                <Button Click="PlayPauseToggle_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Play / Pause / Replay">
                                    <materialIcons:MaterialIcon Width="18" Height="18">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="Play"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Kind" Value="Pause"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                                            <Condition Binding="{Binding IsReplayState}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Kind" Value="Replay"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <!-- Step Forward Button (>|) -->
                                <Button Click="StepForward_Click" Style="{StaticResource TimelineTransportButtonStyle}"
                                        Margin="0,0,2,0" ToolTip="Step Forward (+1 frame)">
                                    <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18"/>
                                </Button>

                                <!-- One timeline loop control is shared by Systems, Clips, and Spells. -->
                                <ToggleButton x:Name="TimelineLoopToggleButton"
                                              Click="TimelineLoopToggleButton_Click"
                                              IsChecked="{Binding IsPreviewLoopEnabled, Mode=TwoWay}"
                                              Style="{StaticResource TransparentIconToggleButton}"
                                              Width="30" Height="28" Padding="0"
                                              Margin="0">
                                    <ToggleButton.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="Loop preview and edit timeline range"/>
                                            <TextBlock Text="{Binding ActiveLoopDurationText}"/>
                                        </StackPanel>
                                    </ToggleButton.ToolTip>
                                    <materialIcons:MaterialIcon Kind="RepeatVariant" Width="17" Height="17"/>
                                </ToggleButton>

                                <TextBlock Text="|" Foreground="{StaticResource TextMuted}" FontSize="14"
                                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>

                                <!-- Time Readout -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="14" Height="14"
                                                                Foreground="{StaticResource TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas">
                                        <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat={}{0:F2}}" Foreground="{StaticResource TextPrimary}"/>
                                        <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding TotalDuration, Mode=OneWay, StringFormat={}{0:F2}s}" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Separator -->
                                <TextBlock Text="|" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <!-- Speed Control -->
                                <materialIcons:MaterialIcon Kind="Speedometer" Width="14" Height="14" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SpeedComboBox" Style="{StaticResource ModernComboBox}" Width="76" Height="26" SelectionChanged="Speed_SelectionChanged" SelectedIndex="4" Margin="0,0,8,0">
                                    <ComboBoxItem Content="0.05x" Tag="0.05"/>
                                    <ComboBoxItem Content="0.1x" Tag="0.1"/>
                                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                </ComboBox>

                                <Button x:Name="ChancePinButton" Click="ChancePinButton_Click"
                                        Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                                        Visibility="{Binding HasStandaloneSystem, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                            <Setter Property="ToolTip" Value="Particle randomness: random per birth"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChancePinToggle}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="#205B82FF"/>
                                                    <Setter Property="ToolTip" Value="Particle randomness: fixed value for new births"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialIcons:MaterialIcon Kind="Dice5Outline" Width="17" Height="17"/>
                                </Button>
                                <Popup x:Name="ChancePinPopup" PlacementTarget="{Binding ElementName=ChancePinButton}"
                                       Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" Closed="ChancePinPopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=ChancePinButton}">
                                    <Grid Width="240">
                                        <Border Background="{StaticResource CardBackground}" CornerRadius="7"/>
                                        <StackPanel Margin="12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <materialIcons:MaterialIcon Kind="Dice5Outline" Width="14" Height="14"
                                                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="PARTICLE RANDOMNESS" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChancePinToggle" Content="Fix random value" IsChecked="False"
                                                      Style="{StaticResource ModernCheckBox}" Click="ChancePinToggle_Click"
                                                      ToolTip="Use the chosen probability-table value for new particle births."/>
                                            <TextBlock Text="Off: random per birth. On: repeat the chosen value."
                                                       TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                       Margin="0,7,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="ChancePinSlider" Minimum="0" Maximum="1" Value="0.5"
                                                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                        IsEnabled="{Binding IsChecked, ElementName=ChancePinToggle}"
                                                        Style="{StaticResource HUDSliderStyle}" ToolTip="Probability-table draw (0 to 1)"
                                                        ValueChanged="ChancePinSlider_ValueChanged"/>
                                                <TextBlock x:Name="ChancePinValueText" Grid.Column="1" Text="0.50"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Popup>

                                <Button x:Name="TimelineOptionsButton" Click="TimelineOptionsButton_Click"
                                        Style="{StaticResource TransparentIconButton}" Width="30" Height="28" Padding="0"
                                        Visibility="{Binding HasAnimationParameters, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Animation options: authored parameter">
                                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18"/>
                                </Button>
                                <Popup x:Name="TimelineOptionsPopup" PlacementTarget="{Binding ElementName=TimelineOptionsButton}"
                                       Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" Closed="TimelineOptionsPopup_Closed"
                                       DataContext="{Binding DataContext, ElementName=TimelineOptionsButton}">
                                    <Grid Width="220">
                                        <Border Background="{StaticResource CardBackground}" CornerRadius="7"/>
                                        <StackPanel Margin="12">
                                            <TextBlock Text="ANIMATION OPTIONS" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                                            <!-- Parametric AnimationGraph clips choose one authored mValue at a time. -->
                                            <StackPanel Margin="0,0,0,12"
                                                        Visibility="{Binding HasAnimationParameters, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Animation parameter" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                                           VerticalAlignment="Center" Margin="0,0,0,5"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" Width="Auto" Height="28"
                                                          ItemsSource="{Binding AnimationParameterValues}"
                                                          SelectedItem="{Binding AnimationParameter, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0:0.###}"/>
                                            </StackPanel>

                                        </StackPanel>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Popup>
                            </StackPanel>

                            <!-- Emitter filter stays at the right edge. -->
                                <Border Grid.Column="2" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        CornerRadius="5" Height="28" Width="170" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FilterVariant" Width="13" Height="13"
                                                                    Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="EmitterFilterTextBox"
                                                 Text="{Binding EmitterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="EmitterFilter_TextChanged"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimary}" CaretBrush="White"
                                                 FontSize="11" VerticalContentAlignment="Center" Padding="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="Filter emitters" Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EmitterFilterText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Click="ClearEmitterFilter_Click" Style="{StaticResource TransparentIconButton}"
                                                Width="20" Height="20" Margin="0,0,2,0" ToolTip="Clear Filter"
                                                Visibility="{Binding HasEmitterFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{StaticResource AccentBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                        </Grid>

                        <!-- 2. SUBTLE SEPARATOR -->
                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,2,0,6" Opacity="0.45"/>

                        <!-- 3. TIME RULER HEADER (Aligned with lanes) -->
                        <Grid Grid.Row="2" Margin="0,0,0,2" Height="26" Background="#08000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/> <!-- Name & Solo/Mute Header Column -->
                                <ColumnDefinition Width="*"/>   <!-- Time Ruler Ticks & Loop Indicator -->
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/> <!-- Global visibility -->
                                    <ColumnDefinition Width="*"/>  <!-- Label -->
                                    <ColumnDefinition Width="24"/> <!-- Global solo -->
                                </Grid.ColumnDefinitions>

                                <!-- Global visibility: applies to the complete VFX graph. -->
                                <Button Grid.Column="0" Click="ToggleMuteAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Show / Hide All Emitters">
                                    <materialIcons:MaterialIcon Width="13" Height="13">
                                        <materialIcons:MaterialIcon.Style>
                                            <Style TargetType="materialIcons:MaterialIcon">
                                                <Setter Property="Kind" Value="EyeOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllMuted}" Value="True">
                                                        <Setter Property="Kind" Value="EyeOffOutline"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialIcons:MaterialIcon.Style>
                                    </materialIcons:MaterialIcon>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="EMITTERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>

                                <!-- Global solo: mirrors the per-emitter S controls. -->
                                <Button Grid.Column="2" Click="ToggleSoloAll_Click" Style="{StaticResource TransparentIconButton}"
                                        Width="20" Height="20" Padding="0" ToolTip="Solo / Unsolo All Emitters">
                                    <TextBlock Text="S" FontSize="9.5" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAnySolo}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <!-- Ruler Ticks & Live Caption Header -->
                            <Grid Grid.Column="1" Margin="8,0,0,0" Cursor="Hand"
                                  PreviewMouseDown="Ruler_PreviewMouseDown"
                                  PreviewMouseMove="Ruler_PreviewMouseMove"
                                  PreviewMouseUp="Ruler_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/> <!-- Live Count Column Header -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="2" Width="1" Height="10" Background="#38FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Grid.Column="3" Width="1" Height="8" Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="0" Text="0.00s" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding QuarterDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding HalfDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalDuration, StringFormat={}{0:F2}s}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>
                        </Grid>

                        <!-- 4. TIMELINE TRACKS (Scrollable Emitters Lanes + Sweeping Needles) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                            <Grid x:Name="TimelineInteractiveGrid" Background="Transparent"
                                  PreviewMouseDown="TimelineGrid_PreviewMouseDown"
                                  PreviewMouseMove="TimelineGrid_PreviewMouseMove"
                                  PreviewMouseUp="TimelineGrid_PreviewMouseUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/> <!-- Names, Thumbnails, Toggles & Solos Column -->
                                    <ColumnDefinition Width="*"/>   <!-- Tracks Canvas Column -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Emitters List -->
                                <StackPanel Grid.Column="0">
                                    <!-- Emitter Rows -->
                                    <ItemsControl ItemsSource="{Binding Emitters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TimelineLaneRowStyle}"
                                                        MouseLeftButtonDown="EmitterLane_MouseLeftButtonDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/> <!-- Mute (Eye) -->
                                                            <ColumnDefinition Width="22"/> <!-- Thumbnail Image/Icon -->
                                                            <ColumnDefinition Width="*"/>  <!-- Emitter Name -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Index [16] -->
                                                            <ColumnDefinition Width="24"/> <!-- Solo ('S') -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mute Button (Eye) -->
                                                        <Button Grid.Column="0" Click="EmitterMute_Click" Style="{StaticResource TransparentIconButton}"
                                                                Width="20" Height="20" Padding="0" ToolTip="Mute (Hide) this emitter" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Width="13" Height="13">
                                                                <materialIcons:MaterialIcon.Style>
                                                                    <Style TargetType="materialIcons:MaterialIcon">
                                                                        <Setter Property="Kind" Value="EyeOutline"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                <Setter Property="Kind" Value="EyeOffOutline"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialIcons:MaterialIcon.Style>
                                                            </materialIcons:MaterialIcon>
                                                        </Button>

                                                        <!-- Thumbnail Swatch (Image preview if loaded, else primitive icon) -->
                                                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="2"
                                                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                                                Background="#10FFFFFF" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding ImagePreview}" Width="16" Height="16" Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <materialIcons:MaterialIcon Kind="TextureBox" Width="11" Height="11" Foreground="{StaticResource TextMuted}"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon.Style>
                                                                        <Style TargetType="materialIcons:MaterialIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialIcons:MaterialIcon.Style>
                                                                </materialIcons:MaterialIcon>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Emitter Name -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   ToolTip="{Binding Name}" Margin="4,0,2,0"/>

                                                        <!-- Index Number [16] -->
                                                        <TextBlock Grid.Column="3" Text="{Binding IndexNumber, StringFormat='[{0}]'}" FontSize="9.5" FontFamily="Consolas"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                        <!-- Solo Button ('S') -->
                                                        <Button Grid.Column="4" Click="EmitterSolo_Click" Width="20" Height="20" Padding="0" ToolTip="Solo this emitter" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="S" FontSize="10" FontWeight="Black">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Right Column: Emitter Tracks Bars + Sweeping Needles -->
                                <Grid Grid.Column="1" Margin="8,0,0,0" x:Name="TracksCanvasContainer" SizeChanged="TracksCanvasContainer_SizeChanged" ClipToBounds="True"
                                      Background="#05000000">
                                    <!-- Temporal grid: quarter marks remain visible behind every lane. -->
                                    <Grid IsHitTestVisible="False" Panel.ZIndex="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="2" Width="1" Background="#20FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="3" Width="1" Background="#16FFFFFF" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="4" Width="1" Background="#14FFFFFF" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <StackPanel Panel.ZIndex="1">
                                        <!-- Emitter Bars Stack -->
                                        <ItemsControl ItemsSource="{Binding Emitters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TimelineLaneRowStyle}">
                                                        <Grid>
                                                            <!-- Authored emitter interval -->
                                                            <Border Background="{Binding TrackBrush}" BorderBrush="{Binding TrackBorderBrush}" BorderThickness="1"
                                                                    CornerRadius="3" Height="16" VerticalAlignment="Center"
                                                                    Margin="{Binding TrackMargin}" HorizontalAlignment="Left" Width="{Binding TrackWidth}">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.22"/>
                                                                </Border.Effect>
                                                                <Border BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" CornerRadius="3"/>
                                                            </Border>

                                                            <!-- Emission trigger marker -->
                                                            <Ellipse Width="7" Height="7" Fill="#FBBF24" Stroke="#111827" StrokeThickness="1"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                     Margin="{Binding DelayMarkerMargin}"
                                                                     Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                     ToolTip="{Binding DelayTime, StringFormat='Emission Trigger: {0:F2}s'}">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect Color="#FBBF24" BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>

                                                            <!-- Live Particle Count -->
                                                            <Border Width="34" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                    Background="#0D000000" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding ActiveParticleCount}" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Playhead Needle Overlay Canvas -->
                                    <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False" Panel.ZIndex="10">
                                        <Line x:Name="PlayheadLine" X1="0" Y1="6" X2="0" Y2="800"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0.95"/>
                                        <Path x:Name="PlayheadHandle" Data="M 0,0 L 10,0 L 5,6 Z"
                                              Canvas.Top="0" Fill="{StaticResource AccentBrush}">
                                            <Path.Effect>
                                                <DropShadowEffect Color="#3B82F6" BlurRadius="5" ShadowDepth="0" Opacity="0.75"/>
                                            </Path.Effect>
                                        </Path>
                                    </Canvas>

                                    <!-- Active System Loop Boundary Needle Overlay Canvas -->
                                    <Canvas x:Name="LoopBoundaryCanvas" Panel.ZIndex="100">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewLoopEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Border x:Name="LoopRangeBand" Canvas.Top="0" Height="800" Width="0"
                                                Background="#10FFD700" IsHitTestVisible="False"/>
                                        <Line x:Name="LoopStartLine" X1="0" Y1="0" X2="0" Y2="800"
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Line x:Name="LoopBoundaryLine" X1="0" Y1="0" X2="0" Y2="800"
                                              Stroke="#FFD700" StrokeThickness="1.5" IsHitTestVisible="False"/>
                                        <Ellipse x:Name="LoopStartHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE"
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5"
                                                 PreviewMouseDown="LoopStartHandle_PreviewMouseDown"
                                                 PreviewMouseMove="LoopStartHandle_PreviewMouseMove"
                                                 PreviewMouseUp="LoopStartHandle_PreviewMouseUp"
                                                 ToolTip="Drag to adjust preview loop start">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="LoopBoundaryHandle" Canvas.Left="-7" Canvas.Top="1" Cursor="SizeWE"
                                                 Width="14" Height="14" Fill="#FFD700" Stroke="#18181B" StrokeThickness="1.5"
                                                 PreviewMouseDown="LoopBoundaryHandle_PreviewMouseDown"
                                                 PreviewMouseMove="LoopBoundaryHandle_PreviewMouseMove"
                                                 PreviewMouseUp="LoopBoundaryHandle_PreviewMouseUp"
                                                 ToolTip="Drag to adjust preview loop end">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FFD700" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
</UserControl>
