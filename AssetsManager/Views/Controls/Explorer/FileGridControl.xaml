<UserControl x:Class="AssetsManager.Views.Controls.Explorer.FileGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:controls="clr-namespace:AssetsManager.Views.Controls.Shared"
             mc:Ignorable="d">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Folder Insights & Filters -->
            <RowDefinition Height="*"/>    <!-- Main Grid -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12" Margin="1,0,5,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:FileTypeFilterControl x:Name="FileTypeFilter"/>
            </StackPanel>
        </Border>

        <!-- 2. Main Grid: Simplified ListBox -->
        <ListBox Grid.Row="1" x:Name="FileGridListBox"
                 Style="{StaticResource ModernFileGridListBox}"
                 ItemTemplate="{StaticResource FileGridItemTemplate}"
                 SelectionChanged="FileGridListBox_SelectionChanged"/>

        <!-- 3. Floating Action Bar (Visible on Multi-selection) -->
        <Border x:Name="ActionBarBorder" Grid.Row="1" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,30" 
                Visibility="{Binding IsActionBarVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource CardBackground}" 
                CornerRadius="22" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                Padding="15,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" Margin="5,0,12,0"/>
                <TextBlock x:Name="SelectedCountText" 
                           Text="{Binding SelectedCountDisplay}" 
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <Border Background="{StaticResource BorderColor}" Width="1" Height="16" Margin="0,0,15,0"/>

                <!-- Extract (Raw) -->
                <Button Style="{StaticResource TransparentIconButton}" Tag="Extract" Click="ActionBar_Action_Click" ToolTip="Extract Raw Assets" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="FileDownloadOutline" Width="20" Height="20"/>
                </Button>

                <!-- Save (Smart) -->
                <Button Style="{StaticResource TransparentIconButton}" Tag="Save" Click="ActionBar_Action_Click" ToolTip="Save (conversion)" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20"/>
                </Button>

                <!-- Merger -->
                <Button Style="{StaticResource TransparentIconButton}" Tag="Merge" Click="ActionBar_Action_Click" ToolTip="Add to Image Merger" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="ViewGridPlusOutline" Width="20" Height="20"/>
                </Button>

                <Border Background="{StaticResource BorderColor}" Width="1" Height="16" Margin="10,0,10,0"/>

                <!-- Close -->
                <Button Tag="Close" Click="ActionBar_Action_Click" ToolTip="Clear Selection" Width="32" Height="32">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
