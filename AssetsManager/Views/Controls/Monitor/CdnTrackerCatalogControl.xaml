<UserControl x:Class="AssetsManager.Views.Controls.Monitor.CdnTrackerCatalogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:AssetsManager.Views.Controls.Shared"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20,14" MinHeight="76" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="{StaticResource HoverColor}" CornerRadius="10" Margin="0,0,16,0" VerticalAlignment="Center">
                    <icons:MaterialIcon Kind="Radar" Width="22" Height="22" Foreground="{StaticResource AccentBlue}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Tracked Images" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Cancel" Click="CancelClicked" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource DestructiveButton}" Height="32" Padding="8,0" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Border Grid.Column="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Padding="20,0,0,0" Margin="20,0,0,0" Height="24" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Paginator.TotalPages}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding Paginator.TotalPages}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <shared:PaginationControl Paginator="{Binding Paginator}"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="CategoryFilter" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterChanged" Height="34" Margin="0,0,8,0" ToolTip="Category"/>
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBoxEditable}" Height="34" TextChanged="SearchChanged" ToolTip="Search name, ID or URL" VerticalContentAlignment="Center" Padding="8,0"/>
                <TextBlock Text="Search name, ID or URL..." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Paginator.PagedItems}" Margin="-6,0,-6,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="6,0,6,12" Padding="12" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Height="125" Background="{StaticResource SidebarBackground}" CornerRadius="10" Margin="0,0,0,12">
                                    <Grid>
                                        <icons:MaterialIcon Kind="ImageOutline" Width="36" Height="36" Opacity="0.2" Foreground="{StaticResource TextMuted}"/>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Background="{StaticResource HoverColor}" CornerRadius="6" Padding="7,3" Margin="0,0,6,0" ToolTip="{Binding StatusDescription}"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource TextPrimary}"/></Border>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button Click="CopyUrlClicked" Tag="{Binding}" IsEnabled="{Binding HasUrl}" ToolTip="{Binding Url}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Height="34" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="COPY URL" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="SaveClicked" Tag="{Binding}" IsEnabled="{Binding CanDownload}" ToolTip="Save image" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Height="34" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SAVE" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </Grid>
</UserControl>
