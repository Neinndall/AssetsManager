<UserControl x:Class="AssetsManager.Views.Help.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="900">
    <StackPanel Margin="0,16,0,0">
        <!-- SECTION: TECHNICAL DOCUMENTATION -->
        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon Kind="BookOpenVariant" Foreground="{StaticResource AccentBrush}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TECHNICAL DOCUMENTATION" FontSize="12" FontWeight="Black" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0"/>
                    <TextBlock Text="Essential guides and modules to master AssetsManager" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Opacity="0.8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. CORE MODULES GRID -->
        <TextBlock Text="CORE MODULES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,0,0,16"/>
        <UniformGrid Columns="2" Margin="0,0,0,40">
            <!-- Comparator -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource HoverColor}" Width="42" Height="42" CornerRadius="10">
                            <materialIcons:MaterialIcon Kind="FileCompare" Foreground="{StaticResource AccentOrange}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WAD Comparator" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Differential analysis between patch archives. Features Image Diff, 3D Mesh Skn Diff, and BIN/JSON tree comparison with automated backup packaging." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </Border>

            <!-- Explorer -->
            <Border Style="{StaticResource SettingsCard}" Margin="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource HoverColor}" Width="42" Height="42" CornerRadius="10">
                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Foreground="{StaticResource AccentGreen}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Archive Explorer" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="High-performance archive navigation and extraction. Features BIN property tree exploration, audio event linkage, and instant texture rendering." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </Border>

            <!-- 3D & VFX Inspector -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,12,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource HoverColor}" Width="42" Height="42" CornerRadius="10">
                            <materialIcons:MaterialIcon Kind="CubeOutline" Foreground="{StaticResource AccentPurple}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="3D Viewer &amp; VFX Inspector" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Inspect champions, skins, and maps in 3D with animation playback. Includes a dedicated VFX particle inspector with keyframe curves and timeline scrubbing." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </Border>

            <!-- Hash Lab -->
            <Border Style="{StaticResource SettingsCard}" Margin="12,12,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource HoverColor}" Width="42" Height="42" CornerRadius="10">
                            <materialIcons:MaterialIcon Kind="FlaskOutline" Foreground="{StaticResource AccentTeal}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Hash Lab" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Deterministic hash guessing and cryptanalysis engine for Game, LCU, BIN, and RST hashes powered by token dictionaries and schemas." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </Border>

            <!-- Monitor & Version Manager -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,12,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource HoverColor}" Width="42" Height="42" CornerRadius="10">
                            <materialIcons:MaterialIcon Kind="Radar" Foreground="{StaticResource AccentRed}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Monitor &amp; Versions" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Surveillance dashboard for PBE and CDN assets. High-speed RMAN manifest patching, live server status, and automated snapshot backup management." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </Border>

            <!-- Audio & News Hub -->
            <Border Style="{StaticResource SettingsCard}" Margin="12,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource HoverColor}" Width="42" Height="42" CornerRadius="10">
                            <materialIcons:MaterialIcon Kind="NewspaperVariantOutline" Foreground="{StaticResource AccentBrush}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Audio &amp; News Hub" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Decrypt and play embedded Wwise audio bank events (BNK/WPK) alongside an integrated surveillance feed for official patch notes and esports." 
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- 3. SETUP GUIDE (Timeline Style) -->
        <TextBlock Text="QUICK START GUIDE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,0,0,20"/>
        <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="30" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,0,40">
            <Grid>
                <!-- Timeline Vertical Line -->
                <Border HorizontalAlignment="Left" Width="2" Background="{StaticResource BorderColor}" Margin="19,20,0,20"/>

                <StackPanel>
                    <!-- Step 1 -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                            <TextBlock Text="1" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Environment &amp; Client Setup" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Navigate to Settings and configure your game paths. Use the 'Preferred Client' option to automate WAD discovery and target installations." 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                            <TextBlock Text="2" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Asset Surveillance &amp; Updates" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="The app periodically checks for PBE status and manifest updates. Check the Monitor Dashboard for versioning and server health alerts." 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 3 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                            <TextBlock Text="3" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Differential Analysis &amp; Extraction" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Use the WAD Comparator to isolate changes between versions, explore assets with Archive Explorer, or run deterministic cracking in Hash Lab." 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. PRO TIPS (Vertical Cards) -->
        <TextBlock Text="PRO TIPS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="4,0,0,16"/>
        <StackPanel>
            <!-- Tip 1 -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource HoverColor}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Top">
                        <materialIcons:MaterialIcon Kind="LightbulbOnOutline" Foreground="{StaticResource AccentOrange}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Smart Extraction" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="Use 'Save Selected' in Explorer to automatically convert textures to PNG and data files to JSON while preserving original folder structures." 
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tip 2 -->
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource HoverColor}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Top">
                        <materialIcons:MaterialIcon Kind="FlaskOutline" Foreground="{StaticResource AccentTeal}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Targeted Cryptanalysis" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="In Hash Lab, select specific attack algorithms or sub-methods to target unknown BIN entries, fields, or RST hashes with maximum speed." 
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tip 3 -->
            <Border Style="{StaticResource SettingsCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource HoverColor}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Top">
                        <materialIcons:MaterialIcon Kind="CloudSyncOutline" Foreground="{StaticResource AccentGreen}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Always Synced" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="The app periodically checks for PBE status and asset changes in the background automatically, keeping you informed without interruptions." 
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- FOOTER -->
        <StackPanel Margin="0,30,0,0" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.6">
                <materialIcons:MaterialIcon Kind="Github" Foreground="{StaticResource TextSecondary}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/Neinndall/AssetsManager" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource TextSecondary}" TextDecorations="None">
                        Visit GitHub Repository
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>