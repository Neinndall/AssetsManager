<UserControl x:Class="AssetsManager.Views.ViewerWindow"
             x:Name="ViewerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <!-- CUERPO -->
        <Grid>
            <!-- LANDING PAGE / EMPTY STATE -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="{Binding Content.ViewModel.IsMainContentVisible, ElementName=ProjectHost, FallbackValue=Visible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStudioVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    
                    <!-- Default Content (Buttons) -->
                    <StackPanel x:Name="DefaultEmptyStateContent" Visibility="{Binding IsLoadingVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <!-- HERO HEADER: Centered Model -->
                        <StackPanel Margin="0,0,0,36" HorizontalAlignment="Center">
                            <Border Background="#1A00E676" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="3D WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            </Border>
                            <TextBlock Text="Model Viewer" FontSize="42" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Explore 3D models, animations, chromas and maps." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Action Cards -->
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Open Project Folder Card -->
                            <Button Grid.Column="0" Style="{StaticResource SelectionCardButtonStyle}"
                                    Click="OpenProjectFolder_Click"
                                    Width="180" Height="160" Margin="0" Padding="20">
                                <StackPanel>
                                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="25" Width="50" Height="50" Margin="0,0,0,14">
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Load Project"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="16" Margin="0,4,0,0">
                                        <Run Text="Browse models"/><LineBreak/>
                                        <Run Text="and animations"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- 3D Studio Card -->
                            <Button Grid.Column="2" Style="{StaticResource SelectionCardButtonStyle}"
                                    Click="OpenStudio_Click"
                                    Width="180" Height="160" Margin="0" Padding="20">
                                <StackPanel>
                                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="25" Width="50" Height="50" Margin="0,0,0,14">
                                        <materialIcons:MaterialIcon Kind="CubeOutline" Width="24" Height="24" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="3D Studio"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="16" Margin="0,4,0,0">
                                        <Run Text="Models &amp; animations"/><LineBreak/>
                                        <Run Text="Maps &amp; effects"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Loading Indicator (Enhanced) -->
                    <Grid x:Name="LoadingStateContent" Visibility="{Binding IsLoadingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Animated Spinner (Explorer Style) -->
                            <materialIcons:MaterialIcon Kind="Sync" 
                                                        Width="38" 
                                                        Height="38" 
                                                        Foreground="{StaticResource AccentBrush}"
                                                        Style="{StaticResource SpinningIconStyle}"/>

                            <!-- Title -->
                            <TextBlock x:Name="LoadingTitleText"
                                       Text="{Binding LoadingTitle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" 
                                       Margin="0,18,0,8"/>

                            <!-- Description -->
                            <TextBlock x:Name="LoadingDescriptionText"
                                       Text="{Binding LoadingDescription}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Grid>

            <ContentControl x:Name="ProjectHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="{Binding Content.ViewModel.IsMainContentVisible, ElementName=ProjectHost, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStudioVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl x:Name="StudioHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Visibility="{Binding IsStudioVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
