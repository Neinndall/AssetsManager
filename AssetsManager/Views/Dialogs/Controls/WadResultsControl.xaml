<UserControl x:Class="AssetsManager.Views.Dialogs.Controls.WadResultsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:controls="clr-namespace:AssetsManager.Views.Controls.Shared"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Filters -->
            <RowDefinition Height="*"/>    <!-- Grid -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RESULTS" Style="{StaticResource ToolSectionLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="PlusCircle" Width="14" Height="14" Foreground="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text=" results" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="RetryFailedButton" Click="RetryFailed_Click" Margin="12,0,0,0" Height="30" Padding="14,0"
                            Visibility="Collapsed"
                            ToolTip="Retry all failed extractions"
                            Style="{StaticResource SecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" Foreground="{StaticResource AccentRed}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Retry Failed" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <controls:FileTypeFilterControl x:Name="FileTypeFilter"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Grid -->
        <ListBox Grid.Row="1" x:Name="ResultsListBox"
                 Style="{StaticResource ModernFileGridListBox}"
                 ItemTemplate="{StaticResource ResultCardTemplate}"
                 SelectionChanged="ResultsListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FileGridItemStyle}">
                    <EventSetter Event="Loaded" Handler="GridItem_Loaded"/>
                    <EventSetter Event="Unloaded" Handler="GridItem_Unloaded"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 3. Empty State -->
        <Border x:Name="EmptyStateBorder" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="PackageVariant" Width="48" Height="48" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock Text="No results to show" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Try a different filter or extract the remaining assets." FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 4. Floating Action Bar (Visible on Selection) -->
        <Border x:Name="ActionBarBorder" Grid.Row="1"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,30"
                Visibility="Collapsed"
                Background="{StaticResource CardBackground}"
                CornerRadius="22" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                Padding="15,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" Margin="5,0,12,0"/>
                <TextBlock x:Name="SelectedCountText"
                           Text="0 selected"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <Border Background="{StaticResource BorderColor}" Width="1" Height="16" Margin="0,0,15,0"/>

                <!-- Extract (Raw) -->
                <Button x:Name="ExtractButton" Style="{StaticResource TransparentIconButton}" Tag="Extract" Click="ActionBar_Action_Click" ToolTip="Extract Raw Assets" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="FileDownloadOutline" Width="20" Height="20"/>
                </Button>

                <!-- Save (Smart) -->
                <Button x:Name="SaveButton" Style="{StaticResource TransparentIconButton}" Tag="Save" Click="ActionBar_Action_Click" ToolTip="Save (conversion)" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20"/>
                </Button>

                <!-- Open Folder (visible when the selection was exported) -->
                <Button x:Name="OpenFolderButton" Visibility="Collapsed" Style="{StaticResource TransparentIconButton}" Tag="OpenFolder" Click="ActionBar_Action_Click" ToolTip="Open Output Folder" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20"/>
                </Button>

                <!-- Copy Paths -->
                <Button Style="{StaticResource TransparentIconButton}" Tag="CopyPaths" Click="ActionBar_Action_Click" ToolTip="Copy Paths" Width="32" Height="32">
                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="20" Height="20"/>
                </Button>

                <Border Background="{StaticResource BorderColor}" Width="1" Height="16" Margin="10,0,10,0"/>

                <!-- Close -->
                <Button Tag="Close" Click="ActionBar_Action_Click" ToolTip="Clear Selection" Width="32" Height="32">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TransparentIconButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
