<base:HudWindow x:Class="AssetsManager.Views.Dialogs.SknDiffWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                xmlns:base="clr-namespace:AssetsManager.Views.Helpers"
                xmlns:viewer="clr-namespace:AssetsManager.Views.Controls.Viewer"
                mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
                HeaderTitle="3D Mesh Analyzer" 
                HeaderIcon="CubeOutline"
                Height="850" Width="1200"
                MinWidth="800" MinHeight="600"
                WindowStartupLocation="CenterOwner"
                Style="{StaticResource HudWindowStyle}">

    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Professional Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Viewports -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Professional Title and Metrics Area -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title/Status -->
                    <ColumnDefinition Width="*"/>    <!-- Metrics -->
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GEOMETRIC DIFF" Style="{StaticResource ToolSectionLabel}" Margin="0,0,0,2"/>
                    <TextBlock Text="Topology &amp; Vertex Validation" FontSize="10" Foreground="{StaticResource TextPrimary}" Opacity="0.8"/>
                </StackPanel>

                <!-- Center: Metrics Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Vertices Delta -->
                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="6" Padding="12,6" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="VectorPoint" Width="14" Height="14" Foreground="{StaticResource AccentBlue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VERTICES:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="VertexDeltaLabel" Text="0" FontSize="11" FontWeight="Black" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Faces Delta -->
                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="6" Padding="12,6" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="TriangleOutline" Width="14" Height="14" Foreground="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FACES:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="FaceDeltaLabel" Text="0" FontSize="11" FontWeight="Black" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Viewports Area -->
        <Grid Grid.Row="1">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Old Version Viewport -->
                <Border Grid.Column="0" x:Name="OldViewportContainer" Style="{StaticResource SettingsCard}" Padding="0" Background="{StaticResource SidebarBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SidebarBackground}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                            <Border Padding="12,12,12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1AFF9100" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                        <icons:MaterialIcon Kind="History" Width="18" Height="18" Foreground="{StaticResource AccentOrange}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="OLD VERSION" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentOrange}" Opacity="0.8"/>
                                        <TextBlock x:Name="OldFileNameLabel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                        <viewer:ViewerViewportControl Grid.Row="1" x:Name="OldViewport" IsDiffMode="True" Margin="0"/>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" x:Name="ViewportSplitter" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

                <!-- New Version Viewport -->
                <Border Grid.Column="2" x:Name="NewViewportContainer" Style="{StaticResource SettingsCard}" Padding="0" Background="{StaticResource SidebarBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SidebarBackground}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                            <Border Padding="12,12,12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1A00E676" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                        <icons:MaterialIcon Kind="FlashOutline" Width="18" Height="18" Foreground="{StaticResource AccentGreen}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="NEW VERSION" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentGreen}" Opacity="0.8"/>
                                        <TextBlock x:Name="NewFileNameLabel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                        <viewer:ViewerViewportControl Grid.Row="1" x:Name="NewViewport" IsDiffMode="True" Margin="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Floating mesh visibility / topology panel -->
            <Border x:Name="MeshVisibilityPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="320"
                    MaxHeight="590"
                    Margin="0,42,42,0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MeshPanelTranslation" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="5" Opacity="0.48"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Draggable header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="11,11,0,0"
                            Padding="12,10"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="MeshPanelHeader_MouseLeftButtonDown"
                            MouseMove="MeshPanelHeader_MouseMove"
                            MouseLeftButtonUp="MeshPanelHeader_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                    Background="#1F9B6DFF" Margin="0,0,10,0" VerticalAlignment="Center">
                                <icons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15"
                                                    Foreground="{StaticResource AccentPurple}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MESH PARTS" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="MeshPartsSummaryText" Text="Part visibility &amp; topology"
                                           FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Click="CloseMeshPanel_Click"
                                    Style="{StaticResource SmallCloseButtonStyle}"
                                    Width="24" Height="24" Margin="8,0,0,0"
                                    VerticalAlignment="Center" ToolTip="Close panel"/>
                        </Grid>
                    </Border>

                    <!-- Compact actions / delta legend -->
                    <Grid Grid.Row="1" Margin="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Δ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="+NEW / −OLD TRIANGLES" FontSize="8" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="SHOW ALL" Click="ShowAllMeshParts_Click"
                                Style="{StaticResource SmallTextButtonStyle}" FontSize="8" FontWeight="Bold"
                                Margin="8,0,2,0" ToolTip="Show every mesh part"/>
                        <Button Grid.Column="2" Content="HIDE ALL" Click="HideAllMeshParts_Click"
                                Style="{StaticResource SmallTextButtonStyle}" FontSize="8" FontWeight="Bold"
                                Margin="2,0,0,0" ToolTip="Hide every mesh part"/>
                    </Grid>

                    <!-- Scrollable part list -->
                    <ScrollViewer Grid.Row="2" Margin="10,0,6,10"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MeshPartsItemsControl" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackground}"
                                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,0,5" ToolTip="{Binding StatusText}">
                                        <Grid MinHeight="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{Binding DiffColorBrush}"
                                                    CornerRadius="7,0,0,7"/>

                                            <StackPanel Grid.Column="1" Margin="10,6,8,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{Binding DiffColorBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Margin="0,0,8,0" Padding="6,3"
                                                    Background="{StaticResource DarkBackground}"
                                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                                    CornerRadius="5" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeltaText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DeltaText}" FontFamily="Consolas" FontSize="9"
                                                           FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                            </Border>

                                            <CheckBox Grid.Column="3"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      Checked="MeshPartVisibility_Changed"
                                                      Unchecked="MeshPartVisibility_Changed"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      Margin="0" Width="26"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>


        </Grid>

        <!-- 3. Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="0,0,11,11" Padding="24,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <icons:MaterialIcon Kind="Palette" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="LEGEND:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <Border Background="DodgerBlue" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0"/>
                <TextBlock Text="Modified Part" FontSize="10" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Border Background="Green" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0"/>
                <TextBlock Text="New Part" FontSize="10" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Border Background="Red" CornerRadius="3" Width="10" Height="10" Margin="0,0,6,0"/>
                <TextBlock Text="Removed Part" FontSize="10" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <icons:MaterialIcon Kind="Sync" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Opacity="0.7"/>
                <TextBlock Text="Cameras are synchronized" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</base:HudWindow>
