<base:HudWindow x:Class="AssetsManager.Views.Dialogs.NotificationHubWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                xmlns:models="clr-namespace:AssetsManager.Views.Models.Notifications"
                xmlns:base="clr-namespace:AssetsManager.Views.Helpers"
                mc:Ignorable="d" FontFamily="{StaticResource AppFontFamily}"
                HeaderTitle="Notifications" 
                HeaderIcon="BellOutline"
                Height="540" Width="460"
                WindowStartupLocation="CenterOwner"
                ResizeMode="NoResize"
                ShowMinimizeButton="False"
                ShowMaximizeButton="False"
                Style="{StaticResource HudWindowStyle}">

    <Window.Resources>
        <!-- DataTemplate for Notifications -->
        <DataTemplate DataType="{x:Type models:NotificationModel}">
            <Grid Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="NotificationCard_Click">
                <!-- 1. Background Layer -->
                <Border x:Name="NotificationBackground" 
                        Background="{StaticResource CardBackground}" 
                        CornerRadius="8"/>

                <!-- 2. Content Layer (Fixed Padding, never shifts) -->
                <Border Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- 0: Icon -->
                            <ColumnDefinition Width="*"/>    <!-- 1: Body -->
                            <ColumnDefinition Width="Auto"/> <!-- 2: Action & Close -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Header (Title + Time) -->
                            <RowDefinition Height="*"/>    <!-- Row 1: Message -->
                            <RowDefinition Height="Auto"/> <!-- Row 2: Progress Bar (Optional) -->
                            <RowDefinition Height="Auto"/> <!-- Row 3: Action Button (Optional) -->
                        </Grid.RowDefinitions>

                        <!-- 1. Technical Icon -->
                        <materialIcons:MaterialIcon Grid.Row="0" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,10,0">
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Kind" Value="InformationOutline"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Success">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                                            <Setter Property="Kind" Value="AlertOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Error">
                                            <Setter Property="Kind" Value="CloseCircleOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>

                        <!-- 2. Header: Title - Time -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Title, Converter={StaticResource StringCaseConverter}}" 
                                       FontWeight="Black" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            
                            <TextBlock Text="-" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextMuted}" 
                                       Margin="6,0" 
                                       Opacity="0.5"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}" 
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- 3. Main Message (Below Header) -->
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding Message}" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   TextWrapping="Wrap"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   Opacity="0.85"/>

                        <!-- 4. Progress Bar (If HasProgress is true) -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Progress" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" Style="{StaticResource ModernProgressBar}"/>
                        </StackPanel>

                        <!-- 5. Action Button (If ActionText is set) -->
                        <Button Grid.Row="3" Grid.Column="1"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Style="{StaticResource SmallTextButtonStyle}"
                                Click="NotificationAction_Click"
                                Visibility="{Binding ActionText, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="OpenInApp" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ActionText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Close Action Button (Centered vertically) -->
                        <Grid Grid.Column="2" Grid.RowSpan="4" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="CloseNotifyBtn"
                                    Style="{StaticResource SmallCloseButtonStyle}" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="RemoveNotification_Click"
                                    ToolTip="Dismiss"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Border Overlay (Changes thickness without shifting layout) -->
                <Border x:Name="NotificationBorder" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1"
                        CornerRadius="8"
                        IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter TargetName="NotificationBorder" Property="BorderThickness" Value="1.5"/>
                    <Setter TargetName="NotificationBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <!-- Type-specific accents for Unread status -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRead}" Value="False"/>
                        <Condition Binding="{Binding Type}" Value="Success"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NotificationBorder" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRead}" Value="False"/>
                        <Condition Binding="{Binding Type}" Value="Warning"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NotificationBorder" Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRead}" Value="False"/>
                        <Condition Binding="{Binding Type}" Value="Error"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NotificationBorder" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                </MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NotificationBackground" Property="Background" Value="{StaticResource HoverColor}"/>
                    <Setter TargetName="CloseNotifyBtn" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Category Filter Tabs -->
            <RowDefinition Height="Auto"/> <!-- 1: Header Actions Area -->
            <RowDefinition Height="*"/>    <!-- 2: Content Area -->
        </Grid.RowDefinitions>

        <!-- 0. Category Filter Tabs (Primary Navigation) -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" Padding="12,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Visibility="{Binding Notifications.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <!-- ALL TAB -->
                    <Border Padding="10,4" Margin="0,0,4,0" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterAll_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                        <Setter Property="Background" Value="#2600D2FF"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="ALL" FontSize="10" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- SYSTEM TAB -->
                    <Border Padding="8,4" Margin="0,0,4,0" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterSystem_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemSelected}" Value="True">
                                        <Setter Property="Background" Value="#2600D2FF"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UnreadSystemCount, StringFormat=' ({0})'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Visibility="{Binding UnreadSystemCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- WATCHER TAB -->
                    <Border Padding="8,4" Margin="0,0,4,0" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterWatcher_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWatcherSelected}" Value="True">
                                        <Setter Property="Background" Value="#26FF9800"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentOrange}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WATCHER" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatcherSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UnreadWatcherCount, StringFormat=' ({0})'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" Visibility="{Binding UnreadWatcherCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- TRACKER TAB -->
                    <Border Padding="8,4" Margin="0,0,4,0" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterTracker_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrackerSelected}" Value="True">
                                        <Setter Property="Background" Value="#264CAF50"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TRACKER" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrackerSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UnreadTrackerCount, StringFormat=' ({0})'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Visibility="{Binding UnreadTrackerCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- UPDATES TAB -->
                    <Border Padding="8,4" Margin="0,0,4,0" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterUpdates_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdatesSelected}" Value="True">
                                        <Setter Property="Background" Value="#2600D2FF"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UPDATES" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdatesSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UnreadUpdatesCount, StringFormat=' ({0})'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Visibility="{Binding UnreadUpdatesCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- NEWS TAB -->
                    <Border Padding="8,4" Margin="0,0,4,0" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterNews_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewsSelected}" Value="True">
                                        <Setter Property="Background" Value="#26AB47BC"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEWS" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentPurple}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UnreadNewsCount, StringFormat=' ({0})'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Visibility="{Binding UnreadNewsCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 1. Actions Area (Sub-header under Category Filter Tabs) -->
        <Border Grid.Row="1" Padding="16,8" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Visibility="{Binding Notifications.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCategoryTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <Border Background="#26FF5252" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasSelectedUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="BellAlertOutline" Width="12" Height="12" Foreground="{StaticResource AccentRed}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedUnreadCount}" Foreground="{StaticResource AccentRed}" FontSize="10" FontWeight="Black" VerticalAlignment="Center"/>
                            <TextBlock Text="NEW" Foreground="{StaticResource AccentRed}" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Opacity="0.9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Notifications.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Button Style="{StaticResource TransparentIconButton}" Click="MarkAllRead_Click" Margin="0,0,6,0" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="CheckAll" Width="14" Height="14" Foreground="{StaticResource AccentGreen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mark Read" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TransparentIconButton}" Click="Clear_Click" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{StaticResource AccentRed}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Content Area (With bottom rounding) -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBackground}" CornerRadius="0,0,11,11" ClipToBounds="True">
            <Grid>
                <!-- Empty State -->
                <Grid Visibility="{Binding HasFilteredNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,40,0,40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{StaticResource CardBackground}" CornerRadius="50" Width="70" Height="70" Margin="0,0,0,14">
                            <materialIcons:MaterialIcon Kind="BellSleepOutline" Width="30" Height="30" Foreground="{StaticResource TextMuted}" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="All caught up!" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="No new notifications in this category." FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- List Area -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14"
                              Visibility="{Binding HasFilteredNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding FilteredNotifications}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</base:HudWindow>
